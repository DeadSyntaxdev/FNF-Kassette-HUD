class KssetteApi extends Module {
    final optionsID:String = "kassette-hud";
    public var hudVersion:String = "0.3.0-a";
    public var preview_bf:Dynamic = null;
    public var preview_dad:Dynamic = null;
    public var preview_scoreBopTrigger:Bool = false;
    public var preview_simulatedAcc:Float = 0.0;

    public var preview_missesCount:Int = 0;
    public var preview_playerTurn:Bool = true;
    public var preview_turnProgress:Float = 0.0;
    public var missesCount:Int = 0;
    public var isMobileMode:Bool = false;
    public var _isInPlayState:Bool = false;
    private var _lastParsedChartId:String = "";
    
    // Gammod Bridges
    public var isGammodMode:Bool = false;
    public var gammodMultiplier:Float = 1.0;
    public var gammodAutoPlay:Bool = false;
    public var gammodPlayerSide:String = "NORMAL";
    public var gammodUnranked:Bool = false;
    
    public var latestVersion:String = "";
    public var updateAvailable:Bool = false;
    var _versionChecked:Bool = false;
    var _hasStartedUpdateCheck:Bool = false;
    var _hasShownUpdateScreen:Bool = false;
    private var expectedResponse:String = "";
    private var heartbeatTimer:Float = 4.0;
    private var gracePeriod:Float = 3.0;

    public function new() {
        super('KssetteApi', 1000);
        
        isMobileMode = (FlxG.onMobile); 
        _isInPlayState = false;
        KassetteHUDElement.globalApi = this;
        
        // Datahunters are now Modules and are instantiated by Polymod.
        // We will retrieve them in onCountdownStart.

        _lastParsedChartId = "";
    }
    

    
    override function onSongEnd(event:ScriptEvent) {
        super.onSongEnd(event);
        clearGammodCache();
    }

    function clearGammodCache() {
        // Handled natively by GammodDatahunter    
    }

    public function preloadFontsIndex():Void {
        // Asset preload handled natively by AssetDatahunter
    }

    public function getFontManager():Dynamic {
        return KassetteHUDElement.globalFontManager;
    }

    public function getOptionsManager():Dynamic {
        return KassetteHUDElement.globalOptionsManager;
    }

    public function invalidateCache():Void {
        var mOpt = getOptionsManager();
        if (mOpt != null) mOpt.invalidateCache();
    }
    
    public function getFontSize(baseSize:Int, key:String):Int {
        // discarded feature: always return baseSize to prevent giant fonts from old save data
        // idk when i can add the font size feature, sorry
        return baseSize;
    }
    


    override public function onSongRetry(event:ScriptEvent) {
        invalidateCache();
        super.onSongRetry(event);
        clearGammodCache();
    }

    public function extractIconColor(icon:Dynamic, isPlayer:Bool = false, iconId:String = null):Int {
        var ih = KassetteHUDElement.globalIconHunter;
        return ih != null ? ih.extractIconColor(icon, isPlayer, iconId) : (isPlayer ? 0xFF66FF33 : 0xFFFF0000);
    }

    public function getBreakData():Dynamic {
        var bh = KassetteHUDElement.globalBreakHunter;
        return bh != null ? bh.currentBreakData : {active:false, progress:0.0, timeLeft:0.0};
    }

    public function isMobileLikePC():Bool {
        var mOpt = getOptionsManager();
        if (mOpt != null) return mOpt.isMobileLikePC();
        return true;
    }

    public function isForcedDownscroll():Bool {
        var mOpt = getOptionsManager();
        if (mOpt != null) return mOpt.isForcedDownscroll();
        return false;
    }

    // Score and Song getters removed to enforce usage of Datahunters.

    public function getChallenge():String {
        var sec = KassetteHUDElement.globalSecurityManager;
        return sec != null ? sec.getChallenge() : "";
    }

    public function sendResponse(response:String):Void {
        var sec = KassetteHUDElement.globalSecurityManager;
        if (sec != null) sec.sendResponse(response);
    }

    // getModeMessage moved to SongDatahunter

    public function isOptionLocked(key:String):Bool {
        var mOpt = getOptionsManager();
        if (mOpt != null) return mOpt.isOptionLocked(key);
        return false;
    }

    public function getKssValue(key:String):Dynamic { 
        if (key == "isCompromised") {
            var sec = KassetteHUDElement.globalSecurityManager;
            return sec != null ? sec.isCompromised : false;
        }
        if (key == "kssette_middlescroll") {
            var mOpt = getOptionsManager();
            return mOpt != null ? mOpt.getKssValue(key) : false;
        }
        var mOpt = getOptionsManager();
        if (mOpt != null) return mOpt.getKssValue(key);
        return null;
    }

    function getModFolders():Array<String> {
        var folders:Array<String> = [];
        try {
            var loadedMods = PolymodHandler.loadedModIds;
            if (loadedMods != null && loadedMods.length > 0) for (mod in loadedMods) folders.push(mod);
        } catch(e:Dynamic) {}

        if (folders.length == 0) {
            try {
                var readMods = FileUtil.readDir("mods");
                if (readMods != null) for (mod in readMods) folders.push(mod);
            } catch(e:Dynamic) {}
        }
        return folders;
    }

    public function getAvailableFonts():Dynamic {
        if (assetHunter != null) return assetHunter.getAvailableFonts();
        var m:Dynamic = ["_" => "_"];
        m.remove("_");
        return m;
    }

    public function resolveCustomFont(fontKey:String):String {
        var mFont = getFontManager();
        if (mFont != null) return mFont.resolveCustomFont(fontKey);
        return "VCR OSD Mono";
    }

    public function getCustomFont():String {
        var mFont = getFontManager();
        if (mFont != null) return mFont.getCustomFont();
        return "VCR OSD Mono";
    }

    public function getCustomPixelFont():String {
        var mFont = getFontManager();
        if (mFont != null) return mFont.getCustomPixelFont();
        return "VCR OSD Mono";
    }

    public function getHudFont():String {
        var mFont = getFontManager();
        if (mFont != null) return mFont.getHudFont();
        return "VCR OSD Mono";
    }

    public function getHudStyleId():String {
        var mOpt = getOptionsManager();
        if (mOpt != null) return mOpt.getHudStyleId();
        return "funkin";
    }

    override public function onUpdate(event:UpdateScriptEvent) {
        super.onUpdate(event);
        if (Highscore.tallies != null) missesCount = Highscore.tallies.missed;

        var gh = KassetteHUDElement.globalGammodHunter;
        if (gh != null) {
            isGammodMode = gh.isGammodMode;
            gammodMultiplier = gh.gammodMultiplier;
            gammodAutoPlay = gh.gammodAutoPlay;
            gammodPlayerSide = gh.gammodPlayerSide;
            gammodUnranked = gh.gammodUnranked;
        }

        var state = PlayState.instance;
        if (state == null) {
            if (_isInPlayState) {
                _isInPlayState = false;
                clearGammodCache();
            }
            return;
        }

        if (_isInPlayState) {
            if (state.scoreText != null) state.scoreText.visible = false;
        }
    }

    override public function onStateChangeStart(event:StateChangeScriptEvent):Void {
        super.onStateChangeStart(event);
    }

    override public function onStateChangeEnd(event:StateChangeScriptEvent):Void {
        super.onStateChangeEnd(event);
        var target = event.targetState;
        
        if (Std.isOfType(target, PlayState)) {
            _isInPlayState = true;
            createHUDWatermark(target);
        } else {
            if (_isInPlayState) {
                _isInPlayState = false;
                clearGammodCache();
                FlxG.bitmap.clearUnused();
            }
        }
    }

    function createHUDWatermark(state:PlayState) {
        if (state == null || state.camHUD == null) return;
        
        var platform = isMobileMode ? (isMobileLikePC() ? "Mobile+KB" : "Mobile") : "PC";
        var safeMargin:Float = isMobileMode ? 85 : 8;
        
        var timeBarPos = getKssValue("kssette_timebar_pos");
        var yPos:Float = (timeBarPos == "Bottom" || timeBarPos == "Bottom Right") ? 10 : (FlxG.height - 24);

        var gammodHunter = KassetteHUDElement.globalGammodHunter;
        var gammodAdd:String = (gammodHunter != null && gammodHunter.isGammodMode) ? " + GAMMOD" : "";
        var watermark = new FlxText(0, yPos, FlxG.width - safeMargin, "Kassette HUD " + platform + " [" + hudVersion + "]" + gammodAdd, 16);
        watermark.setFormat("VCR OSD Mono", 16, FlxColor.WHITE, "right", FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
        watermark.alpha = 0.5; watermark.zIndex = 1000; watermark.cameras = [state.camHUD];
        state.add(watermark);
    }



    override public function onStepHit(event:ScriptEvent) {
        super.onStepHit(event);
    }

    override public function onBeatHit(event:ScriptEvent) {
