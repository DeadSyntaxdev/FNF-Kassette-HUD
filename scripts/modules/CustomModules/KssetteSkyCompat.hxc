import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import funkin.Paths;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import StringTools;
import Std;

// Adds compatibility fixes for Sky and Manifest note styles.
class KssetteSkyCompat extends Module {
    var isSkyActive:Bool = false;
    var isManifest:Bool = false;

    var cachedSkyTimeTxt:Dynamic;
    // Caches Sky HUD objects so they can be hidden without repeated full searches.
    var cachedSkyTimeBG:Dynamic;
    var cachedSkyScoreTxt:Dynamic; 
    var skyTimerHunted:Bool = false;
    var skyScoreHunted:Bool = false;
    var searchAttempts:Int = 0;
    var searchTimer:Float = 0.0;
    var stylesApplied:Bool = false;
    var cachedState:PlayState = null;
    var cachedAcc:Dynamic = null;
    var cachedFontPath:String = "";

    public function new() {
        // Runs after most modules so Sky compatibility overrides apply last.
        super("KssetteSkyCompat", -50);
    }

    // Applies the Sky font and outline color to a Kassette HUD text object.
    function applySkyStyle(txt:Dynamic, font:String, color:Int) {
        if (txt == null) return;
        try {
            if (txt.font != font || txt.borderColor != color) {
                txt.font = font;
                txt.borderStyle = FlxTextBorderStyle.OUTLINE;
                txt.borderColor = color;
                txt.borderSize = 2;
            }
        } catch(e:Dynamic) {}
    }

    function applySkyStyleAll(kAcc:Dynamic, font:String, color:Int) {
        if (kAcc == null) return;
        applySkyStyle(kAcc.uiText, font, color);
        applySkyStyle(kAcc.infoText, font, color);
        applySkyStyle(kAcc.timeText, font, color);
        applySkyStyle(kAcc.modeText, font, color);

        var arr:Dynamic = kAcc.judgeLabels;
        if (arr != null) for (txt in arr) applySkyStyle(txt, font, color);
        arr = kAcc.judgeValues;
        if (arr != null) for (txt in arr) applySkyStyle(txt, font, color);
    }

    function hideSkyObj(obj:Dynamic) {
        if (obj == null) return;
        try {
            if (obj.y != -5000) obj.y = -5000;
            if (obj.visible != false) obj.visible = false;
            if (obj.alpha != 0) obj.alpha = 0;
        } catch(e:Dynamic) {}
    }

    override public function onCountdownStart(event) {
        super.onCountdownStart(event);
        
        skyTimerHunted = false;
        skyScoreHunted = false;
        searchAttempts = 0;
        searchTimer = 0.0;
        cachedSkyTimeTxt = null;
        cachedSkyTimeBG = null;
        cachedSkyScoreTxt = null;
        stylesApplied = false;
        cachedState = null;
        cachedAcc = null;
        cachedFontPath = "";
        isSkyActive = false;
        isManifest = false;

        var state = PlayState.instance;
        if (state == null || state.playerStrumline == null || state.playerStrumline.noteStyle == null) return;

        var noteStyleId = state.playerStrumline.noteStyle.id;
        isSkyActive = (noteStyleId == 'sky' || noteStyleId == 'manifest');

        if (!isSkyActive) return;
        isManifest = (noteStyleId == 'manifest');
        cachedState = state;
        cachedAcc = ModuleHandler.getModule("KssetteAccuracy");
        try { cachedFontPath = Paths.font('Planet-Joy.ttf'); } catch(e:Dynamic) {}
    }

    override public function onUpdate(event) {
        
        if (!isSkyActive) return;

        // Injects Sky text styling once after the accuracy HUD objects exist.
        if (!stylesApplied) {
            var kAcc:Dynamic = cachedAcc;
            if (kAcc == null) {
                kAcc = ModuleHandler.getModule("KssetteAccuracy");
                cachedAcc = kAcc;
            }
            if (kAcc != null && kAcc.uiText != null) {
                var fontPath = cachedFontPath;
                if (fontPath == null || fontPath == "") {
                    try { fontPath = Paths.font('Planet-Joy.ttf'); cachedFontPath = fontPath; } catch(e:Dynamic) {}
                }
                applySkyStyleAll(kAcc, fontPath, !isManifest ? 0xFF002faf : 0xFFFF0000);
                stylesApplied = true;
            }
        }
        
        var state = cachedState;
        if (state == null) state = PlayState.instance;
        if (state == null) return;

        // Finds and hides the native Sky timer and score HUD.
        if (!skyTimerHunted || !skyScoreHunted) {
            searchTimer += event.elapsed;
            if (searchAttempts < 60 && searchTimer >= 0.05) {
                searchTimer = 0.0;
                searchAttempts++;
                var i:Int = state.members.length - 1;
                while (i >= 0) {
                    var member:Dynamic = state.members[i];
                    if (member != null && Std.isOfType(member, FlxText)) {
                        if (!skyTimerHunted && member.size == 35) {
                            cachedSkyTimeTxt = member;
                            if (i > 0) cachedSkyTimeBG = state.members[i - 1]; 
                            skyTimerHunted = true;
                        }
                        if (!skyScoreHunted && member.size == 16 && member.text != null && StringTools.startsWith(member.text, "Score:")) {
                            cachedSkyScoreTxt = member;
                            skyScoreHunted = true;
                        }
                    }
                    i--;
                }
            }
        }

        hideSkyObj(cachedSkyTimeTxt);
        hideSkyObj(cachedSkyTimeBG);
        hideSkyObj(cachedSkyScoreTxt);
    }

    override public function onDestroy(event) {
        super.onDestroy(event);

        // Restores default Kassette text styling when this module is destroyed.
        var kAcc:Dynamic = cachedAcc;
        if (kAcc == null) kAcc = ModuleHandler.getModule("KssetteAccuracy");
        applySkyStyleAll(kAcc, "VCR OSD Mono", 0xFF000000);
    }
}
