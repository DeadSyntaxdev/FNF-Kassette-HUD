package kassettehud.util;

import openfl.utils.Assets;
import openfl.utils.AssetType;
import haxe.Json;
import Type;
import Std;
import funkin.modding.module.Module;
import funkin.save.Save;

class KassetteSkin extends Module {
    public static var current:KassetteSkin = null;
    public static var availableSkins:Array<{id:String, name:String, author:String, description:String}> = [];
    public static var customElementFactories:Map<String, Void->Dynamic> = new Map();

    public var elements:Array<KassetteHUDElement> = [];
    public var skinId:String = "default";
    public var name:String = "default";
    public var apiModule:Dynamic = null;

    public function new() {
        super("KassetteSkin");
        this.active = true;
        current = this;
        
        var savedSkin = Save.instance.modOptions.get("kssette_current_skin");
        if (savedSkin == null) savedSkin = "default";
        
        loadAvailableSkins();
        loadSkin(Std.string(savedSkin));
    }

    public function initialize() {
        for (element in elements) {
            element.skinId = this.skinId;
        }
    }

    public static function loadAvailableSkins() {
        while(KassetteSkin.availableSkins.length > 0) KassetteSkin.availableSkins.pop();
        var allTextAssets = Assets.list(AssetType.TEXT);
        trace("[KassetteSkin] Total TEXT assets found: " + allTextAssets.length);
        
        for (path in allTextAssets) {
            // Handle both forward slashes and backslashes
            var normPath = path.split("\\").join("/");
            var pLower = normPath.toLowerCase();
            if (pLower.indexOf("skins/") != -1 && pLower.substr(pLower.length - 10) == "/skin.json") {
                try {
                    trace("[KassetteSkin] Found potential skin json: " + path);
                    var content = Assets.getText(path);
                    var data = Json.parse(content);
                    
                    var parts = normPath.split("/");
                    var sId = parts[parts.length - 2];
                    
                    var sName = data.name != null ? data.name : sId;
                    var sAuthor = data.author != null ? data.author : "Unknown";
                    var sDesc = data.description != null ? data.description : "No description provided.";
                    KassetteSkin.availableSkins.push({id: sId, name: sName, author: sAuthor, description: sDesc});
                    trace("[KassetteSkin] Discovered skin: " + sId + " (" + sName + ")");
                } catch(e:Dynamic) {
                    trace("[KassetteSkin] Failed to parse " + path + ": " + e);
                }
            }
        }
        
        trace("[KassetteSkin] Finished checking assets. Found " + KassetteSkin.availableSkins.length + " skin(s).");
        if (KassetteSkin.availableSkins.length == 0) {
            trace("[KassetteSkin] Fallback to hardcoded default skin!");
            KassetteSkin.availableSkins.push({id: "default", name: "Default Skin", author: "Kassette", description: "The default Kassette HUD skin."});
        }
    }

    public function getSkinsList():Array<Dynamic> {
        return availableSkins;
    }

    public static function switchSkin(newSkinId:String) {
        var skinInst = current;
        if (skinInst == null) skinInst = ModuleHandler.getModule("KassetteSkin");
        if (skinInst == null) skinInst = new KassetteSkin();
        
        if (skinInst != null) {
            skinInst.loadSkin(newSkinId);
            current = skinInst;
        }
    }

    public function loadSkin(newSkinId:String) {
        for (el in elements) el.destroy();
        elements = [];
        this.skinId = newSkinId;
        this.name = newSkinId;
        loadDefaultElements();
        initialize();
        trace("[KassetteSkin] Switched to skin: " + newSkinId);
    }

    function loadDefaultElements() {
        var jsonPath = "skins/" + this.skinId + "/skin.json";
        var content = null;
        try {
            content = Assets.getText(jsonPath);
        } catch(e:Dynamic) {
            trace("[KassetteSkin] No skin.json found for " + this.skinId + ". Loading defaults.");
        }
        
        if (content != null) {
            try {
                var data = Json.parse(content);
                if (data.name != null) this.name = data.name;
                
                if (data.elements != null && Std.isOfType(data.elements, Array)) {
                    var elList:Array<Dynamic> = data.elements;
                    for (elName in elList) {
                        var elStr:String = Std.string(elName);
                        var inst = instantiateElement(elStr);
                        if (inst != null) addElement(inst);
                    }
                }
            } catch(e:Dynamic) {
                trace("[KassetteSkin] Failed to parse " + jsonPath + ": " + e);
            }
        }
        
        if (elements.length == 0) {
            // Fallback
            addElement(new KssetteHealthBar());
            addElement(new KssetteTimeBar());
            addElement(new KssetteAccuracy());
            addElement(new KssetteShowTitle());
            addElement(new KssetteBreakBar());
        }
    }

    function instantiateElement(className:String):KassetteHUDElement {
        switch (className) {
            case "KssetteHealthBar": return new KssetteHealthBar();
            case "KssetteTimeBar": return new KssetteTimeBar();
            case "KssetteAccuracy": return new KssetteAccuracy();
            case "KssetteShowTitle": return new KssetteShowTitle();
            case "KssetteBreakBar": return new KssetteBreakBar();
            default: 
                if (customElementFactories.exists(className)) {
                    try {
                        var factory = customElementFactories.get(className);
                        return factory();
                    } catch(e:Dynamic) {
                        trace("[KassetteSkin] Failed to instantiate custom element " + className + ": " + e);
                    }
                }
                trace("[KassetteSkin] Could not instantiate custom element (not registered): " + className);
                return null;
        }
    }

    public function addElement(element:KassetteHUDElement) {
        if (element != null) {
            elements.push(element);
        }
    }

    public function getElement(elementName:String):KassetteHUDElement {
        for (element in elements) {
            if (element != null && element.name == elementName) {
                return element;
            }
        }
        return null;
    }

    override public function onCountdownStart(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onCountdownStart(event);
        }
    }

    override public function onUpdate(event:Dynamic) {
        var elapsed = Std.isOfType(event, Float) ? event : event.elapsed;
        for (element in elements) {
            if (element.active) element.onUpdate(elapsed);
        }
    }

    override public function onStepHit(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onStepHit(event);
        }
    }

    override public function onBeatHit(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onBeatHit(event);
        }
    }

    override public function onSongStart(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onSongStart(event);
        }
    }

    override public function onSongRetry(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onSongRetry(event);
        }
    }

    override public function onSongEnd(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onSongEnd(event);
        }
    }

    override public function onResume(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onResume(event);
        }
    }

    override public function onPause(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onPause(event);
        }
    }

    override public function onStateChangeStart(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onStateChangeStart(event);
        }
    }

    override public function onStateChangeEnd(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onStateChangeEnd(event);
        }
    }

    override public function onNoteMiss(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onNoteMiss(event);
        }
    }
    
    override public function onNoteIncoming(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onNoteIncoming(event);
        }
    }

    override public function onEvent(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onEvent(event);
        }
    }

    override public function onGhostMissNote(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onGhostMissNote(event);
        }
    }

    override public function onNoteGhostMiss(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onNoteGhostMiss(event);
        }
    }

    override public function onSubStateOpenBegin(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onSubStateOpenBegin(event);
        }
    }

    override public function onSubStateCloseEnd(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onSubStateCloseEnd(event);
        }
    }

    override public function onNoteHit(event:Dynamic) {
        for (element in elements) {
            if (element.active) element.onNoteHit(event);
        }
    }

    public function destroy() {
        for (element in elements) {
            element.destroy();
        }
        elements = [];
    }
}
