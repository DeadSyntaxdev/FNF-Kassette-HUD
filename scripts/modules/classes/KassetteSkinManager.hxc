package kassettehud.util;

import openfl.utils.Assets;
import haxe.Json;
import StringTools;
import funkin.modding.module.Module;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.UpdateScriptEvent;
import funkin.modding.events.StateChangeScriptEvent;
import funkin.modding.events.SongTimeScriptEvent;

class KassetteSkinManager extends Module {
    public var availableSkins:Array<Dynamic> = [];
    public var currentSkin:KassetteSkin = null;

    public function new() {
        super("KassetteSkinManager");
        loadAvailableSkins();
        switchSkin("default");
    }

    public function loadAvailableSkins() {
        availableSkins = [];
        availableSkins.push({id: "default", name: "Default Skin"});
    }

    public function switchSkin(skinId:String) {
        if (currentSkin != null) {
            currentSkin.destroy();
            currentSkin = null;
        }

        try {
            currentSkin = new KassetteSkin(skinId);
        } catch(e:Dynamic) {
            trace("[KassetteSkinManager] Failed to load skin " + skinId + ", falling back to default. Error: " + e);
            if (skinId != "default") currentSkin = new KassetteSkin("default");
        }
        
        if (currentSkin != null) {
            currentSkin.initialize();
        }
    }

    override public function onCountdownStart(event:ScriptEvent) {
        super.onCountdownStart(event);
        if (currentSkin != null) currentSkin.onCountdownStart(event);
    }

    override public function onUpdate(event:UpdateScriptEvent) {
        super.onUpdate(event);
        if (currentSkin != null) currentSkin.onUpdate(event.elapsed);
    }

    override public function onStepHit(event:SongTimeScriptEvent) {
        super.onStepHit(event);
        if (currentSkin != null) currentSkin.onStepHit(event);
    }

    override public function onBeatHit(event:SongTimeScriptEvent) {
        super.onBeatHit(event);
        if (currentSkin != null) currentSkin.onBeatHit(event);
    }

    override public function onSongStart(event:ScriptEvent) {
        super.onSongStart(event);
        if (currentSkin != null) currentSkin.onSongStart(event);
    }

    override public function onSongRetry(event:ScriptEvent) {
        super.onSongRetry(event);
        if (currentSkin != null) currentSkin.onSongRetry(event);
    }

    override public function onSongEnd(event:ScriptEvent) {
        super.onSongEnd(event);
        if (currentSkin != null) currentSkin.onSongEnd(event);
    }

    override public function onResume(event:ScriptEvent) {
        super.onResume(event);
        if (currentSkin != null) currentSkin.onResume(event);
    }

    override public function onPause(event:ScriptEvent) {
        super.onPause(event);
        if (currentSkin != null) currentSkin.onPause(event);
    }

    override public function onStateChangeStart(event:StateChangeScriptEvent) {
        super.onStateChangeStart(event);
        if (currentSkin != null) currentSkin.onStateChangeStart(event);
    }

    override public function onStateChangeEnd(event:StateChangeScriptEvent) {
        super.onStateChangeEnd(event);
        if (currentSkin != null) currentSkin.onStateChangeEnd(event);
    }

    override public function onGhostMissNote(event:ScriptEvent) {
        super.onGhostMissNote(event);
        if (currentSkin != null) currentSkin.onGhostMissNote(event);
    }

    override public function onNoteGhostMiss(event:ScriptEvent) {
        super.onNoteGhostMiss(event);
        if (currentSkin != null) currentSkin.onNoteGhostMiss(event);
    }

    override public function onSubStateOpenBegin(event:ScriptEvent) {
        super.onSubStateOpenBegin(event);
        if (currentSkin != null) currentSkin.onSubStateOpenBegin(event);
    }

    override public function onSubStateCloseEnd(event:ScriptEvent) {
        super.onSubStateCloseEnd(event);
        if (currentSkin != null) currentSkin.onSubStateCloseEnd(event);
    }

    override public function onNoteHit(event:ScriptEvent) {
        super.onNoteHit(event);
        if (currentSkin != null) currentSkin.onNoteHit(event);
    }

    override public function onNoteMiss(event:ScriptEvent) {
        super.onNoteMiss(event);
        if (currentSkin != null) currentSkin.onNoteMiss(event);
    }

    override public function onNoteIncoming(event:ScriptEvent) {
        super.onNoteIncoming(event);
        if (currentSkin != null) currentSkin.onNoteIncoming(event);
    }

    override public function onEvent(event:ScriptEvent) {
        super.onEvent(event);
        if (currentSkin != null) currentSkin.onEvent(event);
    }
}
