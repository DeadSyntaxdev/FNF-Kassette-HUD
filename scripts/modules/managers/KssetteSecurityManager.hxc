package kassettehud.util;

import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.modding.events.UpdateScriptEvent;
import kassettehud.util.KassetteHUDElement;
import flixel.FlxG;
import Std;
import Math;

class KssetteSecurityManager extends Module {
    public var isCompromised:Bool = false;
    private var expectedResponse:String = "";
    private var heartbeatTimer:Float = 4.0;
    private var gracePeriod:Float = 3.0;
    private var _integrityTimer:Float = 0.0;
    private var _accModule:Dynamic = null;

    public function new() {
        super("KssetteSecurityManager");
        KassetteHUDElement.globalSecurityManager = this;
    }

    public function getChallenge():String {
        var msg = "";
        var songHunter = KassetteHUDElement.globalSongHunter;
        if (songHunter != null) msg = songHunter.getModeMessage();
        
        var isBotting:Bool = (msg.indexOf('Botplay') != -1 || msg.indexOf('AutoPlay') != -1);
        var randomId = FlxG.random.int(100, 999);
        var challenge = 'sync_' + randomId;

        if (isBotting) {
            expectedResponse = 'err_' + (randomId * 3);
        } else {
            expectedResponse = 'ok_' + (randomId * 3);
        }
        return challenge;
    }

    public function sendResponse(response:String):Void {
        if (response == expectedResponse && expectedResponse != "") {
            heartbeatTimer = 4.0; 
            gracePeriod = 0;      
        } else {
            if (gracePeriod <= 0) isCompromised = true;
        }
    }

    override public function onUpdate(event:UpdateScriptEvent) {
        super.onUpdate(event);
        
        var api = KassetteHUDElement.globalApi;
        if (api == null) return;
        
        if (api._isInPlayState == true) {
            if (!isCompromised) {
                if (gracePeriod > 0) gracePeriod -= event.elapsed;
                heartbeatTimer -= event.elapsed;
                _integrityTimer += event.elapsed;

                if (heartbeatTimer <= 0 && gracePeriod <= 0) {
                    isCompromised = true;
                } else if (gracePeriod <= 0 && _integrityTimer >= 0.5) {
                    _integrityTimer = 0.0;
                    if (_accModule == null) _accModule = ModuleHandler.getModule("KssetteAccuracy");
                    
                    if (_accModule == null) {
                        isCompromised = true;
                    } else {
                        var msg = "";
                        var songHunter = KassetteHUDElement.globalSongHunter;
                        if (songHunter != null) msg = songHunter.getModeMessage();
                        
                        var isBotting:Bool = (msg != null && (msg.indexOf('Botplay') != -1 || msg.indexOf('AutoPlay') != -1));
                        
                        if (isBotting) {
                            if (_accModule != null) {
                                if (_accModule?.modeText != null) {
                                    var modeTxt = _accModule.modeText;
                                    if (modeTxt != null && modeTxt.visible == false || modeTxt.alpha < 0.1 || (modeTxt.text.indexOf("Botplay") == -1 && modeTxt.text.indexOf("AutoPlay") == -1)) {
                                        isCompromised = true;
                                    }
                                } else {
                                    isCompromised = true;
                                }
                            }
                        }
                    }
                }
            }
        } else {
            heartbeatTimer = 4.0;
            gracePeriod = 3.0;
            _integrityTimer = 0.0;
            _accModule = null;
        }
    }
}
