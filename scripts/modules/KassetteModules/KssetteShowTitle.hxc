package kassettehud.util;

import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import flixel.FlxG;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.FlxSprite;
import funkin.Paths;
import funkin.data.freeplay.album.AlbumRegistry;
import Std;

class KssetteShowTitle extends Module {
    var titleTxt:FlxText;
    var artistTxt:FlxText;
    var albumSprite:FlxSprite;
    var apiModule:Dynamic = null;
    var isActive:Bool = false;
    
    var titleTargetX:Float = 0;
    var artistTargetX:Float = 0;
    var albTargetX:Float = 0;
    var floatDist:Float = 60;
    var totalTitleWidth:Float = 0;
    var animStyle:String = "Classic";
    var animPos:String = "Center";
    var animAlbum:String = "On";
    var isFadingOut:Bool = false;

    public var isPreview:Bool = false;
    public var previewCam:flixel.FlxCamera = null;
    var previewTimer:Float = 0.0;
    var cachedTitleFont:String = "";
    var cachedArtistFont:String = "";

    public function new() {
        super("KssetteShowTitle");
    }

    function killObj(obj:Dynamic) {
        if (obj != null) {
            FlxTween.cancelTweensOf(obj);
            if (PlayState.instance != null && !isPreview) PlayState.instance.remove(obj);
            FlxG.state.remove(obj);
            obj.destroy();
        }
    }

    function cleanUp() {
        killObj(titleTxt);
        killObj(artistTxt);
        killObj(albumSprite);
        titleTxt = null;
        artistTxt = null;
        albumSprite = null;
    }

    function cacheIntroFonts() {
        var titleFontKey = "vcr.ttf";
        var artistFontKey = "vcr.ttf";

        var tk = apiModule.getKssValue("kssette_intro_font_title");
        if (tk != null) titleFontKey = Std.string(tk);

        var ak = apiModule.getKssValue("kssette_intro_font_artist");
        if (ak != null) artistFontKey = Std.string(ak);

        cachedTitleFont = "VCR OSD Mono";
        cachedArtistFont = "VCR OSD Mono";
        cachedTitleFont = Std.string(apiModule.resolveCustomFont(titleFontKey));
        cachedArtistFont = Std.string(apiModule.resolveCustomFont(artistFontKey));
    }

    override public function onStateChangeStart(event:Dynamic) {
        super.onStateChangeStart(event);
        isPreview = false;
        cleanUp();
    }

    override public function onSongRetry(event:Dynamic) {
        super.onSongRetry(event);
        isFadingOut = false;
        cleanUp();
    }

    override public function onDestroy(event:Dynamic) {
        super.onDestroy(event);
        cleanUp();
    }

    function setupUI(cam:flixel.FlxCamera) {
        cleanUp();
        if (!isActive) return;

        var titleStr = "Unknown";
        var artistStr = "Unknown Artist";

        if (isPreview) {
            titleStr = "Preview Song";
            artistStr = "Artist Name";
        } else {
            var state = PlayState.instance;
            if (state != null) {
                if (state.currentChart != null) {
                    if (state.currentChart.songName != null) {
                        var cName = Std.string(state.currentChart.songName);
                        if (cName != "") titleStr = cName;
                    }
                    if (state.currentChart.songArtist != null) {
                        var cArt = Std.string(state.currentChart.songArtist);
                        if (cArt != "") artistStr = cArt;
                    }
                }
            }

            if (titleStr == "Unknown" || titleStr == "null") {
                titleStr = Std.string(apiModule.getSongTitle());
            }
            if (artistStr == "Unknown Artist" || artistStr == "null") {
                artistStr = Std.string(apiModule.getSongArtist());
            }
        }

        cacheIntroFonts();

        var titleBaseSize = 44;
        var artistBaseSize = 32;

        try {
            titleBaseSize = apiModule.getFontSize(44, "kssette_size_intro");
            artistBaseSize = apiModule.getFontSize(32, "kssette_size_intro");
        } catch(e:Dynamic) {}

        var showAlbum:String = "On";
        try {
            var rawAlbum = apiModule.getKssValue("kssette_intro_album");
            if (rawAlbum != null) showAlbum = Std.string(rawAlbum);
        } catch(e:Dynamic) {}

        var albumArtAsset:String = null;

        if (showAlbum == "On" || showAlbum == "true") {
            if (isPreview) {
                albumArtAsset = "freeplay/albumRoll/freeplayAlbum/spritemap1";
            } else {
                var albumId:String = null;
                if (PlayState.instance != null && PlayState.instance.currentSong != null) {
                    try {
                        albumId = PlayState.instance.currentSong.getAlbumId(PlayState.instance.currentDifficulty, PlayState.instance.currentVariation);
                    } catch(e:Dynamic) {}
                }
                
                if (albumId != null) {
                    var albumData = AlbumRegistry.instance.fetchEntry(albumId);
                    if (albumData != null) {
                        albumArtAsset = albumData.getAlbumArtAssetKey();
                    }
                }
            }
        }
        
        if (albumArtAsset != null) {
            albumSprite = new FlxSprite(0, 0);
            var g = Paths.image(albumArtAsset);
            if (g != null) {
                albumSprite.loadGraphic(g);
                albumSprite.setGraphicSize(250, 250);
                albumSprite.updateHitbox();
                albumSprite.antialiasing = true;
            } else {
                albumSprite = null;
            }
        }

        var baseY = (FlxG.height / 2) - 150; 

        titleTxt = new FlxText(0, baseY, 0, titleStr, titleBaseSize);
        titleTxt.setFormat(cachedTitleFont, titleBaseSize, 0xFFFFFFFF, "left", FlxTextBorderStyle.OUTLINE, 0xFF000000);
        titleTxt.borderSize = 3;
        titleTxt.updateHitbox();

        artistTxt = new FlxText(0, baseY + 50, 0, artistStr, artistBaseSize);
        artistTxt.setFormat(cachedArtistFont, artistBaseSize, 0xFFCCCCCC, "left", FlxTextBorderStyle.OUTLINE, 0xFF000000);
        artistTxt.borderSize = 2;
        artistTxt.updateHitbox();

        totalTitleWidth = titleTxt.width;
        var artistWidth = artistTxt.width;
        
        if (animStyle == "Clap") animPos = "Center";

        albTargetX = 0;

        if (animPos == "Left") {
            titleTargetX = 50;
            artistTargetX = 50;
            albTargetX = FlxG.width - 50 - 250;
        } else if (animPos == "Right") {
            titleTargetX = FlxG.width - 50 - totalTitleWidth;
            artistTargetX = FlxG.width - 50 - artistWidth;
            albTargetX = 50;
        } else {
            titleTargetX = (FlxG.width / 2) - (totalTitleWidth / 2);
            artistTargetX = (FlxG.width / 2) - (artistWidth / 2);
            albTargetX = (FlxG.width / 2) - 125;
        }

        if (animStyle == "Clap") {
            titleTxt.x = titleTargetX;
            titleTxt.y = -200;
            titleTxt.alpha = 1;

            artistTxt.x = artistTargetX;
            artistTxt.y = FlxG.height + 200;
            artistTxt.alpha = 1;
            
            if (albumSprite != null) {
                albumSprite.x = albTargetX;
                albumSprite.y = FlxG.height + 300;
                albumSprite.alpha = 1;
            }
        } else if (animStyle == "Racer") {
            titleTxt.x = titleTargetX;
            titleTxt.y = FlxG.height + 50;
            titleTxt.alpha = 1;

            artistTxt.x = artistTargetX;
            artistTxt.y = FlxG.height + 100;
            artistTxt.alpha = 1;
            
            if (albumSprite != null) {
                albumSprite.x = albTargetX;
                albumSprite.y = FlxG.height + 300;
                albumSprite.alpha = 1;
            }
        } else {
            titleTxt.x = -totalTitleWidth - 200;
            titleTxt.y = baseY;
            titleTxt.alpha = 0; 

            artistTxt.x = FlxG.width + 200;
            artistTxt.y = baseY + 50;
            artistTxt.alpha = 0; 
            
            if (albumSprite != null) {
                if (animPos == "Left") {
                    albumSprite.x = FlxG.width + 300;
                    albumSprite.y = baseY + 100;
                } else if (animPos == "Right") {
                    albumSprite.x = -300;
                    albumSprite.y = baseY + 100;
                } else {
                    albumSprite.x = albTargetX;
                    albumSprite.y = FlxG.height + 300;
                }
                albumSprite.alpha = 1;
            }
        }
        
        if (albumSprite != null) {
            albumSprite.cameras = [cam];
            albumSprite.zIndex = 100000;
            if (PlayState.instance != null && !isPreview) PlayState.instance.add(albumSprite);
            else FlxG.state.add(albumSprite);
        }

        artistTxt.cameras = [cam]; 
        artistTxt.zIndex = 100001;
        if (PlayState.instance != null && !isPreview) PlayState.instance.add(artistTxt);
        else FlxG.state.add(artistTxt);

        titleTxt.cameras = [cam]; 
        titleTxt.zIndex = 100002;
        if (PlayState.instance != null && !isPreview) PlayState.instance.add(titleTxt);
        else FlxG.state.add(titleTxt);

        if (artistStr == "Unknown Artist" || artistStr == "null" || artistStr == "") {
            artistTxt.visible = false;
            if (animStyle != "Racer") titleTxt.y = baseY + 15; 
        }
    }

    function startAnim() {
        if (!isActive) return;

        if (animStyle == "Clap") {
            var tBaseY = (FlxG.height / 2) - 80;
            var aBaseY = tBaseY + 50;
            if (artistTxt != null && !artistTxt.visible) tBaseY = (FlxG.height / 2) - 60;
            var albBaseY = tBaseY + 100;

            if (albumSprite != null) {
                FlxTween.cancelTweensOf(albumSprite);
                albumSprite.y = FlxG.height + 300;
                albumSprite.alpha = 1;
                FlxTween.tween(albumSprite, {y: albBaseY}, 0.4, {ease: FlxEase.expoOut, startDelay: 0.2, onComplete: function(t1:FlxTween) {
                    FlxTween.tween(albumSprite, {y: albBaseY}, 3.0 - 0.2, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                        FlxTween.tween(albumSprite, {y: -350}, 0.5, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                            if (!isPreview && albumSprite != null) killObj(albumSprite);
                        }});
                    }});
                }});
            }

            if (titleTxt != null) {
                FlxTween.cancelTweensOf(titleTxt);
                titleTxt.y = -200;
                titleTxt.alpha = 1;
                FlxTween.tween(titleTxt, {y: tBaseY}, 0.4, {ease: FlxEase.expoOut, onComplete: function(t1:FlxTween) {
                    FlxTween.tween(titleTxt, {y: tBaseY}, 3.0, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                        FlxTween.tween(titleTxt, {y: -200}, 0.5, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                            if (!isPreview && titleTxt != null) killObj(titleTxt);
                        }});
                    }});
                }});
            }
            if (artistTxt != null && artistTxt.visible) {
                FlxTween.cancelTweensOf(artistTxt);
                artistTxt.y = FlxG.height + 200;
                artistTxt.alpha = 1;
                FlxTween.tween(artistTxt, {y: aBaseY}, 0.4, {ease: FlxEase.expoOut, onComplete: function(t1:FlxTween) {
                    FlxTween.tween(artistTxt, {y: aBaseY}, 3.0, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                        FlxTween.tween(artistTxt, {y: FlxG.height + 200}, 0.5, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                            if (!isPreview && artistTxt != null) killObj(artistTxt);
                        }});
                    }});
                }});
            }
        } else if (animStyle == "Racer") {
            var tBaseY = (FlxG.height / 2) - 150;
            var aBaseY = tBaseY + 50;
            if (artistTxt != null && !artistTxt.visible) tBaseY = tBaseY + 15;
            var albBaseY = tBaseY + 100;

            if (albumSprite != null) {
                FlxTween.cancelTweensOf(albumSprite);
                albumSprite.alpha = 1;
                if (animPos == "Left") {
            // Album is on Right. Starts on Right.
                    albumSprite.y = albBaseY;
                    albumSprite.x = FlxG.width + 300;
                    FlxTween.tween(albumSprite, {x: albTargetX}, 1.0, {ease: FlxEase.expoOut, startDelay: 0.0, onComplete: function(t1:FlxTween) {
                        FlxTween.tween(albumSprite, {x: albTargetX - 30}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                            FlxTween.tween(albumSprite, {x: FlxG.width + 300}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                                if (!isPreview && albumSprite != null) killObj(albumSprite);
                            }});
                        }});
                    }});
                } else if (animPos == "Right") {
            // Album is on Left. Starts on Left.
                    albumSprite.y = albBaseY;
                    albumSprite.x = -300;
                    FlxTween.tween(albumSprite, {x: albTargetX}, 1.0, {ease: FlxEase.expoOut, startDelay: 0.0, onComplete: function(t1:FlxTween) {
                        FlxTween.tween(albumSprite, {x: albTargetX + 30}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                            FlxTween.tween(albumSprite, {x: -300}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                                if (!isPreview && albumSprite != null) killObj(albumSprite);
                            }});
                        }});
                    }});
                } else {
                    albumSprite.y = FlxG.height + 300;
                    albumSprite.x = albTargetX;
                    FlxTween.tween(albumSprite, {y: albBaseY}, 1.0, {ease: FlxEase.expoOut, startDelay: 0.0, onComplete: function(t1:FlxTween) {
                        FlxTween.tween(albumSprite, {y: albBaseY - 30}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                            FlxTween.tween(albumSprite, {y: -300}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                                if (!isPreview && albumSprite != null) killObj(albumSprite);
                            }});
                        }});
                    }});
                }
            }

            if (titleTxt != null) {
                FlxTween.cancelTweensOf(titleTxt);
                titleTxt.y = FlxG.height + 50;
                titleTxt.alpha = 1;
                FlxTween.tween(titleTxt, {y: tBaseY}, 1.0, {ease: FlxEase.expoOut, startDelay: 0.1, onComplete: function(t1:FlxTween) {
                    FlxTween.tween(titleTxt, {y: tBaseY - 30}, 3.4, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                        FlxTween.tween(titleTxt, {y: -200}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                            if (!isPreview && titleTxt != null) killObj(titleTxt);
                        }});
                    }});
                }});
            }
            if (artistTxt != null && artistTxt.visible) {
                FlxTween.cancelTweensOf(artistTxt);
                artistTxt.y = FlxG.height + 100;
                artistTxt.alpha = 1;
                FlxTween.tween(artistTxt, {y: aBaseY}, 1.0, {ease: FlxEase.expoOut, startDelay: 0.2, onComplete: function(t1:FlxTween) {
                    FlxTween.tween(artistTxt, {y: aBaseY - 30}, 3.3, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                        FlxTween.tween(artistTxt, {y: -200}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                            if (!isPreview && artistTxt != null) killObj(artistTxt);
                        }});
                    }});
                }});
            }
        } else {
            var baseY = (FlxG.height / 2) - 150;
            var albBaseY = baseY + 100;
            if (albumSprite != null) {
                FlxTween.cancelTweensOf(albumSprite);
                if (animPos == "Left") {
                    albumSprite.x = FlxG.width + 300;
                    FlxTween.tween(albumSprite, {x: albTargetX}, 1.0, {ease: FlxEase.expoOut, onComplete: function(t1:FlxTween) {
                        FlxTween.tween(albumSprite, {x: albTargetX - 30}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                            FlxTween.tween(albumSprite, {x: FlxG.width + 300}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                                if (!isPreview && albumSprite != null) killObj(albumSprite);
                            }});
                        }});
                    }});
                } else if (animPos == "Right") {
                    albumSprite.x = -300;
                    FlxTween.tween(albumSprite, {x: albTargetX}, 1.0, {ease: FlxEase.expoOut, onComplete: function(t1:FlxTween) {
                        FlxTween.tween(albumSprite, {x: albTargetX + 30}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                            FlxTween.tween(albumSprite, {x: -300}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                                if (!isPreview && albumSprite != null) killObj(albumSprite);
                            }});
                        }});
                    }});
                } else {
                    FlxTween.tween(albumSprite, {y: albBaseY}, 1.0, {ease: FlxEase.expoOut, onComplete: function(t1:FlxTween) {
                        FlxTween.tween(albumSprite, {y: albBaseY - 30}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                            FlxTween.tween(albumSprite, {y: -300}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                                if (!isPreview && albumSprite != null) killObj(albumSprite);
                            }});
                        }});
                    }});
                }
            }
            if (titleTxt != null) {
                FlxTween.cancelTweensOf(titleTxt);
                titleTxt.x = -totalTitleWidth - 200;
                titleTxt.alpha = 0;
                FlxTween.tween(titleTxt, {x: titleTargetX - (floatDist/2), alpha: 1}, 1.0, {ease: FlxEase.expoOut, onComplete: function(t1:FlxTween) {
                    FlxTween.tween(titleTxt, {x: titleTargetX + (floatDist/2)}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                        FlxTween.tween(titleTxt, {x: FlxG.width + 200, alpha: 0}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                            if (!isPreview && titleTxt != null) killObj(titleTxt);
                        }});
                    }});
                }});
            }

            if (artistTxt != null && artistTxt.visible) {
                FlxTween.cancelTweensOf(artistTxt);
                artistTxt.x = FlxG.width + 200;
                artistTxt.alpha = 0;
                FlxTween.tween(artistTxt, {x: artistTargetX + (floatDist/2), alpha: 1}, 1.0, {ease: FlxEase.expoOut, onComplete: function(t1:FlxTween) {
                    FlxTween.tween(artistTxt, {x: artistTargetX - (floatDist/2)}, 3.5, {ease: FlxEase.linear, onComplete: function(t2:FlxTween) {
                        FlxTween.tween(artistTxt, {x: -artistTxt.width - 200, alpha: 0}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t3:FlxTween) {
                            if (!isPreview && artistTxt != null) killObj(artistTxt);
                        }});
                    }});
                }});
            }
        }
    }

    override public function onCountdownStart(event:Dynamic) {
        super.onCountdownStart(event);
        isFadingOut = false;
        cleanUp();
        isPreview = false;

        apiModule = ModuleHandler.getModule("KssetteApi");
        if (apiModule == null) return;

        try {
            var rawStyle = apiModule.getKssValue("kssette_intro_text");
            animStyle = Std.string(rawStyle);
            
            var rawPos = apiModule.getKssValue("kssette_intro_pos");
            if (rawPos != null) animPos = Std.string(rawPos);
            else animPos = "Center";
            
            isActive = (animStyle != "Off" && animStyle != "false");
        } catch(e:Dynamic) {
            isActive = false;
        }
        
        if (!isActive) return;

        var state = PlayState.instance;
        if (state == null || state.camHUD == null) return;

        setupUI(state.camHUD);
    }

    override public function onSongStart(event:Dynamic) {
        super.onSongStart(event);
        if (!isPreview && isActive) {
            startAnim();
        }
    }

    public function buildPreview(cam:flixel.FlxCamera) {
        isPreview = true;
        isFadingOut = false;
        previewCam = cam;
        
        apiModule = ModuleHandler.getModule("KssetteApi");
        if (apiModule != null) {
            var rawStyle = apiModule.getKssValue("kssette_intro_text");
            animStyle = Std.string(rawStyle);
            
            var rawPos = apiModule.getKssValue("kssette_intro_pos");
            if (rawPos != null) animPos = Std.string(rawPos);
            else animPos = "Center";
            
            var rawAlbum = apiModule.getKssValue("kssette_intro_album");
            if (rawAlbum != null) animAlbum = Std.string(rawAlbum);
            else animAlbum = "On";
            
            isActive = (animStyle != "Off" && animStyle != "false");
        }

        setupUI(cam);
        if (isActive) {
            previewTimer = 0.5;
        }
    }







    public function updatePreview() {
        if (!isPreview || apiModule == null) return;

        var rawStyle = apiModule.getKssValue("kssette_intro_text");
        var currentActive = (Std.string(rawStyle) != "Off" && Std.string(rawStyle) != "false");
        var newStyle = Std.string(rawStyle);
        
        var rawPos = apiModule.getKssValue("kssette_intro_pos");
        var newPos = rawPos != null ? Std.string(rawPos) : "Center";
        
        var rawAlbum = apiModule.getKssValue("kssette_intro_album");
        var newAlbum = rawAlbum != null ? Std.string(rawAlbum) : "On";
        
        var oldTitleFont = cachedTitleFont;
        var oldArtistFont = cachedArtistFont;
        cacheIntroFonts();

        var changed = false;
        if (isActive != currentActive) {
            isActive = currentActive;
            changed = true;
        }
        if (animStyle != newStyle) { animStyle = newStyle; changed = true; }
        if (animPos != newPos) { animPos = newPos; changed = true; }
        if (animAlbum != newAlbum) { animAlbum = newAlbum; changed = true; }
        if (oldTitleFont != cachedTitleFont || oldArtistFont != cachedArtistFont) changed = true;

        if (changed) {
            setupUI(previewCam);
            if (isActive) {
                previewTimer = 0.5;
            } else {
                cleanUp();
            }
        }
    }

    function forceFadeOut() {
        isFadingOut = true;
        if (titleTxt != null && titleTxt.visible) {
            FlxTween.cancelTweensOf(titleTxt);
            FlxTween.tween(titleTxt, {alpha: 0}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t:FlxTween) { if (!isPreview && titleTxt != null) killObj(titleTxt); }});
        }
        if (artistTxt != null && artistTxt.visible) {
            FlxTween.cancelTweensOf(artistTxt);
            FlxTween.tween(artistTxt, {alpha: 0}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t:FlxTween) { if (!isPreview && artistTxt != null) killObj(artistTxt); }});
        }
        if (albumSprite != null && albumSprite.visible) {
            FlxTween.cancelTweensOf(albumSprite);
            FlxTween.tween(albumSprite, {alpha: 0}, 1.0, {ease: FlxEase.expoIn, onComplete: function(t:FlxTween) { if (!isPreview && albumSprite != null) killObj(albumSprite); }});
        }
    }

    override public function onUpdate(event:Dynamic) {
        if (isPreview && isActive) {
            if (previewTimer > 0) {
                previewTimer -= event.elapsed;
                if (previewTimer <= 0) {
                    startAnim();
                }
            }
        } else if (!isPreview && isActive && !isFadingOut) {
            var state = PlayState.instance;
            if (state != null && state.conductorInUse != null && apiModule != null) {
                var notes = apiModule.playerNoteTimes;
                if (notes != null && notes.length > 0) {
                    var firstNoteTime = notes[0].start;
                    var currentTime = state.conductorInUse.songPosition;
                    if (firstNoteTime - currentTime < 1200) {
                        forceFadeOut();
                    }
                }
            }
        }
    }
}
