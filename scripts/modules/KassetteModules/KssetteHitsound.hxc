package kassettehud.util;

import funkin.modding.module.Module;
import funkin.Paths;
import funkin.save.Save;
import funkin.audio.FunkinSound;
import funkin.play.PlayState;
import funkin.modding.events.ScriptEvent;
import Std;
import Math;
import StringTools;

class KssetteHitsound extends Module {
    var isPaused:Bool = false;
    var hitSound:Dynamic = null;

    public function new() {
        super('KssetteHitsound');
    }

    function isOn(val:Dynamic):Bool {
        if (val == true) return true;
        if (val == false) return false;
        var s = Std.string(val);
        return s == "On" || s == "on" || s == "true";
    }

    function readEnabled():Bool {
        try { return isOn(Save.instance.modOptions.get("kssette_hitsound")); } catch(e:Dynamic) {}
        return false;
    }

    function readVolume():Float {
        try {
            var v = Save.instance.modOptions.get("kssette_hitsound_volume");
            if (v != null) {
                var p = Std.parseFloat(StringTools.replace(Std.string(v), "%", ""));
                if (!Math.isNaN(p)) return p > 1.0 ? p / 100.0 : p;
            }
        } catch(e:Dynamic) {}
        return 1.0;
    }

    function playHitSound() {
        if (hitSound == null) try { hitSound = Paths.sound("play/hitsound"); } catch(e:Dynamic) {}
        if (hitSound != null) try { FunkinSound.playOnce(hitSound, readVolume()); } catch(e:Dynamic) {}
    }

    override public function onCountdownStart(event:Dynamic) {
        super.onCountdownStart(event);
        isPaused = false;
        hitSound = null;
        try { hitSound = Paths.sound("play/hitsound"); } catch(e:Dynamic) {}
    }

    override function onPause(event:ScriptEvent) {
        super.onPause(event);
        isPaused = true;
    }

    override function onStateChangeEnd(event:ScriptEvent) {
        super.onStateChangeEnd(event);
        isPaused = false;
    }

    override function onResume(event:ScriptEvent) {
        super.onResume(event);
        isPaused = false;
    }

    override function onNoteHit(event:Dynamic) {
        if (isPaused || !readEnabled()) return;

        var state = PlayState.instance;
        if (state == null || state.isPlayerDying) return;

        try {
            var note = event.note;
            if (note != null && note.noteData != null && !note.noteData.getMustHitNote()) return;
        } catch(e:Dynamic) {
            return;
        }

        playHitSound();
    }
}
