package kassettehud.util;

/**
 * KssetteHitsound
 *
 * Reproduce un efecto de sonido personalizado cuando el jugador acierta o presiona las teclas de nota.
 *
 * Modos:
 *   - "Off"         - Disabled; no custom hitsound plays.
 *   - "On Note Hit" - Plays on successful note hits (player notes only).
 *   - "Anytime"     - Plays on any key press, regardless of notes (ghost-tap style).
 *   - "Off": Desactivado; no se reproduce ningún sonido de acierto personalizado.
 *   - "On Note Hit": Se reproduce en aciertos de nota exitosos (solo notas del jugador).
 *   - "Anytime": Se reproduce con cualquier pulsación de tecla, independientemente de las notas (estilo "ghost-tap").
 *
 * El recurso de sonido de acierto se carga desde "play/hitsound" en la carpeta de audio del mod
 * y se cachea al inicio de la cuenta atrás para una reproducción instantánea durante el juego.
 *
 * Ajustes que maneja:
 *   - kssette_hitsound:        "Off" | "On Note Hit" | "Anytime"
 *   - kssette_hitsound_volume: "10%" ... "100%"
 *
 * Dependencias:
 *   - KssetteApi.getKssValue() - lee los valores de las opciones
 *   - Paths.sound()            - carga el recurso de sonido de acierto
 */

import flixel.FlxG;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.Paths;
import funkin.save.Save;
import funkin.audio.FunkinSound;
import funkin.play.PlayState;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.UpdateScriptEvent;
import Std;
import Math;
import StringTools;

class KssetteHitsound extends Module {
    /** Indica si el juego está en pausa; suprime la reproducción de sonidos de acierto. */
    var isPaused:Bool = false;
    /** Referencia cacheada al recurso de audio del sonido de acierto. */
    var hitSound:Dynamic = null;
    /** Referencia cacheada al módulo KssetteApi. */
    var apiModule:Dynamic = null;

    public function new() {
        super('KssetteHitsound');
    }

    /**
     * Resuelve y normaliza el modo de sonido de acierto actual desde el ajuste guardado.
     * Normaliza valores booleanos heredados (true/"On") a "On Note Hit".
     *
     * @return "On Note Hit" | "Anytime" | "Off"
     */
    function getMode():String {
        if (apiModule == null) apiModule = ModuleHandler.getModule("KssetteApi");
        if (apiModule == null) return "Off";
        var val = apiModule?.getKssValue("kssette_hitsound");
        if (val == null) return "Off";
        var s = Std.string(val);
        if (s == "On" || s == "on" || s == "true" || val == true || s == "On Note Hit") return "On Note Hit";
        if (s == "Anytime" || s == "anytime") return "Anytime";
        return "Off";
    }

    /**
     * Lee el ajuste de volumen del sonido de acierto y lo convierte a un flotante de 0.0 a 1.0.
     * Acepta valores como "80%" o "0.8"; recurre a 1.0 si no está configurado o es inválido.
     * Lee desde KssetteApi si está disponible, de lo contrario recurre directamente a Save.
     */
    function readVolume():Float {
        if (apiModule == null) apiModule = ModuleHandler.getModule("KssetteApi");
        var v:Dynamic = apiModule?.getKssValue("kssette_hitsound_volume");
        if (v == null && Save.instance?.modOptions?.exists("kssette_hitsound_volume") == true) {
            v = Save.instance.modOptions.get("kssette_hitsound_volume");
        }
        if (v != null) {
            var p = Std.parseFloat(StringTools.replace(Std.string(v), "%", ""));
            if (!Math.isNaN(p)) return p > 1.0 ? p / 100.0 : p;
        }
        return 1.0;
    }

    /**
     * Reproduce el sonido de acierto al volumen configurado actualmente.
     * Carga el recurso de sonido de forma perezosa en la primera llamada si no está ya cacheado.
     */
    function playHitSound() {
        if (hitSound == null) hitSound = Paths.sound("play/hitsound");
        if (hitSound != null) FunkinSound.playOnce(hitSound, readVolume());
    }

    /**
     * Se llama al inicio de la canción. Pre-cachea el recurso de sonido de acierto y resetea el estado de pausa.
     * Cargar aquí asegura que el primer acierto en una canción no tenga latencia.
     */
    override public function onCountdownStart(event:Dynamic) {
        super.onCountdownStart(event);
        isPaused = false;
        hitSound = Paths.sound("play/hitsound");
        trace("[KssetteHitsound] onCountdownStart - mode=" + getMode() + " hitSoundLoaded=" + (hitSound != null));
    }

    /** Establece isPaused para suprimir la reproducción de sonidos de acierto durante el menú de pausa. */
    override function onPause(event:ScriptEvent) {
        super.onPause(event);
        isPaused = true;
    }

    /** Limpia isPaused al cambiar de estado de juego. */
    override function onStateChangeEnd(event:ScriptEvent) {
        super.onStateChangeEnd(event);
        isPaused = false;
    }

    /** Limpia isPaused cuando el jugador reanuda desde la pausa. */
    override function onResume(event:ScriptEvent) {
        super.onResume(event);
        isPaused = false;
    }

    /**
     * Actualización por frame. Maneja el modo "Anytime": reproduce el sonido de acierto
     * cada vez que se presiona una tecla de nota, sin importar si existe una nota.
     * Solo se ejecuta cuando el modo es "Anytime" y el juego no está en pausa o muriendo.
     */
    override public function onUpdate(event:UpdateScriptEvent) {
        super.onUpdate(event);

        if (isPaused) return;
        if (getMode() != "Anytime") return;

        var state = PlayState.instance;
        if (state == null || state.isPlayerDying) return;

        var controlsObj = state?.controls;
        if (controlsObj == null) return;

        if (controlsObj.NOTE_LEFT_P || controlsObj.NOTE_DOWN_P || controlsObj.NOTE_UP_P || controlsObj.NOTE_RIGHT_P) {
            playHitSound();
        }
    }

    /**
     * Se llama cuando se acierta una nota. Maneja el modo "On Note Hit":
     * reproduce el sonido de acierto solo para las notas del jugador (getMustHitNote == true).
     * Ignora las notas del oponente para evitar una doble activación en auto-play.
     */
    override function onNoteHit(event:Dynamic) {
        super.onNoteHit(event);
        
        if (isPaused) return;
        if (getMode() != "On Note Hit") return;

        var state = PlayState.instance;
        if (state == null || state.isPlayerDying) return;

        var note = event.note;
        if (note?.noteData == null) return;

        // Usa `?` para llamar de forma segura a getMustHitNote(); recurre a la forma de propiedad como alternativa.
        var mustHit = note.noteData?.getMustHitNote();
        if (mustHit == null) mustHit = note.noteData?.mustHitNote;
        if (mustHit != true) return;

        playHitSound();
    }
}