package kassettehud.util;

import funkin.modding.module.Module;
import funkin.Paths;
import funkin.save.Save;
import funkin.audio.FunkinSound;
import funkin.play.PlayState;
import funkin.modding.events.ScriptEvent;
import Std;
import Math;
import StringTools;

class KssetteHitsound extends Module {
    var isPaused:Bool = false;
    var isEnabled:Bool = false;
    var soundVolume:Float = 1.0;
    var hitSound:Dynamic = null;
    var cachedState:PlayState = null;

    public function new() {
        super('KssetteHitsound');
    }

    function isOn(val:Dynamic):Bool {
        if (val == true) return true;
        var s = Std.string(val);
        return s == "On" || s == "on" || s == "true";
    }

    function playHitSound() {
        if (hitSound == null) try { hitSound = Paths.sound("play/hitsound"); } catch(e:Dynamic) {}
        if (hitSound != null) try { FunkinSound.playOnce(hitSound, soundVolume); } catch(e:Dynamic) {}
    }

    override public function onCountdownStart(event:Dynamic) {
        super.onCountdownStart(event);
        isPaused = false;
        isEnabled = false;
        soundVolume = 1.0;
        hitSound = null;
        cachedState = PlayState.instance;

        var opts = Save.instance != null ? Save.instance.modOptions : null;
        if (opts != null) {
            isEnabled = isOn(opts.get("kssette_hitsound"));
            var fetchedVol = opts.get("kssette_hitsound_volume");
            if (fetchedVol != null) {
                var parsedVol = Std.parseFloat(StringTools.replace(Std.string(fetchedVol), "%", ""));
                if (!Math.isNaN(parsedVol)) soundVolume = parsedVol > 1.0 ? parsedVol / 100.0 : parsedVol;
            }
        }

        if (isEnabled) try { hitSound = Paths.sound("play/hitsound"); } catch(e:Dynamic) {}
    }

    override function onPause(event:ScriptEvent) {
        super.onPause(event);
        isPaused = true;
    }

    override function onStateChangeEnd(event:ScriptEvent) {
        super.onStateChangeEnd(event);
        isPaused = false;
        cachedState = null;
    }

    override function onResume(event:ScriptEvent) {
        super.onResume(event);
        isPaused = false;
    }

    override function onNoteHit(event:Dynamic) {
        if (!isEnabled || isPaused) return;

        var state = cachedState;
        if (state == null) {
            state = PlayState.instance;
            cachedState = state;
        }
        if (state == null || state.isPlayerDying) return;

        try {
            var note = event.note;
            if (note != null && note.noteData != null && !note.noteData.getMustHitNote()) return;
        } catch(e:Dynamic) {
            return;
        }

        playHitSound();
    }
}
