package kassettehud.util;

import flixel.FlxG;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.UpdateScriptEvent;
import funkin.play.PlayState;
import funkin.play.notes.Strumline;
import funkin.util.Constants;
import funkin.Preferences;
import funkin.mobile.input.ControlsHandler;
import Std;
import Math;
import Reflect;

class KssMiddlescroll extends Module {
    var cachedMode:String = "Off";
    var cachedOppPos:String = "Left";
    var cachedOppBg:Bool = false;
    var cachedMobileOppNotes:Bool = true;
    var hasShifted:Bool = false;
    var apiModule:Dynamic = null;
    var cachedOppStrum:Dynamic = null;
    var cachedReceptors:Dynamic = null;
    var cachedSplashes:Dynamic = null;
    var cachedHasSplashOffsets:Bool = false;
    var cachedSplashOffsetX:Float = 0.0;
    var splashUpdateTimer:Float = 0.0;
    var lastNudgedStrum:Dynamic = null;
    var pHasShifted:Bool = false;

    var cachedIsArrows:Bool = false;
    var cachedIsPixelStyle:Bool = false;
    var cachedIsMobPC:Bool = true;

    public function new() {
        super('KssMiddlescroll'); 
    }

    function isOn(val:Dynamic):Bool {
        if (val == true) return true;
        var s = Std.string(val);
        return s == "On" || s == "on" || s == "true";
    }

    override function onCountdownStart(event:ScriptEvent):Void {
        hasShifted = false;
        pHasShifted = false;
        cachedOppStrum = null;
        cachedReceptors = null;
        cachedSplashes = null;
        cachedHasSplashOffsets = false;
        cachedSplashOffsetX = 0.0;
        splashUpdateTimer = 0.0;
        
        var isMobLayout = false;
        apiModule = ModuleHandler.getModule("KssetteApi");
        
        if (apiModule != null) {
            apiModule.registerModule("KssMiddlescroll", this);
            
            var rawMode:Dynamic = apiModule.getKssValue("kssette_middlescroll");
            if (rawMode == true) cachedMode = "On";
            else if (rawMode == false) cachedMode = "Off";
            else cachedMode = Std.string(rawMode);

            cachedOppPos = Std.string(apiModule.getKssValue("kssette_opponent_pos"));
            var rawOppBg:Dynamic = apiModule.getKssValue("kssette_opponent_bg");
            cachedOppBg = isOn(rawOppBg);
            
            var rawMobOppNotes:Dynamic = apiModule.getKssValue("kssette_mobile_opp_notes");
            cachedMobileOppNotes = isOn(rawMobOppNotes);
            
            var isMob = false;
            var isMobPC = false;
            
            if (apiModule.isMobileMode != null) isMob = apiModule.isMobileMode;
            if (apiModule.isMobileLikePC != null) isMobPC = apiModule.isMobileLikePC();
            cachedIsMobPC = isMobPC;
            
            if (isMob && !isMobPC) isMobLayout = true;
        }

        var state = PlayState.instance;
        if (state == null) return;

        cachedIsArrows = false;
        if (Preferences.controlsScheme == 'Arrows') {
            cachedIsArrows = !ControlsHandler.hasExternalInputDevice;
        }

        cachedIsPixelStyle = false;
        if (state.currentChart != null && state.currentChart.noteStyle == 'pixel') {
            cachedIsPixelStyle = true;
        }

        var myStrum = state.playerStrumline;
        var oppStrum = state.opponentStrumline;

        var isArrows = cachedIsArrows;
        var isModActive = (cachedMode != "Off" && cachedMode != "null");

        var pRealWidth:Float = 0;
        var pStartX:Float = 0;
        var padding:Float = 12;

        if (myStrum != null) {
            pStartX = myStrum.x;
            var pNotes = myStrum.strumlineNotes.members;
            
            if (pNotes != null && pNotes.length > 0) {
                var firstNote = pNotes[0];
                var lastNote = pNotes[pNotes.length - 1];
                pRealWidth = (lastNote.x + lastNote.width) - firstNote.x;
                pStartX = firstNote.x;
            }
            
            if (pRealWidth <= 0) pRealWidth = myStrum.width;
            if (pRealWidth <= 0) pRealWidth = 448; 

            var pBg = myStrum.background;
            if (pBg != null) {
                var fWidth:Float = pBg.frameWidth;
                if (fWidth <= 0) fWidth = pBg.width;
                if (fWidth > 0) {
                    pBg.scale.x = (pRealWidth + padding * 2) / fWidth;
                    pBg.updateHitbox();
                    pBg.x = pStartX - padding;
                }
            }
        }

        if (oppStrum != null) {
            var bg = oppStrum.background;
            if (bg != null) {
                if (!isModActive && cachedOppBg && !isMobLayout) {
                    bg.visible = true;
                    var realWidth:Float = 0;
                    var startX:Float = oppStrum.x;
                    var oNotes = oppStrum.strumlineNotes.members;
                    
                    if (oNotes != null && oNotes.length > 0) {
                        var firstNote = oNotes[0];
                        var lastNote = oNotes[oNotes.length - 1];
                        realWidth = (lastNote.x + lastNote.width) - firstNote.x;
                        startX = firstNote.x;
                    }
                    
                    if (realWidth <= 0) realWidth = oppStrum.width;
                    if (realWidth <= 0) realWidth = 448; 
                    
                    var fWidth:Float = bg.frameWidth;
                    if (fWidth <= 0) fWidth = bg.width;
                    if (fWidth > 0) {
                        bg.scale.x = (realWidth + padding * 2) / fWidth;
                        bg.updateHitbox();
                        bg.x = startX - padding;
                    }
                } else {
                    bg.visible = false;
                }
            }
        }

        if (isModActive) {
            state.comboPopUps.offsets = [480, -50];
        }

        if (myStrum != null && isModActive) {
            var centeredX:Float = (FlxG.width - pRealWidth) * 0.5;
            var shift:Float = centeredX - pStartX;
            myStrum.x += shift;

            var pBg = myStrum.background;
            if (pBg != null) {
                pBg.x = centeredX - padding;
            }
        }

        if (oppStrum != null) {
            if (isModActive) {
                if (oppStrum.noteHoldCovers != null && oppStrum.noteHoldCovers.members != null) {
                    oppStrum.noteHoldCovers.visible = false;
                    for (cover in oppStrum.noteHoldCovers.members) {
                        if (cover != null) { cover.visible = false; cover.alpha = 0.0; }
                    }
                }
                if (oppStrum.holdNotes != null && oppStrum.holdNotes.members != null) {
                    for (hold in oppStrum.holdNotes.members) {
                        if (hold != null && hold.cover != null) { hold.cover.visible = false; hold.cover.alpha = 0.0; }
                    }
                }
            }

            if (cachedMode == "Hidden Notes") {
                oppStrum.x = -5000;
                var oNotes = oppStrum.strumlineNotes.members;
                if (oNotes != null) {
                    for (note in oNotes) {
                        if (note != null) note.x = -5000;
                    }
                }
            } else if (cachedMode == "Glass") {
                if (myStrum != null) {
                    oppStrum.x = myStrum.x;
                    oppStrum.zIndex = myStrum.zIndex - 10;
                    if (state != null) state.refresh();
                }
                var receptors = oppStrum.strumlineNotes.members;
                if (receptors != null) {
                    for (receptor in receptors) {
                        if (receptor != null) {
                            receptor.alpha = 0.7;
                            receptor.color = 0xFFAEAEAE;
                        }
                    }
                }
                var bg = oppStrum.background;
                if (bg != null) bg.visible = false;
                oppStrum.showNotesplash = false;
                
                hasShifted = true;
            }

            if (isArrows && cachedMobileOppNotes) {
                oppStrum.notes.visible = true;
                oppStrum.holdNotes.visible = true;
                oppStrum.isDownscroll = false;
                
                if (lastNudgedStrum != oppStrum) {
                    var nudgeY:Float = -15.0; 
                    if (!cachedIsMobPC) {
                        oppStrum.y += nudgeY;
                    } else {
                        var nudgeX:Float = -65.0; 
                        oppStrum.y += nudgeY; 
                        oppStrum.x += nudgeX; 
                    }
                    lastNudgedStrum = oppStrum;
                }
            }
        }

        cachedOppStrum = oppStrum;
        if (cachedOppStrum != null) {
            cachedReceptors = cachedOppStrum.strumlineNotes != null ? cachedOppStrum.strumlineNotes.members : null;
            cachedSplashes = cachedOppStrum.noteSplashes;
            
            if (cachedOppStrum.noteStyle != null) {
                var offsets = cachedOppStrum.noteStyle.getSplashOffsets();
                cachedHasSplashOffsets = (offsets != null && offsets.length > 0);
                if (cachedHasSplashOffsets) cachedSplashOffsetX = offsets[0];
            } else {
                cachedHasSplashOffsets = false;
                cachedSplashOffsetX = 0.0;
            }
        }
    }

    override function onSongRetry(event:ScriptEvent):Void {
        // onCountdownStart is called on retry anyway, so this is mostly redundant.
        super.onSongRetry(event);
    }

    override function onNoteIncoming(event:ScriptEvent) {
        super.onNoteIncoming(event);
        
        var state = PlayState.instance;
        if (state == null) return;

        var applyArrowLogic = cachedIsArrows && cachedMobileOppNotes;
        var isModActive = (cachedMode == "On" || cachedMode == "P Style" || cachedMode == "Hidden Notes" || cachedMode == "Glass");

        if (!isModActive && !applyArrowLogic) return;

        var note = event.note;
        var isOppNote = !note.noteData.getMustHitNote();

        if (note != null && isOppNote && cachedOppStrum != null) {
            var opp = cachedOppStrum;

            if (cachedMode == "Hidden Notes") {
                note.x = -5000;
                note.alpha = 0;
                note.visible = false;
                
                if (note.holdNoteSprite != null) {
                    note.holdNoteSprite.x = -5000;
                    note.holdNoteSprite.alpha = 0;
                    note.holdNoteSprite.visible = false;
                }
                return;
            }

            var receptors = opp.strumlineNotes.members;
            if (receptors == null || note.direction < 0 || note.direction >= receptors.length) return;
            
            var targetReceptor = receptors[note.direction];
            
            if (cachedMode == "P Style") {
                if (targetReceptor != null) {
                    note.x = targetReceptor.x + (targetReceptor.width * 0.5) - (note.width * 0.5);
                    
                    if (note.holdNoteSprite != null) {
                        note.holdNoteSprite.x = targetReceptor.x + (targetReceptor.width * 0.5) - (note.holdNoteSprite.width * 0.5);
                        note.holdNoteSprite.alpha = 0.6;
                    }
                }
                note.alpha = 0.6;
                return;
            } 
            else if (cachedMode == "Glass") {
                if (note.alpha != 0.25) note.alpha = 0.25;
                if (note.color != 0xFF666666) note.color = 0xFF666666;
                
                if (note.holdNoteSprite != null) {
                    note.holdNoteSprite.alpha = 0.25;
                    note.holdNoteSprite.color = 0xFF666666;
                }
                return;
            }
            
            if (cachedMode == "On" || applyArrowLogic) {
                var pixel:Bool = false;
                if (note.antialiasing == false) pixel = true;
                else pixel = cachedIsPixelStyle;
                var targetScale:Float = 1.0;
                
                if (cachedMode == "On") {
                    var sizeRatio:Float = 0.65;
                    var defaultScale:Float = pixel ? 6.0 : 0.7;
                    targetScale = defaultScale * sizeRatio;
                } else {
                    var noteScaleMul:Float = pixel ? 6.0 : 0.8;
                    targetScale = opp.strumlineScale.x * noteScaleMul;
                }
                
                if (note.scale.x != targetScale || note.scale.y != targetScale) {
                    note.scale.set(targetScale, targetScale);
                    note.updateHitbox();
                    
                    if (applyArrowLogic && cachedMode != "On") {
                        note.offset.y -= pixel ? 4 : 15;
                    }
                }
                note.alpha = 1.0;

                if (targetReceptor != null) {
                    var receptorW = targetReceptor.frameWidth * targetReceptor.scale.x;
                    var nw:Float = note.width > 0 ? note.width : receptorW;
                    
                    note.x = targetReceptor.x + (targetReceptor.width * 0.5) - (nw * 0.5);
                    
                    if (note.holdNoteSprite != null) {
                        var holdNote = note.holdNoteSprite;
                        holdNote.flipY = false;

                        var holdWidthMul:Float = pixel ? 0.15 : 1.05;
                        var holdScale:Float = targetScale * holdWidthMul;
                        
                        holdNote.graphicWidth = holdNote.graphicWidth * holdScale;
                        
                        holdNote.x = targetReceptor.x + (targetReceptor.width * 0.5) - (holdNote.graphicWidth * 0.5);
                        holdNote.updateClipping();
                        holdNote.alpha = 0.8;
                    }
                }
            }
        }
    }

    override function onUpdate(event:UpdateScriptEvent) {
        
        var applyArrowLogic = cachedIsArrows && cachedMobileOppNotes;
        var isModActive = (cachedMode == "On" || cachedMode == "P Style" || cachedMode == "Glass" || cachedMode == "Hidden Notes");

        
        var state = PlayState.instance;
        if (state == null) return;
        
        var myStrum = state.playerStrumline;
        var oppStrum = cachedOppStrum;

        var isMob:Bool = FlxG.onMobile;
        if (apiModule != null && apiModule.isMobileMode == true) isMob = true;
        
        var cutoutSize:Float = 0.0;
        if (isMob) {
            try { cutoutSize = funkin.ui.FullScreenScaleMode.gameNotchSize.x; } catch(e:Dynamic) {}
            if (cutoutSize <= 0) { try { cutoutSize = funkin.ui.FullScreenScaleMode.gameCutoutSize.x; } catch(e:Dynamic) {} }
            if (cutoutSize < 85.0) cutoutSize = 85.0;
        } else {
            try { cutoutSize = funkin.ui.FullScreenScaleMode.gameNotchSize.x; } catch(e:Dynamic) {}
            if (cutoutSize <= 0) { try { cutoutSize = funkin.ui.FullScreenScaleMode.gameCutoutSize.x; } catch(e:Dynamic) {} }
        }

        var showTimeBar:Bool = false;
        var timeBarPos:String = "Bottom";
        if (apiModule != null) {
            showTimeBar = apiModule.getKssValue("kssette_show_timebar") == true;
            timeBarPos = Std.string(apiModule.getKssValue("kssette_timebar_pos"));
        }

        var marginLeft:Float = Constants.STRUMLINE_X_OFFSET + cutoutSize;
        var marginRight:Float = Constants.STRUMLINE_X_OFFSET + cutoutSize;

        if (showTimeBar) {
            if (timeBarPos == "Vertical Left") marginLeft += 22;
            if (timeBarPos == "Vertical Right") marginRight += 22;
        }

        var padding:Float = 12;
        if (myStrum != null && myStrum.background != null && myStrum.background.visible) {
            var pNotes = myStrum.strumlineNotes.members;
            if (pNotes != null && pNotes.length > 0) {
                var minX = Math.POSITIVE_INFINITY;
                for (note in pNotes) if (note != null && note.exists && note.x < minX) minX = note.x;
                if (minX != Math.POSITIVE_INFINITY)
                    myStrum.background.x = minX - padding;
            }
        }

        if (oppStrum != null && oppStrum.background != null && oppStrum.background.visible) {
            var oNotes = oppStrum.strumlineNotes.members;
            if (oNotes != null && oNotes.length > 0) {
                var minX = Math.POSITIVE_INFINITY;
                for (note in oNotes) if (note != null && note.exists && note.x < minX) minX = note.x;
                if (minX != Math.POSITIVE_INFINITY)
                    oppStrum.background.x = minX - padding;
            }
        }

        if (!isModActive) {
            if (!pHasShifted && myStrum != null && oppStrum != null) {
                var gSide = "NORMAL";
                if (apiModule != null) {
                    try { gSide = apiModule.gammodPlayerSide; } catch(e:Dynamic) {}
                }

                if (gSide == "OPPOSITE") {
                    if (applyArrowLogic && !cachedIsMobPC) {
                    } else {
                        myStrum.x = marginLeft;
                        oppStrum.x = FlxG.width - oppStrum.width - marginRight;
                    }
                } else if (gSide == "BOTH") {
                    if (applyArrowLogic && !cachedIsMobPC) {
                        oppStrum.visible = false;
                    } else {
                        myStrum.x = (FlxG.width / 2) - (myStrum.width / 2);
                        oppStrum.visible = false;
                    }
                } else {
                    if (!(applyArrowLogic && !cachedIsMobPC)) {
                        oppStrum.x = marginLeft;
                    }
                }
                pHasShifted = true;
                hasShifted = true;
            }
            
            if (applyArrowLogic && !cachedIsMobPC && oppStrum != null) {
                var gSide = "NORMAL";
                if (apiModule != null) {
                    try { gSide = apiModule.gammodPlayerSide; } catch(e:Dynamic) {}
                }
                
                var oppRealWidth:Float = oppStrum.width;
                var oNotes = oppStrum.strumlineNotes.members;
                if (oNotes != null && oNotes.length > 0 && oNotes[0] != null && oNotes[oNotes.length - 1] != null) {
                    oppRealWidth = (oNotes[oNotes.length - 1].x + oNotes[oNotes.length - 1].width) - oNotes[0].x;
                }
                if (oppRealWidth <= 0) oppRealWidth = 300; 

                var safeLeft:Float = marginLeft;
                var safeRight:Float = FlxG.width - oppRealWidth - marginRight;

                if (gSide == "OPPOSITE") {
                    oppStrum.x = safeRight;
                } else {
                    oppStrum.x = safeLeft;
                }
            }
            
            if (!applyArrowLogic) return;
        }

        if (myStrum != null && isModActive && !pHasShifted) {
            var pRealWidth:Float = 448;
            var pStartX:Float = myStrum.x;
            var pNotes = myStrum.strumlineNotes.members;
            if (pNotes != null && pNotes.length > 0) {
                var firstNote = pNotes[0];
                var lastNote = pNotes[pNotes.length - 1];
                pRealWidth = (lastNote.x + lastNote.width) - firstNote.x;
                pStartX = firstNote.x;
            }
            if (pRealWidth <= 0) pRealWidth = myStrum.width;
            if (pRealWidth <= 0) pRealWidth = 448;
            
            var centeredX:Float = (FlxG.width - pRealWidth) * 0.5;
            var shift:Float = centeredX - pStartX;
            if (Math.abs(shift) > 0.1) {
                myStrum.x += shift;
                if (myStrum.background != null) myStrum.background.x = centeredX - padding;
            }
            if (cachedMode == "Glass" && cachedOppStrum != null) cachedOppStrum.x = myStrum.x;
            pHasShifted = true;
        }

        if (cachedOppStrum != null && isModActive && !hasShifted) {
            var oppStrum = cachedOppStrum;
            var receptors = oppStrum.strumlineNotes.members;
            
            if (cachedMode == "Hidden Notes") {
                oppStrum.x = -5000;
                if (receptors != null) {
                    for (receptor in receptors) {
                        if (receptor != null) receptor.x = -5000;
                    }
                }
                hasShifted = true;
            }
            else if (cachedMode == "P Style" && receptors != null && receptors.length >= 4) {
                oppStrum.x = 0;
                
                var targetLeftX:Float = marginLeft;
                var targetRightX:Float = FlxG.width - marginRight - receptors[3].width;

                receptors[0].x = targetLeftX;
                receptors[1].x = targetLeftX + Strumline.NOTE_SPACING;
                receptors[3].x = targetRightX;
                receptors[2].x = targetRightX - Strumline.NOTE_SPACING;
                
                for (receptor in receptors) {
                    if (receptor != null) receptor.alpha = 0.6;
                }
                hasShifted = true;
            } 
            else if (cachedMode == "On" && receptors != null && receptors.length > 0) {
                oppStrum.x = 0;
                oppStrum.strumlineScale.set(0.65, 0.65);

                var sizeRatio:Float = 0.65;
                var targetSpacing:Float = Strumline.NOTE_SPACING * sizeRatio;

                for (receptor in receptors) {
                    if (receptor != null) {
                        var pixel:Bool = false;
                        if (receptor.antialiasing == false) pixel = true;
                        else pixel = cachedIsPixelStyle;
                        var defaultScale:Float = pixel ? 6.0 : 0.7;
                        receptor.scale.set(defaultScale * sizeRatio, defaultScale * sizeRatio);
                        receptor.updateHitbox();
                        receptor.alpha = 1.0; 
                    }
                }

                var compactStartX:Float = marginLeft;

                if (cachedOppPos == "Right") {
                    var exactTotalWidth:Float = (targetSpacing * (receptors.length - 1)) + receptors[receptors.length - 1].width;
                    compactStartX = FlxG.width - marginRight - exactTotalWidth;
                }

                for (i in 0...receptors.length) {
                    if (receptors[i] != null) {
                        receptors[i].x = compactStartX + (targetSpacing * i);
                        receptors[i].updateHitbox();
                    }
                }
                
                hasShifted = true;
            }
        }

        if (cachedOppStrum == null) return;

        splashUpdateTimer += event.elapsed;
        if (splashUpdateTimer >= 0.033) {
            splashUpdateTimer = 0.0;
            var splashes = cachedSplashes;
            if (splashes != null && splashes.members != null) {
                
                var receptors = cachedReceptors;
                var hasOffsets:Bool = cachedHasSplashOffsets;
                var offX:Float = cachedSplashOffsetX;
                
                for (splash in splashes.members) {
                    if (splash != null && splash.alive && splash.visible && splash.alpha > 0 && splash.animation != null && splash.animation.name != null) {
                        var animName = splash.animation.name;
                        var dir:Int = -1;
                        
                        if (animName.indexOf("LEFT") != -1) dir = 0;
                        else if (animName.indexOf("DOWN") != -1) dir = 1;
                        else if (animName.indexOf("UP") != -1) dir = 2;
                        else if (animName.indexOf("RIGHT") != -1) dir = 3;

                        if (dir != -1 && receptors != null && dir < receptors.length) {
                            var receptor = receptors[dir];
                            if (receptor != null) {
                                var expectedX:Float = receptor.x + (receptor.width * 0.5) - (splash.width * 0.5);
                                if (hasOffsets) expectedX += offX * splash.scale.x;

                                if (Math.abs(splash.x - expectedX) > 0.1 || splash.scale.x != receptor.scale.x || splash.scale.y != receptor.scale.y) {
                                    splash.scale.set(receptor.scale.x, receptor.scale.y);
                                    splash.updateHitbox();

                                    var targetX:Float = receptor.x + (receptor.width * 0.5) - (splash.width * 0.5);
                                    if (hasOffsets) targetX += offX * splash.scale.x;

                                    splash.x = targetX;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}