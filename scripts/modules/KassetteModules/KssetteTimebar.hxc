package kassettehud.util;

/**
 * KssetteTimeBar
 *
 * Renderiza una barra de progreso de la canción durante el juego. La barra crece
 * del 0% al 100% a medida que avanza la canción y puede posicionarse en varios
 * lugares de la pantalla.
 *
 * Modos de diseño (kssette_timebar_pos):
 *   - "Top" / "Bottom": Barras de borde de ancho completo (usan una cámara dedicada).
 *   - "Top Left/Right": Mini barras compactas en una esquina.
 *   - "Bottom Left/Right": Mini barras compactas en una esquina.
 *   - "Vertical Left/Right": Barras laterales de altura completa.
 *   - "In Health": Barra delgada posicionada debajo/encima de la barra de vida.
 *
 * Para las posiciones de borde (Top/Bottom/Vertical), se crea una FlxCamera
 * separada para que la barra se renderice por encima de todos los elementos del
 * juego, incluido el subestado de pausa.
 *
 * Ajustes que maneja:
 *   - kssette_show_timebar: "On" | "Off"
 *   - kssette_timebar_pos:  see Layout modes above
 *
 * Dependencies:
 *   - KssetteApi.getKssValue()  - reads option values
 *   - KssetteApi.getDownscroll() - determines health bar Y for "In Health" mode
 */

import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.FlxCamera;
import Std;
import Reflect;
import funkin.Preferences;
import funkin.modding.events.SubStateScriptEvent;
import funkin.play.PauseSubState;
import funkin.ui.FullScreenScaleMode;

class KssetteTimeBar extends Module {
    /** La barra de primer plano coloreada que representa el progreso de la canción. */
    public var timeBar:FlxSprite;
    /** El fondo oscuro detrás de la barra de primer plano. */
    public var timeBarBG:FlxSprite;
    /** Altura/grosor de la barra en píxeles (primer plano). */
    var barSize:Float = 11;
    /** Indica si la barra de tiempo está actualmente visible y activa. */
    var cachedActive:Bool = false;
    /** String del ajuste de posición actual (p. ej., "Top", "Bottom Left"). */
    var timeBarPos:String = "Bottom";
    /** Referencia cacheada al módulo KssetteApi. */
    var apiModule:Dynamic = null;

    /** Referencia a PlayState para consultas de posición de la canción. */
    var playState:PlayState = null;
    /** Duración total de la canción en milisegundos; se usa para calcular la proporción de progreso. */
    var songLengthMs:Float = 0.0;
    /** Temporizador para que la barra solo se actualice a ~120fps en lugar de cada frame. */
    var updateTimer:Float = 0.0;
    /** Cámara dedicada para las barras en modo borde (renderiza sobre todas las capas del HUD). */
    var customCam:FlxCamera = null;

    /** Se establece en verdadero durante la vista previa del menú de opciones para usar una cámara personalizada en lugar de camHUD. */
    public var isPreview:Bool = false;
    /** Cámara para renderizar en el modo de vista previa. */
    public var previewCam:FlxCamera = null;

    public function new() {
        super("KssetteTimeBar");
    }

    /**
     * Utilidad: devuelve verdadero si un valor dinámico representa un estado "activado".
     * Acepta `true` booleano, "On", "on", o "true" como valores verdaderos.
     */
    function isOn(val:Dynamic):Bool {
        if (val == true) return true;
        var s = Std.string(val);
        return s == "On" || s == "on" || s == "true";
    }

    /** Devuelve la cámara del HUD de la instancia de PlayState dada. */
    function hudCamera(state:PlayState):FlxCamera {
        return state.camHUD;
    }

    /**
     * Crea un único sprite de barra (FlxSprite) y lo añade al estado apropiado.
     *
     * @param y Posición vertical en el espacio de la pantalla.
     * @param h Altura en píxeles.
     * @param color  Fill color (ARGB).
     * @param z      Z-index for draw order sorting.
     * @param cam    Camera to assign the sprite to.
     */
    function makeBar(y:Float, h:Int, color:Int, z:Int, cam:FlxCamera):FlxSprite {
        var bar = new FlxSprite(0, y).makeGraphic(FlxG.width, h, color);
        bar.origin.set(0, 0);
        bar.scrollFactor.set(0, 0);
        bar.zIndex = z;
        bar.cameras = [cam];
        if (PlayState.instance != null && !isPreview) PlayState.instance.add(bar);
        else FlxG.state.add(bar);
        return bar;
    }

    /**
     * Destruye los sprites de barra y la cámara existentes, reseteando todo el estado.
     * Se llama antes de reconstruir la UI (p. ej., al inicio de la canción o al cambiar de posición).
     */
    public function cleanupUI() {
        playState = null;
        songLengthMs = 0.0;
        updateTimer = 0.0;
        if (timeBar != null) {
            if (PlayState.instance != null && !isPreview) PlayState.instance.remove(timeBar, true);
            FlxG.state.remove(timeBar, true);
            timeBar.destroy();
        }
        if (timeBarBG != null) {
            if (PlayState.instance != null && !isPreview) PlayState.instance.remove(timeBarBG, true);
            FlxG.state.remove(timeBarBG, true);
            timeBarBG.destroy();
        }
        if (customCam != null) {
            FlxG.cameras.remove(customCam);
            customCam.destroy();
            customCam = null;
        }
        timeBar = null;
        timeBarBG = null;
    }

    /**
     * Crea los sprites de la barra de fondo y de primer plano y los añade a la escena.
     * Para las posiciones de borde (Top/Bottom/Vertical), se crea una FlxCamera dedicada
     * para que la barra se dibuje por encima de todos los demás elementos del HUD, incluido el menú de pausa.
     *
     * @param cam La cámara base del HUD a usar para posiciones que no son de borde.
     */
    public function setupUI(cam:FlxCamera) {
        cleanupUI();

        var isBorder:Bool = (timeBarPos == "Top" || timeBarPos == "Bottom" || timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
        var targetCam:FlxCamera = cam;

        if (isBorder && !isPreview) {
            if (customCam == null) {
                customCam = new FlxCamera();
                customCam.bgColor = 0x00000000;
                FlxG.cameras.add(customCam, false);
            }
            targetCam = customCam;
        }

        var zIdx:Int = isBorder ? 1018 : (timeBarPos == "In Health" ? 109 : 15);

        timeBarBG = makeBar(0, Std.int(barSize + 4), 0xFF000000, zIdx, targetCam);
        timeBar = makeBar(2, Std.int(barSize), 0xFFFFFFFF, zIdx + 1, targetCam);
        FlxG.state.refresh();
    }

    /**
     * Recalcula y aplica la posición de ambos sprites de la barra basándose en
     * el ajuste actual de `timeBarPos`. Maneja todas las variantes de diseño, incluyendo
     * mini esquinas, vertical, alineación con la barra de vida y desplazamientos por el notch en móviles.
     */
    public function updatePositions() {
        if (timeBarBG == null || timeBar == null) return;

        var isVertical:Bool = (timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
        var isInHealth:Bool = (timeBarPos == "In Health");
        var isMini:Bool = (timeBarPos == "Bottom Left" || timeBarPos == "Bottom Right" || timeBarPos == "Top Left" || timeBarPos == "Top Right");

        var currentBgW:Int = isVertical ? Std.int(barSize + 4) : (isMini ? 360 : (isInHealth ? 360 : FlxG.width));
        var currentBgH:Int = isVertical ? FlxG.height : Std.int(barSize + 4);
        var currentBarW:Int = isVertical ? Std.int(barSize) : currentBgW;
        var currentBarH:Int = isVertical ? currentBgH : Std.int(barSize);

        if (Std.int(timeBarBG.width) != currentBgW || Std.int(timeBarBG.height) != currentBgH) {
            timeBarBG.makeGraphic(currentBgW, currentBgH, 0xFF000000);
            timeBar.makeGraphic(currentBarW, currentBarH, 0xFFFFFFFF);
        }

        timeBarBG.origin.set(0, 0);
        timeBar.origin.set(0, isVertical ? currentBarH : 0);

        var cachedX:Float = 0;
        var cachedY:Float = 0;
        var paddingX:Float = 0;
        var paddingY:Float = 20;

        var cutoutSize:Float = 0.0;
        var isMob:Bool = FlxG.onMobile;
        if (apiModule != null && apiModule.isMobileMode == true) isMob = true;

        if (isMob) {
            cutoutSize = FullScreenScaleMode.gameNotchSize.x;
            if (cutoutSize <= 0) {
                cutoutSize = FullScreenScaleMode.gameCutoutSize.x;
            }
            if (cutoutSize < 60.0) cutoutSize = 60.0; // Anti-Notch
        }

        switch (timeBarPos) {
            case "Top":
                cachedX = (FlxG.width - currentBgW) / 2;
            case "Top Left":
                cachedX = paddingX + cutoutSize; cachedY = paddingY;
            case "Top Right":
                cachedX = FlxG.width - currentBgW - paddingX - cutoutSize; cachedY = paddingY;
            case "Bottom Left":
                cachedX = paddingX + cutoutSize; cachedY = FlxG.height - currentBgH - paddingY;
            case "Bottom Right":
                cachedX = FlxG.width - currentBgW - paddingX - cutoutSize; cachedY = FlxG.height - currentBgH - paddingY;
            case "Vertical Left":
                cachedX = paddingX + cutoutSize; cachedY = 0;
            case "Vertical Right":
                cachedX = FlxG.width - currentBgW - paddingX - cutoutSize; cachedY = 0;
            case "In Health":
                var hbX:Float = (FlxG.width - currentBgW) / 2;
                var downscrollValue:Bool = Preferences.downscroll;
                if (apiModule != null && apiModule.getDownscroll != null) downscrollValue = apiModule.getDownscroll();
                var hbY:Float = downscrollValue ? FlxG.height * 0.11 : FlxG.height * 0.89;
                var hbH:Float = 19;
                if (playState != null && playState.healthBarBG != null) {
                    hbX = playState.healthBarBG.x + (playState.healthBarBG.width - currentBgW) / 2;
                    hbY = playState.healthBarBG.y;
                    hbH = playState.healthBarBG.height;
                }
                cachedX = hbX;
                cachedY = downscrollValue ? hbY + hbH : hbY - currentBgH;
            default:
                cachedX = (FlxG.width - currentBgW) / 2;
                cachedY = FlxG.height - currentBgH;
        }

        timeBarBG.x = cachedX;
        timeBarBG.y = cachedY;
        
        if (isVertical) {
            timeBar.x = cachedX + 2;
            timeBar.y = cachedY;
        } else {
            timeBar.x = cachedX;
            timeBar.y = cachedY + 2;
        }
    }

    /**
     * Punto de entrada para el sistema de vista previa del menú de opciones.
     * Configura la barra en modo de vista previa (no requiere PlayState) y
     * renderiza inmediatamente los ajustes de posición/visibilidad actuales.
     *
     * @param cam Cámara en la que se renderizará la vista previa.
     */
    public function buildPreview(cam:FlxCamera) {
        isPreview = true;
        previewCam = cam;
        setupUI(cam);
        updatePreview();
    }

    /**
     * Refresca la barra de vista previa para reflejar los ajustes actuales.
     * Vuelve a leer la posición y el estado activo desde KssetteApi y actualiza
     * la visibilidad y la escala para mostrar un ejemplo de progreso del 50%.
     */
    public function updatePreview() {
        if (!isPreview) return;

        apiModule = ModuleHandler.getModule("KssetteApi");
        if (apiModule != null) {
            cachedActive = isOn(apiModule.getKssValue("kssette_show_timebar"));
            timeBarPos = Std.string(apiModule.getKssValue("kssette_timebar_pos"));
        }

        updatePositions();

        if (timeBarBG != null) timeBarBG.visible = cachedActive;
        if (timeBar != null) {
            timeBar.visible = cachedActive;
            var isVertical:Bool = (timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
            if (isVertical) {
                timeBar.scale.y = 0.5;
                timeBar.scale.x = 1.0;
            } else {
                timeBar.scale.x = 0.5;
                timeBar.scale.y = 1.0;
            }
        }
    }

    /**
     * Se llama al inicio de la canción. Lee los ajustes, construye la UI de la barra e
     * inicializa el progreso a 0. Resetea el modo de vista previa si está activo.
     */
    override public function onCountdownStart(event) {
        super.onCountdownStart(event);
        isPreview = false;

        apiModule = ModuleHandler.getModule("KssetteApi");
        if (apiModule == null) return;
        
        apiModule.registerModule("KssetteTimeBar", this);
        cachedActive = isOn(apiModule?.getKssValue("kssette_show_timebar"));
        timeBarPos = Std.string(apiModule?.getKssValue("kssette_timebar_pos"));

        trace("[KssetteTimeBar] onCountdownStart - active=" + cachedActive + " pos=" + timeBarPos);

        var state = PlayState.instance;
        playState = null;
        songLengthMs = 0.0;
        updateTimer = 0.0;
        if (state != null && state.camHUD != null) {
            setupUI(hudCamera(state));
            playState = state;
            songLengthMs = state.currentSongLengthMs;
            updatePositions();

            if (timeBarBG != null) timeBarBG.visible = cachedActive;
            if (timeBar != null) {
                timeBar.visible = cachedActive;
                var isVertical:Bool = (timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
                if (isVertical) { timeBar.scale.y = 0; timeBar.scale.x = 1.0; }
                else            { timeBar.scale.x = 0; timeBar.scale.y = 1.0; }
            }
        }
    }

    /**
     * Oculta la barra cuando se abre el subestado de pausa (solo en modo borde).
     * Las barras de borde usan una cámara separada que de otro modo permanecería visible
     * sobre la superposición de pausa.
     */
    override public function onSubStateOpenBegin(event:SubStateScriptEvent) {
        super.onSubStateOpenBegin(event);
        if (event.targetState != null && Std.isOfType(event.targetState, PauseSubState)) {
            var isBorder:Bool = (timeBarPos == "Top" || timeBarPos == "Bottom" || timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
            if (isBorder) {
                if (timeBarBG != null) timeBarBG.visible = false;
                if (timeBar != null) timeBar.visible = false;
            }
        }
    }

    /** Restaura la visibilidad de la barra cuando se cierra el subestado de pausa (solo en modo borde). */
    override public function onSubStateCloseEnd(event:SubStateScriptEvent) {
        super.onSubStateCloseEnd(event);
        if (event.targetState != null && Std.isOfType(event.targetState, PauseSubState)) {
            var isBorder:Bool = (timeBarPos == "Top" || timeBarPos == "Bottom" || timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
            if (isBorder) {
                if (timeBarBG != null) timeBarBG.visible = cachedActive;
                if (timeBar != null) timeBar.visible = cachedActive;
            }
        }
    }

    /**
     * Actualización por frame. Calcula el progreso de la canción como una proporción de la
     * posición del conductor respecto a la duración total de la canción, y luego lo aplica a la escala de la barra.
     *
     * Limitado a ~120Hz (0.008s) para evitar la regeneración del sprite en cada frame.
     * También refleja la visibilidad de camHUD en la cámara dedicada para los bordes.
     */
    override public function onUpdate(event) {
        if (isPreview) return;

        // Refleja la visibilidad de la cámara del HUD en la cámara de borde.
        if (customCam != null && playState?.camHUD != null) {
            if (customCam.visible != playState.camHUD.visible) customCam.visible = playState.camHUD.visible;
            if (customCam.alpha   != playState.camHUD.alpha)   customCam.alpha   = playState.camHUD.alpha;
        }

        if (!cachedActive || timeBar == null || !timeBar.exists || playState == null || playState.conductorInUse == null) return;

        // Intenta leer la duración de la canción si no estaba disponible al inicio de la cuenta atrás.
        if (songLengthMs <= 0) {
            songLengthMs = playState.currentSongLengthMs;
            if (songLengthMs <= 0) return;
        }

        updateTimer += event.elapsed;
        if (updateTimer < 0.008) return;
        updateTimer = 0.0;

        var progress:Float = playState.conductorInUse.songPosition / songLengthMs;
        if (progress < 0) progress = 0;
        else if (progress > 1) progress = 1;

        // Aplica el progreso al eje apropiado según la orientación.
        var isVertical:Bool = (timeBarPos == "Vertical Left" || timeBarPos == "Vertical Right");
        if (isVertical) { timeBar.scale.y = progress; timeBar.scale.x = 1.0; }
        else            { timeBar.scale.x = progress; timeBar.scale.y = 1.0; }
    }
}
