package kassettehud.util;

/**
 * KssetteBreakBar - Barra de pausa/descanso en el gameplay
 *
 * Propósito:
 *   Muestra una barra de progreso cuando hay una pausa larga en el mapa
 *   (más de 2.5 segundos sin notas del jugador), indicando cuánto tiempo
 *   falta para la próxima nota. Disponible en varios estilos visuales.
 *
 * Opciones que maneja:
 *   - kssette_show_breakbar: "On" | "Off"
 *   - kssette_breakbar_style: "Default" | "Classic" | "Pie"
 *   - kssette_breakbar_pos: "Center" | "Strumline"
 *
 * Dependencias:
 *   - KssetteApi (getBreakData() para saber si hay un break activo)
 *   - playerNoteTimes en KssetteApi (se parsea al inicio de cada canción)
 */

import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import flixel.FlxG;
import flixel.FlxSprite;
import funkin.Paths;
import Math;
import Std;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.math.FlxPoint;
import flixel.math.FlxRect;
import flixel.util.FlxSpriteUtil;

class KssetteBreakBar extends Module {
    /** Desplazamiento horizontal para los estilos 'Default' y 'Pie'. */
    var offsetX:Float = 12;
    /** Desplazamiento vertical para los estilos 'Default' y 'Pie'. */
    var offsetY:Float = 0;
    
    /** Desplazamiento horizontal del ícono en el estilo 'Default'. */
    var iconOffsetX:Float = 10;
    /** Desplazamiento vertical del ícono en el estilo 'Default'. */
    var iconOffsetY:Float = -7;

    /** Sprite del borde para los estilos 'Default' y 'Pie'. */
    var border:FlxSprite;
    /** Sprite del ícono de descanso para los estilos 'Default' y 'Pie'. */
    var breakIcon:FlxSprite;
    
    /** Array de sprites para los bordes del estilo 'Classic'. */
    var borders:Array<FlxSprite> = [];
    /** Texto "BREAK" para el estilo 'Classic'. */
    var breakText:FlxText;

    /** Sprite de relleno que indica el progreso del descanso. */
    var barFill:FlxSprite;
    /** Ancho base de la barra. */
    var barWidth:Float = 260;
    /** Alto base de la barra. */
    var barHeight:Float = 20;
    /** Valor alfa objetivo para las animaciones de aparición/desaparición. */
    var alphaTarget:Float = 0;
    /** Valor alfa actual, interpolado hacia `alphaTarget`. */
    var currentAlpha:Float = 0;
    /** Referencia cacheada al módulo KssetteApi. */
    var apiModule:Dynamic = null;
    /** Bandera cacheada que indica si la barra de descanso está activa. */
    var cachedActive:Bool = false;
    /** Rectángulo de recorte para el sprite de relleno en el estilo 'Default'. */
    var fillClip:flixel.math.FlxRect = null;
    /** Último ancho de relleno aplicado para evitar actualizaciones redundantes. */
    var lastFillW:Int = -1;
    /** Temporizador para limitar la frecuencia de actualización por frame. */
    var updateTimer:Float = 0.0;
    /** Fuente de texto cacheada para la UI. */
    var cachedFont:String = "VCR OSD Mono";
    /** Estilo actual de la barra ('Default', 'Classic', 'Pie'). */
    var currentStyle:String = "Default";
    /** Posición actual de la barra ('Center', 'Strumline'). */
    var currentPos:String = "Center";
    
    /** Tiempos de las notas del jugador cacheados para calcular los descansos. */
    var cachedNoteTimes:Array<Dynamic> = [];
    /** Índice de la próxima nota a procesar en `cachedNoteTimes`. */
    var localNoteIndex:Int = 0;

    /** Verdadero cuando se renderiza una vista previa en el menú de opciones. */
    public var isPreview:Bool = false;
    /** Cámara para renderizar en el modo de vista previa. */
    public var previewCam:flixel.FlxCamera = null;
    /** Temporizador para simular un descanso en el modo de vista previa. */
    var previewBreakTimer:Float = 0.0;
    
    public function new() {
        super("KssetteBreakBar");
    }

    /**
     * Limpia y destruye todos los elementos de la UI creados por este módulo.
     */
    public function cleanupUI() {
        if (border != null) border.destroy();
        if (barFill != null) barFill.destroy();
        if (breakIcon != null) breakIcon.destroy();
        if (breakText != null) breakText.destroy();
        if (borders != null) {
            for (b in borders) {
                if (b != null) b.destroy();
            }
        }
        border = null;
        barFill = null;
        breakIcon = null;
        breakText = null;
        borders = [];
        fillClip = null;
        lastFillW = -1;
    }

    /**
     * Se llama cuando el estado del juego cambia. Limpia la UI.
     */
    override public function onStateChangeStart(event) {
        super.onStateChangeStart(event);
        isPreview = false;
        cleanupUI();
    }

    /**
     * Dibuja un rectángulo con bordes redondeados en un sprite.
     * @param sprite El FlxSprite en el que se dibujará.
     * @param w Ancho del rectángulo.
     * @param h Alto del rectángulo.
     * @param rad Radio de las esquinas.
     * @param color Color del rectángulo.
     * @param hollow Si es verdadero, dibuja solo el borde.
     * @param thick Grosor del borde si es hueco.
     */
    function drawRoundedRect(sprite:FlxSprite, w:Int, h:Int, rad:Int, color:Int, hollow:Bool = false, thick:Int = 2) {
        sprite.makeGraphic(w, h, 0x00000000);
        var b = sprite.graphic.bitmap;
        var rSq = rad * rad;
        for (y in 0...h) {
            for (x in 0...w) {
                var inside = true;
                var dx = 0.0; var dy = 0.0;
                if (x < rad && y < rad) { dx = rad - x - 0.5; dy = rad - y - 0.5; }
                else if (x >= w - rad && y < rad) { dx = x - (w - rad) + 0.5; dy = rad - y - 0.5; }
                else if (x < rad && y >= h - rad) { dx = rad - x - 0.5; dy = y - (h - rad) + 0.5; }
                else if (x >= w - rad && y >= h - rad) { dx = x - (w - rad) + 0.5; dy = y - (h - rad) + 0.5; }
                if ((dx * dx) + (dy * dy) > rSq) inside = false;
                if (inside) b.setPixel32(x, y, color);
            }
        }
        
        if (hollow) {
            var innerW = w - (thick * 2);
            var innerH = h - (thick * 2);
            var innerRad = rad - thick;
            if (innerRad < 0) innerRad = 0;
            var innerRSq = innerRad * innerRad;
            
            for (y in 0...innerH) {
                for (x in 0...innerW) {
                    var inside = true;
                    if (innerRad > 0) {
                        var dx = 0.0; var dy = 0.0;
                        if (x < innerRad && y < innerRad) { dx = innerRad - x - 0.5; dy = innerRad - y - 0.5; }
                        else if (x >= innerW - innerRad && y < innerRad) { dx = x - (innerW - innerRad) + 0.5; dy = innerRad - y - 0.5; }
                        else if (x < innerRad && y >= innerH - innerRad) { dx = innerRad - x - 0.5; dy = y - (innerH - innerRad) + 0.5; }
                        else if (x >= innerW - innerRad && y >= innerH - innerRad) { dx = x - (innerW - innerRad) + 0.5; dy = y - (innerH - innerRad) + 0.5; }
                        if ((dx * dx) + (dy * dy) > innerRSq) inside = false;
                    }
                    if (inside) b.setPixel32(x + thick, y + thick, 0x00000000);
                }
            }
        }
    }

    /**
     * Configura e inicializa todos los elementos de la UI para la barra de descanso.
     * @param cam La cámara del HUD a la que se adjuntarán los elementos.
     */
    public function setupUI(cam:flixel.FlxCamera) {
        cleanupUI();

        if (apiModule != null) {
            cachedFont = apiModule.getHudFont();
            if (cachedFont == null || cachedFont == "null" || cachedFont == "") cachedFont = "VCR OSD Mono";
            var rawStyle = apiModule.getKssValue("kssette_breakbar_style");
            if (rawStyle == "Classic") currentStyle = "Classic";
            else if (rawStyle == "Pie") currentStyle = "Pie";
            else currentStyle = "Default";
            var rawPos = apiModule.getKssValue("kssette_breakbar_pos");
            currentPos = (rawPos == "Strumline") ? "Strumline" : "Center";
        }

        var state = PlayState.instance;

        var centerY = (FlxG.height / 2) - 60;
        var centerX = (FlxG.width / 2);
        if (currentStyle == "Default" || currentStyle == "Pie") {
            centerY += offsetY;
            centerX += offsetX;
        }

        if (currentPos == "Strumline") {
            if (isPreview) {
                var previewMod = ModuleHandler.getModule("KssetteHUDPreview");
                if (previewMod != null && previewMod.playerStrumPreview != null) {
                    var sX = previewMod.playerStrumPreview.x;
                    var sW = previewMod.playerStrumPreview.width;
                    if (sW == 0) sW = 448;
                    centerX = sX + (sW / 2);
                }
            } else if (state != null && state.playerStrumline != null) {
                var sW = state.playerStrumline.width;
                if (sW == 0) sW = 448;
                centerX = state.playerStrumline.x + (sW / 2);
            }
        }

        var startX = centerX - (barWidth / 2);

        if (currentStyle == "Classic") {
            var thick = 4;
            
            var bTop = new FlxSprite(startX, centerY).makeGraphic(Std.int(barWidth), thick, 0xFFFFFFFF);
            var bBot = new FlxSprite(startX, centerY + barHeight - thick).makeGraphic(Std.int(barWidth), thick, 0xFFFFFFFF);
            var bLeft = new FlxSprite(startX, centerY + thick).makeGraphic(thick, Std.int(barHeight - thick * 2), 0xFFFFFFFF);
            var bRight = new FlxSprite(startX + barWidth - thick, centerY + thick).makeGraphic(thick, Std.int(barHeight - thick * 2), 0xFFFFFFFF);
            
            borders = [bTop, bBot, bLeft, bRight];
            for (b in borders) {
                b.scrollFactor.set(0, 0);
                b.zIndex = 1010;
                b.alpha = 0;
                b.cameras = [cam];
                if (state != null && !isPreview) state.add(b);
                else FlxG.state.add(b);
            }
            
            barFill = new FlxSprite(startX + thick, centerY + thick).makeGraphic(Std.int(barWidth - thick * 2), Std.int(barHeight - thick * 2), 0xFFFFFFFF);
            barFill.scrollFactor.set(0, 0);
            barFill.zIndex = 1011;
            barFill.origin.set(0, 0);
            barFill.alpha = 0;
            barFill.cameras = [cam];
            if (state != null && !isPreview) state.add(barFill);
            else FlxG.state.add(barFill);

            breakText = new FlxText(startX, centerY - 28, barWidth, "BREAK", 20);
            breakText.setFormat(cachedFont, 20, 0xFFFFFFFF, "center", FlxTextBorderStyle.OUTLINE, 0xFF000000);
            breakText.scrollFactor.set(0, 0);
            breakText.zIndex = 1012;
            breakText.alpha = 0;
            breakText.cameras = [cam];
            if (state != null && !isPreview) state.add(breakText);
            else FlxG.state.add(breakText);

        } else if (currentStyle == "Pie") {
            var radius = 45;
            var cX = centerX - radius;
            var cY = centerY - radius;
            
            border = new FlxSprite(cX, cY);
            drawRoundedRect(border, radius*2, radius*2, radius, 0xFFFFFFFF, true, 3);
            border.scrollFactor.set(0, 0);
            border.zIndex = 1010;
            border.alpha = 0;
            border.cameras = [cam];
            if (state != null && !isPreview) state.add(border);
            else FlxG.state.add(border);
            
            barFill = new FlxSprite(cX + 3, cY + 3);
            barFill.makeGraphic(radius*2 - 6, radius*2 - 6, 0x00000000);
            barFill.scrollFactor.set(0, 0);
            barFill.zIndex = 1011;
            barFill.origin.set(0, 0);
            barFill.alpha = 0;
            barFill.cameras = [cam];
            lastFillW = -1;
            lastPieDegree = -1;
            if (state != null && !isPreview) state.add(barFill);
            else FlxG.state.add(barFill);
            
            breakIcon = new FlxSprite(0, 0);
            try {
                var iconImg = Paths.image("ui/hud/break");
                if (iconImg != null) {
                    breakIcon.loadGraphic(iconImg);
                } else {
                    breakIcon.makeGraphic(30, 30, 0xFFFFFFFF);
                }
            } catch(e:Dynamic) {
                breakIcon.makeGraphic(30, 30, 0xFFFFFFFF);
            }
            if (breakIcon.graphic != null) {
                var sRatio = 40 / breakIcon.graphic.width;
                breakIcon.scale.set(sRatio, sRatio);
                breakIcon.updateHitbox();
            }
            breakIcon.x = centerX - (breakIcon.width / 2);
            breakIcon.y = centerY - (breakIcon.height / 2);
            breakIcon.scrollFactor.set(0, 0);
            breakIcon.zIndex = 1012;
            breakIcon.alpha = 0;
            breakIcon.cameras = [cam];
            if (state != null && !isPreview) state.add(breakIcon);
            else FlxG.state.add(breakIcon);

        } else {
            border = new FlxSprite(startX, centerY);
            drawRoundedRect(border, Std.int(barWidth), Std.int(barHeight), 5, 0xFFFFFFFF, true, 3);
            border.scrollFactor.set(0, 0);
            border.zIndex = 1010;
            border.alpha = 0;
            border.cameras = [cam];
            if (state != null && !isPreview) state.add(border);
            else FlxG.state.add(border);
            
            barFill = new FlxSprite(startX + 5, centerY + 5);
            drawRoundedRect(barFill, Std.int(barWidth - 10), Std.int(barHeight - 10), 2, 0xFF999999, false, 0);
            barFill.scrollFactor.set(0, 0);
            barFill.zIndex = 1011;
            barFill.origin.set(0, 0);
            barFill.alpha = 0;
            barFill.cameras = [cam];
            fillClip = new flixel.math.FlxRect(0, 0, barWidth - 10, barHeight - 10);
            barFill.clipRect = fillClip;
            lastFillW = -1;
            if (state != null && !isPreview) state.add(barFill);
            else FlxG.state.add(barFill);

            breakIcon = new FlxSprite(0, 0);
            try {
                var iconImg = Paths.image("ui/hud/break");
                if (iconImg != null) {
                    breakIcon.loadGraphic(iconImg);
                } else {
                    breakIcon.makeGraphic(30, 30, 0xFFFFFFFF);
                }
            } catch(e:Dynamic) {
                breakIcon.makeGraphic(30, 30, 0xFFFFFFFF);
            }
            
            if (breakIcon.graphic != null) {
                var sRatio = 35 / breakIcon.graphic.width;
                breakIcon.scale.set(sRatio, sRatio);
                breakIcon.updateHitbox();
            }

            breakIcon.x = startX - breakIcon.width - 15 + iconOffsetX; 
            breakIcon.y = centerY + (barHeight - breakIcon.height) / 2 + iconOffsetY;
            
            breakIcon.scrollFactor.set(0, 0);
            breakIcon.zIndex = 1012;
            breakIcon.alpha = 0;
            breakIcon.cameras = [cam];
            if (state != null && !isPreview) state.add(breakIcon);
            else FlxG.state.add(breakIcon);
        }

        currentAlpha = 0;
        alphaTarget = 0;
    }

    /**
     * Establece el ancho del sprite de relleno para la barra de estilo 'Default'.
     * @param fillW El nuevo ancho en píxeles.
     */
    function setFillWidth(fillW:Int):Void {
        if (barFill == null || !barFill.exists) return;
        if (currentStyle == "Classic" || currentStyle == "Pie") return; 
        if (fillW < 1) fillW = 1;
        if (fillW == lastFillW) return;
        lastFillW = fillW;
        if (fillClip == null) {
            fillClip = new FlxRect(0, 0, fillW, barHeight - 10);
        } else {
            fillClip.width = fillW;
        }
        barFill.clipRect = fillClip;
    }

    /** Último grado aplicado al relleno del estilo 'Pie'. */
    var lastPieDegree:Int = -1;

    /**
     * Dibuja y actualiza el relleno del estilo 'Pie' según el progreso.
     * @param prog El progreso del descanso (0.0 a 1.0).
     */
    function setPieFill(prog:Float):Void {
        if (barFill == null || !barFill.exists) return;
        if (currentStyle != "Pie") return;
        
        var degree = Std.int(prog * 360);
        if (degree == lastPieDegree) return;
        lastPieDegree = degree;
        
        FlxSpriteUtil.fill(barFill, 0x00000000);
        if (prog <= 0) return;
        
        var radius = 42; 
        var thickness = 10;
        var innerRadius = radius - thickness;
        var cX = radius;
        var cY = radius;

        var vertices:Array<Dynamic> = [];
        
        var startAngle = -90; 
        var endAngle = -90 + degree;
        
        var step = 10;
        var angle = startAngle;
        while (angle < endAngle) {
            var rad = angle * Math.PI / 180;
            vertices.push(FlxPoint.get(cX + Math.cos(rad) * radius, cY + Math.sin(rad) * radius));
            angle += step;
        }
        var radEnd = endAngle * Math.PI / 180;
        vertices.push(FlxPoint.get(cX + Math.cos(radEnd) * radius, cY + Math.sin(radEnd) * radius));
        
        angle = endAngle;
        while (angle > startAngle) {
            var rad = angle * Math.PI / 180;
            vertices.push(FlxPoint.get(cX + Math.cos(rad) * innerRadius, cY + Math.sin(rad) * innerRadius));
            angle -= step;
        }
        var radStart = startAngle * Math.PI / 180;
        vertices.push(FlxPoint.get(cX + Math.cos(radStart) * innerRadius, cY + Math.sin(radStart) * innerRadius));
        
        if (vertices.length >= 3) {
            FlxSpriteUtil.drawPolygon(barFill, vertices, 0xFF999999);
        }
    }
    
    /**
     * Se llama al inicio de la cuenta atrás de la canción. Inicializa y cachea los valores necesarios.
     */
    override public function onCountdownStart(event) {
        super.onCountdownStart(event);
        
        var state = PlayState.instance;
        if (state == null) return;
        
        apiModule = ModuleHandler.getModule("KssetteApi");
        if (apiModule == null) return;

        apiModule.registerModule("KssetteBreakBar", this);
        cachedActive = apiModule.getKssValue("kssette_show_breakbar") == true;
        cachedNoteTimes = apiModule.playerNoteTimes;
        
        localNoteIndex = 0;
        updateTimer = 0.0;
        isPreview = false;

        if (state.camHUD != null) {
            setupUI(state.camHUD);
        }
    }

    /**
     * Construye la UI para la vista previa del menú de opciones.
     * @param cam La cámara de la vista previa.
     */
    public function buildPreview(cam:flixel.FlxCamera) {
        isPreview = true;
        previewCam = cam;
        
        apiModule = ModuleHandler.getModule("KssetteApi");
        if (apiModule == null) return;

        setupUI(cam);
        previewBreakTimer = 6.0;
        updatePreview();
    }

    /**
     * Actualiza la vista previa en el menú de opciones para reflejar los cambios de configuración.
     */
    public function updatePreview() {
        if (!isPreview) return;
        if (currentStyle == "Classic") {
            if (breakText == null || !breakText.exists) return;
        } else {
            if (breakIcon == null || !breakIcon.exists) return;
        }

        apiModule = ModuleHandler.getModule("KssetteApi");
        if (apiModule == null) return;
        
        cachedActive = apiModule.getKssValue("kssette_show_breakbar") == true;
        var rawStyle = apiModule.getKssValue("kssette_breakbar_style");
        var newStyle = "Default";
        if (rawStyle == "Classic") newStyle = "Classic";
        else if (rawStyle == "Pie") newStyle = "Pie";
        var rawPos = apiModule.getKssValue("kssette_breakbar_pos");
        var newPos = (rawPos == "Strumline") ? "Strumline" : "Center";
        
        if (currentStyle != newStyle || currentPos != newPos) {
            setupUI(previewCam);
        }
    }
    
    /**
     * Se llama en cada frame. Gestiona la lógica de progreso y la visibilidad de la barra.
     */
    override public function onUpdate(event) {
        if (barFill == null || !barFill.exists) {
            alphaTarget = 0;
            return;
        }
        if (currentStyle == "Default" && (breakIcon == null || !breakIcon.exists)) {
            alphaTarget = 0;
            return;
        }
        if (currentStyle == "Classic" && (breakText == null || !breakText.exists)) {
            alphaTarget = 0;
            return;
        }
        if (currentStyle == "Pie" && (breakIcon == null || !breakIcon.exists)) {
            alphaTarget = 0;
            return;
        }

        var elapsed = event.elapsed;
        updateTimer += elapsed;
        if (updateTimer < 0.008) return;
        elapsed = updateTimer;
        updateTimer = 0.0;

        var breakProgress:Float = 0.0;

        if (isPreview) {
            alphaTarget = 0;
            if (cachedActive && apiModule != null) {
                var isP:Bool = true;
                var prog:Float = 0.0;
                
                var tempIsP = Reflect.field(apiModule, "preview_playerTurn");
                if (tempIsP != null) isP = tempIsP;

                var tempProg = Reflect.field(apiModule, "preview_turnProgress");
                if (tempProg != null) prog = tempProg;
                if (!isP) {
                    alphaTarget = 1;
                    breakProgress = 1.0 - prog;
                    if (currentStyle == "Default") setFillWidth(Std.int((barWidth - 10) * breakProgress));
                    if (currentStyle == "Pie") setPieFill(breakProgress);
                }
            }
        } else if (cachedActive) {
            var state = PlayState.instance;
            if (state != null && state.conductorInUse != null) {
                if (cachedNoteTimes != null && cachedNoteTimes.length > 0) {
                    var currentTime = state.conductorInUse.songPosition;
                    var noteIndex:Int = localNoteIndex;

                    while (noteIndex < cachedNoteTimes.length && cachedNoteTimes[noteIndex].start <= currentTime) {
                        noteIndex++;
                    }
                    
                    localNoteIndex = noteIndex;

                    if (noteIndex < cachedNoteTimes.length) {
                        var nextTime:Float = cachedNoteTimes[noteIndex].start;
                        var prevTime:Float = 0;
                        if (noteIndex > 0) prevTime = cachedNoteTimes[noteIndex - 1].end;
                        
                        var gap = nextTime - prevTime;
                        if (gap >= 2500) {
                            var timeSincePrev = currentTime - prevTime;
                            var timeUntilNext = nextTime - currentTime;

                            if (timeSincePrev > 400 && timeUntilNext > 400) {
                                var totalVisibleTime = gap - 800; 
                                var currentVisibleTime = timeSincePrev - 400;
                                var prog = 1.0 - (currentVisibleTime / totalVisibleTime);
                                if (prog < 0) prog = 0;
                                if (prog > 1) prog = 1;
                                alphaTarget = 1;
                                breakProgress = 1.0 - prog;
                                if (currentStyle == "Default") setFillWidth(Std.int((barWidth - 10) * prog));
                                if (currentStyle == "Pie") setPieFill(prog);
                            } else {
                                alphaTarget = 0;
                            }
                        } else {
                            alphaTarget = 0;
                        }
                    } else {
                        alphaTarget = 0;
                    }
                } else {
                    alphaTarget = 0;
                }
            } else {
                alphaTarget = 0;
            }
        } else {
            alphaTarget = 0;
        }
        
        if (currentStyle == "Classic" && alphaTarget > 0) {
            var prog = 1.0 - breakProgress;
            if (prog < 0) prog = 0;
            if (prog > 1) prog = 1;
            barFill.scale.x = prog;
        }

        if (currentPos == "Strumline" && alphaTarget > 0) {
            var targetCenterX:Float = -1;
            if (isPreview) {
                var previewMod = ModuleHandler.getModule("KssetteHUDPreview");
                if (previewMod != null && previewMod.playerStrumPreview != null) {
                    var sW = previewMod.playerStrumPreview.width;
                    if (sW == 0) sW = 448;
                    targetCenterX = previewMod.playerStrumPreview.x + (sW / 2);
                }
            } else {
                var state = PlayState.instance;
                if (state != null && state.playerStrumline != null) {
                    var sW = state.playerStrumline.width;
                    if (sW == 0) sW = 448;
                    targetCenterX = state.playerStrumline.x + (sW / 2);
                }
            }
            if (targetCenterX != -1) {
                if (currentStyle == "Default" || currentStyle == "Pie") targetCenterX += offsetX;
                if (currentStyle == "Classic") {
                    var newStartX = targetCenterX - (barWidth / 2);
                    var thick = 4;
                    if (borders != null && borders.length == 4) {
                        borders[0].x = newStartX; borders[1].x = newStartX;
                        borders[2].x = newStartX; borders[3].x = newStartX + barWidth - thick;
                    }
                    if (barFill != null) barFill.x = newStartX + thick;
                    if (breakText != null) breakText.x = newStartX;
                } else if (currentStyle == "Pie") {
                    var radius = 45;
                    var cX = targetCenterX - radius;
                    if (border != null) border.x = cX;
                    if (barFill != null) barFill.x = cX + 3;
                    if (breakIcon != null) breakIcon.x = targetCenterX - (breakIcon.width / 2);
                } else {
                    var newStartX = targetCenterX - (barWidth / 2);
                    if (border != null) border.x = newStartX;
                    if (barFill != null) barFill.x = newStartX + 5;
                    if (breakIcon != null) breakIcon.x = newStartX - breakIcon.width - 15 + iconOffsetX;
                }
            }
        }

        if (currentAlpha == 0 && alphaTarget == 0) return;

        currentAlpha += (alphaTarget - currentAlpha) * (elapsed * 10);
        if (Math.abs(alphaTarget - currentAlpha) < 0.01) currentAlpha = alphaTarget;
        
        if (currentStyle == "Classic") {
            var borderAlpha = currentAlpha * 0.6;
            if (borders != null && borders.length == 4) {
                borders[0].alpha = borderAlpha;
                borders[1].alpha = borderAlpha;
                borders[2].alpha = borderAlpha;
                borders[3].alpha = borderAlpha;
            }
            if (barFill != null && barFill.exists) barFill.alpha = currentAlpha * 0.4;
            if (breakText != null && breakText.exists) breakText.alpha = currentAlpha * 0.8;
        } else if (currentStyle == "Pie") {
            if (border != null && border.exists) border.alpha = currentAlpha * 0.5;
            if (barFill != null && barFill.exists) barFill.alpha = currentAlpha * 0.5;
            if (breakIcon != null && breakIcon.exists) breakIcon.alpha = currentAlpha * 0.5;
        } else {
            if (border != null && border.exists) border.alpha = currentAlpha * 0.5;
            if (barFill != null && barFill.exists) barFill.alpha = currentAlpha * 0.5;
            if (breakIcon != null && breakIcon.exists) breakIcon.alpha = currentAlpha * 0.5;
        }
    }
}
