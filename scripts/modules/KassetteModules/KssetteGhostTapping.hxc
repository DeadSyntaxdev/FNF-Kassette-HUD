package kassettehud.util;

import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import flixel.FlxG;
import Std;
import Reflect;

class KssGhostTapping extends Module {
    var _cGhostTappingMode:String = "Off";
    var _cGhostSing:Bool = false;
    var isPaused:Bool = false;

    public function new() {
        super('KssGhostTapping', 1);
    }

    override public function onCountdownStart(event:Dynamic) {
        super.onCountdownStart(event);
        isPaused = false;

        var api = ModuleHandler.getModule("KssetteApi");
        if (api == null) return;

        try {
            var gtVal = api.getKssValue("kssette_ghost_tapping");
            _cGhostTappingMode = Std.string(gtVal);
            if (gtVal == true) _cGhostTappingMode = "On";
            if (gtVal == false) _cGhostTappingMode = "Off";
            
            var gsVal = api.getKssValue("kssette_ghost_sing");
            _cGhostSing = (gsVal == true || gsVal == "On");
        } catch(e:Dynamic) {
            _cGhostTappingMode = "Off";
            _cGhostSing = false;
        }
    }

    override function onPause(event:Dynamic) {
        super.onPause(event);
        isPaused = true;
    }

    override function onStateChangeEnd(event:Dynamic) {
        super.onStateChangeEnd(event);
        isPaused = false;
    }

    override function onResume(event:Dynamic) {
        super.onResume(event);
        isPaused = false;
    }

    function isGammodActive():Bool {
        var api = ModuleHandler.getModule("KssetteApi");
        var isActive = false;
        if (api != null) {
            isActive = (api.isGammodMode == true);
        }
        
        return isActive;
    }

    function canGhostTap():Bool {
        if (isGammodActive()) return false;
        if (_cGhostTappingMode == "On") return true;
        
        if (_cGhostTappingMode == "In Breaks") {
            var api:Dynamic = ModuleHandler.getModule("KssetteApi");
            if (api != null) {
                try {
                    var breakData = api.getBreakData();
                    if (breakData != null && breakData.active == true) {
                        return true;
                    }
                } catch(e:Dynamic) {}
            }
        }
        return false;
    }

    override function onGhostMissNote(event:Dynamic) {
        if (!canGhostTap()) return;
        event.cancel();
    }

    override function onNoteGhostMiss(event:Dynamic) {
        if (!canGhostTap()) return;
        event.cancel();
    }

    override public function onUpdate(event:Dynamic) {
        super.onUpdate(event);

        if (!_cGhostSing) return;

        var state = PlayState.instance;
        if (state == null || state.isPlayerDying || isPaused) return;

        var controlsObj:Dynamic = null;
        controlsObj = Reflect.getProperty(FlxG.state, "controls");

        if (controlsObj == null) {
            controlsObj = state.controls;
        }
        if (controlsObj == null) return;

        var isOpposite = false;
        var api:Dynamic = ModuleHandler.getModule("KssetteApi");
        if (api != null && api.gammodPlayerSide == "OPPOSITE") {
            isOpposite = true;
        }
        
        var player = state.currentStage != null ? (isOpposite ? state.currentStage.getDad() : state.currentStage.getBoyfriend()) : null;
        if (player == null) return;

        var hitLeft = false;
        var hitDown = false;
        var hitUp = false;
        var hitRight = false;

        hitLeft = controlsObj.NOTE_LEFT_P;
        hitDown = controlsObj.NOTE_DOWN_P;
        hitUp = controlsObj.NOTE_UP_P;
        hitRight = controlsObj.NOTE_RIGHT_P;

        if (hitLeft) {
            player.playAnimation("singLEFT", true, false, false);
            player.holdTimer = 0;
        }
        if (hitDown) {
            player.playAnimation("singDOWN", true, false, false);
            player.holdTimer = 0;
        }
        if (hitUp) {
            player.playAnimation("singUP", true, false, false);
            player.holdTimer = 0;
        }
        if (hitRight) {
            player.playAnimation("singRIGHT", true, false, false);
            player.holdTimer = 0;
        }
    }
}
