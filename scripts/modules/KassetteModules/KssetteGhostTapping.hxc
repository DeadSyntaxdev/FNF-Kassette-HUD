package kassettehud.util;

import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import funkin.save.Save;
import Std;

class KssGhostTapping extends Module {
    var _cGhostTapping:Bool = false;
    var _cGhostSing:Bool = false;
    var isPaused:Bool = false;
    var cachedState:PlayState = null;
    var cachedPlayer:Dynamic = null;

    public function new() {
        super('KssGhostTapping', 1); 
    }

    function clearCache() {
        cachedState = null;
        cachedPlayer = null;
    }

    function isOn(val:Dynamic):Bool {
        if (val == true) return true;
        var s = Std.string(val);
        return s == "On" || s == "on" || s == "true";
    }

    function readToggle(api:Dynamic, key:String):Bool {
        try { if (api != null) return isOn(api.getKssValue(key)); } catch(e:Dynamic) {}
        try { return isOn(Save.instance.modOptions.get(key)); } catch(e:Dynamic) {}
        return false;
    }

    override public function onCountdownStart(event:Dynamic) {
        super.onCountdownStart(event);
        isPaused = false;
        cachedState = PlayState.instance;
        cachedPlayer = null;
        
        var api = ModuleHandler.getModule("KssetteApi");
        _cGhostTapping = readToggle(api, "kssette_ghost_tapping");
        _cGhostSing = readToggle(api, "kssette_ghost_sing");

        if (cachedState != null) {
            if (cachedState.currentStage != null) cachedPlayer = cachedState.currentStage.getBoyfriend();
        }
    }

    override function onPause(event:Dynamic) {
        super.onPause(event);
        isPaused = true;
    }

    override function onStateChangeEnd(event:Dynamic) {
        super.onStateChangeEnd(event);
        isPaused = false;
        clearCache();
    }

    override function onResume(event:Dynamic) {
        super.onResume(event);
        isPaused = false;
    }

    function playGhostSing(event:Dynamic) {
        var state = cachedState;
        if (state == null) {
            state = PlayState.instance;
            cachedState = state;
        }
        if (state == null || state.isPlayerDying || isPaused) return;

        var player = cachedPlayer;
        if (player == null && state.currentStage != null) {
            player = state.currentStage.getBoyfriend();
            cachedPlayer = player;
        }
        if (player == null) return;

        var dir:Int = -1;
        try { dir = Std.int(event.dir); } catch(e:Dynamic) {}
        var anim:String = null;
        if (dir == 0) anim = "singLEFT";
        else if (dir == 1) anim = "singDOWN";
        else if (dir == 2) anim = "singUP";
        else if (dir == 3) anim = "singRIGHT";
        if (anim == null) return;

        try {
            player.playAnimation(anim, true, false, false);
            player.holdTimer = 0;
        } catch(e:Dynamic) {}
    }

    function handleGhostMiss(event:Dynamic) {
        if (_cGhostSing) {
            playGhostSing(event);
            try { event.playAnim = false; } catch(e:Dynamic) {}
        }
        if (_cGhostTapping) try { event.cancel(); } catch(e:Dynamic) {}
    }

    override function onGhostMissNote(event:Dynamic) {
        handleGhostMiss(event);
    }

    override function onNoteGhostMiss(event:Dynamic) {
        handleGhostMiss(event);
    }
}
