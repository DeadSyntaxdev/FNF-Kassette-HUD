import funkin.ui.ScriptedMusicBeatSubState;

class KssetteCapsulesSubState extends ScriptedMusicBeatSubState {
    public var parent:Dynamic;
    public var subOptions:Dynamic;
    
    var largeCapsulePath:String = "ui/capsules/DescCapsule";
    var menuFont:String = "VCR OSD Mono";
    var smallCapsuleAsset:Dynamic = null;
    var largeCapsuleAsset:Dynamic = null;
    var screenW:Float = 0;
    var screenH:Float = 0;
    var halfScreenH:Float = 0;
    var visibleStart:Int = -1;
    var visibleEnd:Int = -1;
    var lastVisibleStart:Int = -1;
    var lastVisibleEnd:Int = -1;
    var lastSelectionIndex:Int = -1;
    var largeCapsuleWidth:Float = 800.0;
    var descMaxHeight:Float = 95.0; 
    var descTextMaxWidth:Float = 450.0;
    var descOffsetX:Float = 45.0;
    var descOffsetY:Float = 20.0; 
    var descValueMaxWidth:Float = 140.0;
    var descValueOffsetX:Float = 100.0; 
    var descValueOffsetY:Float = 25.0; 

    var smallCapsulePath:String = "ui/capsules/OptionCapsule";
    var smallCapsuleWidth:Float = 620.0;  
    var capsuleSpacing:Float = 120.0;     
    var labelOffsetX:Float = 80.0;
    var labelOffsetY:Float = 25.0; 
    var labelMaxWidth:Float = 320.0; 
    var valueOffsetX:Float = 105.0; 
    var valueOffsetY:Float = 25.0; 
    var valueMaxWidth:Float = 150.0; 

    var apiRef:Dynamic; 
    var panelWidth:Int = 660; 
    var optionCam:FlxCamera;
    var hudCam:FlxCamera;
    var stageCam:FunkinCamera;
    var capsuleFadeBg:FlxSprite;
    var marqueeBg:FlxSprite;
    var marqueeText1:FlxText;
    var marqueeText2:FlxText;
    var marqueeString:String;
    var marqueeSpeed:Float = 80;
    var marqueeOffset:Float = 0;
    public var descBg:FlxSprite;
    public var descTextDisplay:FlxText;
    public var descValueText:FlxText;
    public var descSlideVerticalTimer:Float = 0.0;
    public var descValueSlideTimer:Float = 0.0;
    public var optionItems:Array<Dynamic> = [];
    public var selectedIndex:Int = 0;
    var curSelectedFloat:Float = 0;
    
    public var isFontMenuOpen:Bool = false;
    public var isTimeMenuOpen:Bool = false;
    public var isOpMenuOpen:Bool = false;
    public var isVolMenuOpen:Bool = false;

    var holdTimer:Float = 0;
    public var panelHidden:Bool = false;
    var panelOnLeft:Bool = false;
    var transitioningSide:Bool = false;
    var transitionTimer:Float = 0.0;
    var nextPanelOnLeft:Bool = false;
    var exiting:Bool = false;
    var uiX:Float = 0;
    var kssBackButton:FunkinBackButton;
    var previewHitbox:FlxSprite;
    var touchStart:Float = 0;
    var touchStartX:Float = 0;
    var isDragging:Bool = false;
    var dragOffsetY:Float = 0.0;
    var lastTouchY:Float = 0;
    var touchVelocityY:Float = 0;
    var previewHoldTimer:Float = 0.0;
    var previewActionFired:Bool = false;
    var itemsGroup:FlxSpriteGroup;

    var sndScroll:Dynamic;
    var sndOn:Dynamic;
    var sndOff:Dynamic;
    var sndCancel:Dynamic;
    var sndHit:Dynamic;

    var scrollTracker:FlxSprite;
    var scrollTween:FlxTween;

    public function new(parent:Dynamic) {
        super();
        this.parent = parent;
        this.persistentUpdate = true;
        this.persistentDraw = true;
    }

    public function initSubstate():Void {
        scrollTracker = new FlxSprite(0, 0);

        sndScroll = Paths.sound('ui/khud_scroll');
        sndOn = Paths.sound('ui/khud_on');
        sndOff = Paths.sound('ui/khud_off');
        sndCancel = Paths.sound('cancelMenu');
        sndHit = Paths.sound("play/hitsound");
        Paths.sound('confirmMenu'); 

        screenW = FlxG.width;
        screenH = FlxG.height;
        halfScreenH = screenH * 0.5;
        menuFont = Paths.font("5by7.ttf");
        smallCapsuleAsset = Paths.image(smallCapsulePath);
        largeCapsuleAsset = Paths.image(largeCapsulePath);

        apiRef = ModuleHandler.getModule("KssetteApi");
        
        optionCam = FlxG.cameras.list[FlxG.cameras.list.length - 1];
        hudCam = FlxG.cameras.list[FlxG.cameras.list.length - 2];
        stageCam = FlxG.camera;
        panelOnLeft = false;
        
        // CRITICAL: SubStates inherit cameras from parent, so if optionCam isn't in this list, 
        // children assigned to optionCam won't be drawn!
        this.cameras = [stageCam, hudCam, optionCam];

        uiX = screenW - panelWidth;
        buildSidePanel();

        changeSelection(0);
        updatePreviews();
    }

    function exitMenu() {
        if (exiting) return;
        exiting = true;
        Save.instance.flush();
        FlxG.camera.fade(FlxColor.BLACK, 0.4, false, function() {
            FlxG.cameras.reset(new FlxCamera());
            FlxG.switchState(new OptionsState());
            
            FunkinSound.playMusic('freakyMenu', {
                startingVolume: 1.0,
                overrideExisting: true,
                restartTrack: true,
                persist: true
            });
        });
    }

    public function updatePreviews() {
        if (KassetteHUDElement.globalOptionsManager != null) {
            KassetteHUDElement.globalOptionsManager.refreshOptionCache();
        }

        var scorePos = Save.instance.modOptions.get("kssette_score_pos");
        if (scorePos == null) scorePos = "Vanilla";
        var isDownscroll = Preferences.downscroll;
        if (KassetteHUDElement.globalOptionsManager != null && KassetteHUDElement.globalOptionsManager.isForcedDownscroll()) isDownscroll = true;
        
        var newInfoLabel = "";
        if (isDownscroll) {
            if (scorePos == "Inverted") newInfoLabel = "Above Health Bar";
            else newInfoLabel = "Below Score";
        } else {
            if (scorePos == "Inverted") newInfoLabel = "Below Health Bar";
            else newInfoLabel = "Above Arrows";
        }

        for (item in optionItems) {
            if (item != null && item.key == "kssette_info_pos") {
                if (item.options != null && item.options.length > 0) {
                    var oldLabel = item.options[0];
                    if (oldLabel != newInfoLabel) {
                        item.options[0] = newInfoLabel;
                        if (item.currentIndex == 0) {
                            Save.instance.modOptions.set("kssette_info_pos", newInfoLabel);
                            if (item.textDisplay != null) {
                                item.textDisplay.text = formatShortValue(newInfoLabel);
                                var tColor = getValueColor(item.textDisplay.text);
                                if (item.textDisplay.color != tColor) item.textDisplay.color = tColor;
                                if (item.textDisplay.width > valueMaxWidth) {
                                    item.textDisplay.x = item.bg.x + item.bg.width - item.valOffX - valueMaxWidth;
                                } else {
                                    item.textDisplay.x = item.bg.x + item.bg.width - item.valOffX - item.textDisplay.width;
                                }
                            }
                            if (descValueText != null && selectedIndex >= 0 && selectedIndex < optionItems.length && optionItems[selectedIndex] == item) {
                                descValueText.text = formatLongValue(newInfoLabel);
                                var vColor = getValueColor(descValueText.text);
                                if (descValueText.color != vColor) descValueText.color = vColor;
                            }
                        }
                    }
                }
            }
            
            if (item != null && item.key == "kssette_mobile_keyboard") {
                var curVal = Save.instance.modOptions.get("kssette_mobile_keyboard");
                var displayVal = Std.string(curVal);
                if (curVal == true) displayVal = "On";
                else if (curVal == false) displayVal = "Off";
                
                if (item.options != null) {
                    var idx = item.options.indexOf(displayVal);
                    if (idx != -1) item.currentIndex = idx;
                }
                
                if (item.textDisplay != null) {
                    item.textDisplay.text = formatShortValue(displayVal);
                    var tColor = getValueColor(item.textDisplay.text);
                    if (item.textDisplay.color != tColor) item.textDisplay.color = tColor;
                    if (item.textDisplay.width > valueMaxWidth) {
                        item.textDisplay.x = item.bg.x + item.bg.width - item.valOffX - valueMaxWidth;
                    } else {
                        item.textDisplay.x = item.bg.x + item.bg.width - item.valOffX - item.textDisplay.width;
                    }
                }
                if (descValueText != null && selectedIndex >= 0 && selectedIndex < optionItems.length && optionItems[selectedIndex] == item) {
                    descValueText.text = formatLongValue(displayVal);
                    var vColor = getValueColor(descValueText.text);
                    if (descValueText.color != vColor) descValueText.color = vColor;
                }
            }
        }
    }

    public function getValueColor(val:String):Int {
        if (val == null) return 0xFFFFFFFF;
        if (val.indexOf(":") != -1) return 0xFF00CCFF;
        var upper = StringTools.trim(val).toUpperCase();
        if (upper == "ON" || upper == "ENABLED") return 0xFF00FF00;
        if (upper == "OFF" || upper == "DISABLED") return 0xFFFF0000;
        if (upper == "P S" || upper == "P STYLE" || upper == "GLA" || upper == "GLASS" || StringTools.contains(upper, "LEFT") || StringTools.contains(upper, "RIGHT") || StringTools.contains(upper, "TOP") || StringTools.contains(upper, "BOT") || StringTools.contains(upper, "ABV") || StringTools.contains(upper, "BEL") || upper == "V L" || upper == "V R" || upper == "IN HEALTH" || upper == "HLT") return 0xFF00CCFF;
        if (upper == "CLA" || upper == "CLASSIC" || upper == "ASC" || upper == "ASCENDING") return 0xFFFFCC00;
        if (upper == "HID" || upper == "HIDDEN" || StringTools.contains(upper, "HIDDEN NOTES")) return 0xFF999999;
        if (upper == "VAN" || upper == "SLI" || upper == "FAD" || upper == "VER" || upper == "ZOO") return 0xFF9966FF;
        if (StringTools.contains(upper, "%")) return 0xFFFFFF00;
        if (upper == "ON NOTE HIT" || upper == "HIT" || upper == "NOT") return 0xFF00CCFF;
        if (upper == "ANYTIME" || upper == "ANY") return 0xFFFF00FF;
        return 0xFFFFFFFF;
    }

    public function formatShortValue(val:String):String {
        if (val == null) return "";
        if (val.indexOf(":") != -1 || val.indexOf("%") != -1) return val;
        var upper = val.toUpperCase();
        if (upper == "ON") return "ON ";
        if (upper == "OFF") return "OFF";
        if (upper == "P STYLE") return "P S";
        if (upper == "GLASS") return "GLA";
        if (upper == "HIDDEN NOTES") return "HID";
        if (upper == "CLASSIC") return "CLA";
        if (upper == "CLAP") return "CLP";
        if (upper == "ASCENDING") return "ASC";
        if (upper == "LEFT") return "LEF";
        if (upper == "RIGHT") return "RIG";
        if (upper == "TOP") return "TOP";
        if (upper == "BOTTOM") return "BOT";
        if (upper == "TOP LEFT") return "T L";
        if (upper == "TOP RIGHT") return "T R";
        if (upper == "BOTTOM LEFT") return "B L";
        if (upper == "BOTTOM RIGHT") return "B R";
        if (upper == "ABOVE ARROWS") return "ABV";
        if (upper == "BELOW SCORE") return "BEL";
        if (upper == "VERTICAL LEFT") return "V L";
        if (upper == "VERTICAL RIGHT") return "V R";
        if (upper == "IN HEALTH") return "HLT";
        if (upper == "ON NOTE HIT") return "HIT";
        if (upper == "ANYTIME") return "ANY";
        return upper.substr(0, 3);
    }

    public function formatLongValue(val:String):String {
        if (val == null) return "";
        if (val.indexOf(":") != -1 || val.indexOf("%") != -1) return val;
        var upper = val.toUpperCase();
        if (upper == "ON") return "ENABLED";
        if (upper == "OFF") return "DISABLED";
        if (upper == "P STYLE") return "P STYLE";
        if (upper == "GLASS") return "GLASS";
        if (upper == "HIDDEN NOTES") return "HIDDEN";
        if (upper == "IN HEALTH") return "IN HEALTH";
        return upper;
    }

    function buildSidePanel() {
        marqueeBg = new FlxSprite(0, 0).makeGraphic(Std.int(screenW), 45, 0xFF000000);
        marqueeBg.scrollFactor.set(0, 0);
        marqueeBg.alpha = 1.0;
        marqueeBg.cameras = [optionCam];

        var apiVer = "0.2";
        if (apiRef != null) apiVer = Std.string(apiRef.hudVersion);

        var mobileStr = "   OPTIONS MENU   SWIPE UP/DOWN TO SCROLL   SWIPE L/R TO MOVE UI   TAP AND HOLD THE STAGE TO PREVIEW   ";
        var pcStr = "   OPTIONS MENU   TAB TO HIDE OPTIONS   SHIFT TO MOVE OPTTIONS   ESC TO EXIT   ";
        marqueeString = " KASSETTE HUD V" + apiVer + (FlxG.onMobile ? mobileStr : pcStr);
        marqueeString = marqueeString + marqueeString + marqueeString + marqueeString + marqueeString + marqueeString + marqueeString + marqueeString;

        marqueeText1 = new FlxText(0, 6, 0, marqueeString, 32);
        marqueeText1.setFormat(menuFont, 32, FlxColor.YELLOW, "left");
        marqueeText1.antialiasing = false;
        marqueeText1.scrollFactor.set(0, 0);
        marqueeText1.cameras = [optionCam];

        marqueeText2 = new FlxText(0, 6, 0, marqueeString, 32);
        marqueeText2.setFormat(menuFont, 32, FlxColor.YELLOW, "left");
        marqueeText2.antialiasing = false;
        marqueeText2.scrollFactor.set(0, 0);
        marqueeText2.cameras = [optionCam];

        capsuleFadeBg = new FlxSprite(0, 0);
        capsuleFadeBg.makeGraphic(panelWidth, 1, 0x00000000);
        
        for (i in 0...panelWidth) {
            var ratio = i / panelWidth;
            var a = Std.int(0.8 * 255 * ratio); 
            var color = (a << 24) | 0x000000;
            capsuleFadeBg.graphic.bitmap.setPixel32(i, 0, color);
        }
        capsuleFadeBg.scale.y = screenH;
        capsuleFadeBg.updateHitbox();
        capsuleFadeBg.scrollFactor.set(0, 0);
        capsuleFadeBg.cameras = [optionCam];
        add(capsuleFadeBg);

        itemsGroup = new FlxSpriteGroup(0, 0);
        itemsGroup.cameras = [optionCam];
        add(itemsGroup);

        var isMobilePC = (Save.instance.modOptions.get("kssette_mobile_keyboard") == "On");
        if (Save.instance.mobileOptions != null && Save.instance.mobileOptions.controlsScheme != "Arrows") isMobilePC = true;
        var showPCOptions = !FlxG.onMobile || isMobilePC;

        addHeader("Gameplay & Modifiers");
        if (FlxG.onMobile) {
            createToggle("PC/HITBOX MODE", "kssette_mobile_keyboard", ["On", "Off"], "Enable if using a Hitbox or Keyboard on mobile. Unlocks PC settings.");
            createToggle("SHOW OPPONENT NOTES ON ARROWS", "kssette_mobile_opp_notes", ["On", "Off"], "Forces the opponent's notes to appear and scroll in the background during mobile Arrows gameplay.");
        }
        if (showPCOptions) {
            createToggle("MIDDLESCROLL", "kssette_middlescroll", ["Off", "On", "P Style", "Glass", "Hidden Notes", "Like Mobile"], "Moves your notes to the center of the screen for better focus.");
            createToggle("HIDE OPPONENT NOTES", "kssette_hide_opponent", ["Off", "On"], "Hides the opponent's notes completely. Only active when Middle Scroll is Off.");
            createOpacityOption("OPPONENT OPACITY", "kssette_opponent_opacity", "Adjust the transparency of the opponent's notes.");
            createToggle("OPP STRUMLINE BG", "kssette_opponent_bg", ["On", "Off"], "Show the dark background behind the opponent's notes. (Disabled on Middle Scroll)");
            createToggle("GHOSTTAPPING", "kssette_ghost_tapping", ["On", "Off", "In Breaks"], "Press keys anytime without penalty. You won't miss if there's no note.");
        }
        createToggle("GHOSTSING", "kssette_ghost_sing", ["On", "Off"], "Your character will play singing animations when you press empty keys.");
        createToggle("RESUME COUNTDOWN", "kssette_resume_countdown", ["On", "Off"], "Adds a 'Ready, Set, Go!' countdown when you unpause the game.");

        addHeader("HUD Elements");
        createToggle("SCORE DISPLAY", "kssette_show_score", ["On", "Off"], "Show your current score.");
        createToggle("MISSES DISPLAY", "kssette_show_misses", ["On", "Off"], "Show a counter for how many notes you've missed.");
        createToggle("RANK DISPLAY", "kssette_show_rank", ["On", "Off"], "Show your current Rank (P, E, G) based on performance.");
        createToggle("COMBO TIER DISPLAY", "kssette_show_tier", ["On", "Off"], "Show your Combo Status (SFC, GFC, FC, Clear).");
        createToggle("SONG TIME BAR", "kssette_show_timebar", ["On", "Off"], "Show a bar indicating progress.");
        createToggle("SONG TIME TEXT", "kssette_show_song_time", ["On", "Off"], "Show a digital timer counting down the song.");
        createToggle("BREAK BAR", "kssette_show_breakbar", ["On", "Off"], "Show a specific timer during long breaks in the song.");
        createToggle("BREAK BAR STYLE", "kssette_breakbar_style", ["Default", "Classic", "Pie"], "The visual style of the break bar.");
        createToggle("JUDGEMENT COUNTER", "kssette_judge_pos", ["Off", "Left", "Right", "Top Left", "Top Right"], "Shows a counter for Sicks, Goods, Bads, etc. Choose where to place it.");
        createToggle("SONG TITLE DISPLAY", "kssette_show_song_title", ["On", "Off"], "Show the name of the song on the HUD.");
        createToggle("DIFFICULTY DISPLAY", "kssette_show_song_diff", ["On", "Off"], "Show the difficulty level on the HUD.");
        createToggle("COLORED HEALTH BAR", "kssette_colored_healthbar", ["On", "Off"], "Changes the health bar colors to match the character icons.");
        createToggle("ACCURACY CALCULATION", "kssette_acc_mode", ["Classic", "Ascending", "Off"], "How accuracy is calculated. 'Ascending' starts at 0% and climbs up.");
        createToggle("SCORE BOP ANIMATION", "kssette_score_bop", ["Off", "On"], "Makes the score text bop when hitting notes.");

        addHeader("Audio Options");
        createToggle("HITSOUND MODE", "kssette_hitsound", ["Off", "On Note Hit", "Anytime"], "Plays a sound. On Note Hit triggers only when hitting notes, Anytime triggers on any tap.");
        createVolumeOption("HITSOUND VOLUME", "kssette_hitsound_volume", "Adjust the volume of the hitsound.");

        addHeader("Layout & Positions");
        if (showPCOptions) {
            createToggle("OPPONENT POS", "kssette_opponent_pos", ["Left", "Right"], "Where to put the opponent's notes when Middle Scroll is ON.");
        }
        createToggle("TIME BAR POSITION", "kssette_timebar_pos", ["Bottom", "Top", "Bottom Left", "Bottom Right", "Top Left", "Top Right", "Vertical Left", "Vertical Right", "In Health"], "Choose where the Song Progress Bar is placed on screen.");
        createToggle("BREAK BAR POSITION", "kssette_breakbar_pos", ["Center", "Strumline"], "Where to place the break bar.");
        createToggle("HEALTH ICON POSITIONS", "kssette_icon_pos", ["Default", "Corners"], "Choose where the character icons are placed on the health bar.");
        createToggle("SCORE TEXT POSITION", "kssette_score_pos", ["Vanilla", "Inverted"], "Choose where the score text is placed relative to the health bar.");
        
        var isDownscroll = Preferences.downscroll;
        if (KassetteHUDElement.globalOptionsManager != null && KassetteHUDElement.globalOptionsManager.isForcedDownscroll()) isDownscroll = true;

        var scorePosInit = Save.instance.modOptions.get("kssette_score_pos");
        if (scorePosInit == null) scorePosInit = "Vanilla";
        var infoLabel = "";
        if (isDownscroll) {
            if (scorePosInit == "Inverted") infoLabel = "Above Health Bar";
            else infoLabel = "Below Score";
        } else {
            if (scorePosInit == "Inverted") infoLabel = "Below Health Bar";
            else infoLabel = "Above Arrows";
        }
        createToggle("SONG INFO POSITION", "kssette_info_pos", [infoLabel, "Bottom Left"], "Where to show the Song Name and Difficulty.");

        addHeader("Visual Effects");
        createToggle("SMOOTH NUMBER ANIMATIONS", "kssette_smooth_display", ["On", "Off"], "Makes the score and accuracy numbers scroll smoothly.");
        createToggle("NIGHT MODE FILTER", "kssette_night_mode", ["Off", "On", "Auto"], "Dims the game screen to reduce eye strain.");
        createOpacityOption("NIGHT FILTER OPACITY", "kssette_night_opacity", "How dark the night mode filter should be."); 
        createTimeOption("NIGHT MODE AUTO START", "kssette_night_start", "When set to Auto, night mode activates at this start time."); 
        createTimeOption("NIGHT MODE AUTO END", "kssette_night_end", "When set to Auto, night mode turns off at this end time."); 
        createToggle("SONG INTRO TEXT", "kssette_intro_text", ["Classic", "Racer", "Clap", "Off"], "Displays the song title and artist when the song starts.");
        createToggle("SONG ALBUM COVER", "kssette_intro_album", ["On", "Off"], "Displays the song's album cover art alongside the intro text.");
        createToggle("INTRO TEXT POSITION", "kssette_intro_pos", ["Center", "Left", "Right"], "Where the intro text appears on screen.");

        addHeader("Subtitles & Fonts");
        createFontOption("MAIN HUD FONT", "kssette_custom_font", "Choose the font for the HUD."); 
        createFontOption("PIXEL STAGE FONT", "kssette_custom_pixel_font", "Choose the font for pixel stages."); 
        createFontOption("INTRO TITLE FONT", "kssette_intro_font_title", "Choose the font for the intro title."); 
        createFontOption("INTRO ARTIST FONT", "kssette_intro_font_artist", "Choose the font for the intro artist."); 
        createToggle("SUBTITLES POSITION", "kssette_subtitles_pos", ["Bottom", "Top"], "Where to display subtitles.");
        createToggle("SUBTITLES ANIMATION", "kssette_subtitles_anim", ["Vanilla", "Slide", "Fade", "Vertical", "Zoom"], "How subtitles appear on screen.");
        createToggle("SMART KARAOKE MODE", "kssette_smart_karaoke", ["On", "Off"], "[EXPERIMENTAL] Syncs the text letter by letter like singing."); 

        descBg = new FlxSprite(20, screenH);
        var img = largeCapsuleAsset;
        if (img != null) {
            descBg.loadGraphic(img);
        } else {
            descBg.makeGraphic(Std.int(largeCapsuleWidth), Std.int(descMaxHeight + 30), 0xFF000000);
        }
        
        if (descBg.graphic != null) {
            var sRatio = largeCapsuleWidth / descBg.graphic.width;
            descBg.scale.set(sRatio, sRatio);
            descBg.updateHitbox();
        }
        
        descBg.scrollFactor.set(0, 0);
        descBg.cameras = [optionCam];
        add(descBg);

        descTextDisplay = new FlxText(0, 0, descTextMaxWidth, "", 24);
        descTextDisplay.wordWrap = true;
        descTextDisplay.setFormat(menuFont, 24, FlxColor.WHITE, "left", FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
        descTextDisplay.antialiasing = false;
        descTextDisplay.scrollFactor.set(0, 0);
        descTextDisplay.cameras = [optionCam];
        add(descTextDisplay);

        descValueText = new FlxText(0, 0, 0, "", 28);
        descValueText.wordWrap = false;
        descValueText.setFormat(menuFont, 28, 0xFF00FF00, "left", FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
        descValueText.antialiasing = false;
        descValueText.scrollFactor.set(0, 0);
        descValueText.cameras = [optionCam];
        add(descValueText);

        add(marqueeBg);
        add(marqueeText1);
        add(marqueeText2);

        previewHitbox = new FlxSprite(0, 0).makeGraphic(1, 1, 0xFF00FF00);
        previewHitbox.alpha = 0.01;
        previewHitbox.scrollFactor.set(0, 0);
        previewHitbox.cameras = [optionCam];
        add(previewHitbox);

        if (FlxG.onMobile) {
            kssBackButton = new FunkinBackButton(15, 15, 0xFFFFFFFF, function() {
                if (isFontMenuOpen || isTimeMenuOpen || isOpMenuOpen || isVolMenuOpen) {
                    // These are now handled in KssetteSubOptionsSubState so this shouldn't be reached
                } else {
                    exitMenu();
                }
            }, 0.7);
            kssBackButton.scrollFactor.set(0, 0);
            kssBackButton.cameras = [optionCam];
            add(kssBackButton);
        }
        
        var previewAreaW = screenW - panelWidth;
        var tX = panelOnLeft ? panelWidth : 0;
        previewHitbox.x = tX;
        previewHitbox.setGraphicSize(Std.int(previewAreaW), Std.int(screenH));
        previewHitbox.updateHitbox();
    }

    function addHeader(text:String) {
        var bg = new FlxSprite(0, 0).makeGraphic(Std.int(smallCapsuleWidth), 50, 0xFF000000);
        bg.alpha = 0.8;
        bg.cameras = [optionCam];
        add(bg);

        var header = new FlxText(0, 0, smallCapsuleWidth, text.toUpperCase(), 32);
        header.setFormat(menuFont, 32, FlxColor.YELLOW, "center", FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
        header.antialiasing = false;
        header.y = (bg.height - header.height) / 2;
        header.cameras = [optionCam];
        add(header);
        
        optionItems.push({
            bg: bg,
            labelDisplay: header,
            textDisplay: null,
            isHeader: true
        });
    }

    function getSavedString(saveKey:String, fallback:String):String {
        var curVal:String = fallback;
        var fetchedVal = Save.instance.modOptions.get(saveKey);
        if (fetchedVal != null) curVal = Std.string(fetchedVal);  
        return curVal;
    }

    function optionIndex(options:Array<String>, curVal:String):Int {
        if (curVal == "true") curVal = "On Note Hit";
        else if (curVal == "false") curVal = "Off";
        else if (curVal == "On") curVal = "On Note Hit";
        var idx:Int = options.indexOf(curVal);
        return idx < 0 ? 0 : idx;
    }

    function createOptionBase(labelText:String, saveKey:String, value:String, descStr:String, hasValue:Bool):Dynamic {
        var bg = new FlxSprite(0, 0);
        if (smallCapsuleAsset != null) bg.loadGraphic(smallCapsuleAsset);
        else bg.makeGraphic(Std.int(smallCapsuleWidth), Std.int(120.0), 0xFFFFFFFF);

        if (bg.graphic != null) {
            var sRatio = smallCapsuleWidth / bg.graphic.width;
            bg.scale.set(sRatio, sRatio);
            bg.updateHitbox();
        }
        bg.cameras = [optionCam];
        add(bg);

        var label = new FlxText(labelOffsetX, labelOffsetY, 0, labelText, 32);
        label.wordWrap = false;
        label.setFormat(menuFont, 32, FlxColor.WHITE, "left", FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
        label.antialiasing = false;
        label.cameras = [optionCam];
        add(label);

        var valueText:FlxText = null;
        if (hasValue) {
            valueText = new FlxText(0, valueOffsetY, 0, value, 32);
            valueText.wordWrap = false;
            valueText.setFormat(menuFont, 32, 0xFF00FF00, "left", FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
            valueText.antialiasing = false;
            valueText.color = getValueColor(valueText.text);
            valueText.cameras = [optionCam];
            add(valueText);
        }

        return {
            bg: bg,
            labelDisplay: label,
            textDisplay: valueText,
            key: saveKey,
            options: [],
            desc: descStr,
            isHeader: false,
            slideTimer: 0.0,
            flashTimer: 0.0,
            valOffX: valueOffsetX,
            currentIndex: 0,
            framesUntilUpdate: null,
            fire: null
        };
    }

    function primeOptionFire(item:Dynamic):Void {
        item.flashTimer = 1.0;
        descSlideVerticalTimer = 0.0;
        descValueSlideTimer = 0.0;
        if (sndOn != null) FlxG.sound.play(sndOn, 0.6);
        HapticUtil.vibrate(0, 0.01, 0.3, 0.1);
    }

    function createToggle(labelText:String, saveKey:String, options:Array<String>, descStr:String) {
        var curVal:String = getSavedString(saveKey, "Off");
        if (curVal == "On" && saveKey == "kssette_hitsound") curVal = "On Note Hit";
        if (curVal == "true" && saveKey == "kssette_hitsound") curVal = "On Note Hit";
        var item = createOptionBase(labelText, saveKey, formatShortValue(curVal), descStr, true);
        var menuInst = this;
        item.options = options;
        item.currentIndex = optionIndex(options, curVal);
        item.fire = function(self:Dynamic) {
            self.currentIndex = Std.int(self.currentIndex + 1) % self.options.length;
            var newVal = self.options[self.currentIndex];
            Save.instance.modOptions.set(self.key, newVal);
            for (it in menuInst.optionItems) it.lockedState = null;
            
            if (self.textDisplay != null) {
                self.textDisplay.text = menuInst.formatShortValue(newVal);
                self.framesUntilUpdate = 2; // Wait for FlxText to regen Graphic
                
                var tColor = menuInst.getValueColor(self.textDisplay.text);
                if (self.textDisplay.color != tColor) self.textDisplay.color = tColor;
            }
            
            self.slideTimer = 0.0;
            self.flashTimer = 1.0;
            menuInst.descSlideVerticalTimer = 0.0;
            menuInst.descValueSlideTimer = 0.0;

            if (menuInst.descTextDisplay != null) {
                menuInst.descTextDisplay.text = self.desc;
            }
            if (menuInst.descValueText != null) {
                menuInst.descValueText.text = menuInst.formatLongValue(newVal);
                
                var vColor = menuInst.getValueColor(menuInst.descValueText.text);
                if (menuInst.descValueText.color != vColor) menuInst.descValueText.color = vColor;
            }

            var upperVal = Std.string(newVal).toUpperCase();
            if (upperVal == "OFF" || upperVal == "DISABLED" || upperVal == "FALSE") {
                if (menuInst.sndOff != null) FlxG.sound.play(menuInst.sndOff, 0.6);
            } else {
                if (menuInst.sndOn != null) FlxG.sound.play(menuInst.sndOn, 0.6);
            }
            HapticUtil.vibrate(0, 0.01, 0.3, 0.1);

            Save.instance.flush();
            menuInst.updatePreviews();

            if (self.key == "kssette_mobile_keyboard") {
                FlxG.switchState(ScriptedMusicBeatState.init("KssetteOptionsState"));
            }
        };
        optionItems.push(item);
    }

    function createOpacityOption(labelText:String, saveKey:String, descStr:String) {
        var curVal:String = getSavedString(saveKey, "65%");
        if (curVal.indexOf("%") == -1) curVal += "%";
        var item = createOptionBase(labelText, saveKey, curVal, descStr, true);
        var menuInst = this;
        item.fire = function(self:Dynamic) {
            menuInst.primeOptionFire(self);
            if (menuInst.subOptions != null) menuInst.subOptions.openOpacitySelector(self.key);
        };
        optionItems.push(item);
    }

    function createVolumeOption(labelText:String, saveKey:String, descStr:String) {
        var curVal:String = getSavedString(saveKey, "100%");
        if (curVal.indexOf("%") == -1) curVal += "%";
        var item = createOptionBase(labelText, saveKey, curVal, descStr, true);
        var menuInst = this;
        item.fire = function(self:Dynamic) {
            menuInst.primeOptionFire(self);
            if (menuInst.subOptions != null) menuInst.subOptions.openVolumeSelector(self.key);
        };
        optionItems.push(item);
    }

    function createTimeOption(labelText:String, saveKey:String, descStr:String) {
        var item = createOptionBase(labelText, saveKey, getSavedString(saveKey, "20:00"), descStr, true);
        var menuInst = this;
        item.fire = function(self:Dynamic) {
            menuInst.primeOptionFire(self);
            if (menuInst.subOptions != null) menuInst.subOptions.openTimeSelector(self.key, self.textDisplay);
        };
        optionItems.push(item);
    }

    function createFontOption(labelText:String, saveKey:String, descStr:String) {
        var item = createOptionBase(labelText, saveKey, "", descStr, false);
        var menuInst = this;
        item.fire = function(self:Dynamic) {
            menuInst.primeOptionFire(self);
            if (menuInst.subOptions != null) menuInst.subOptions.openFontSelector(self.key, null);
        };
        optionItems.push(item);
    }

    function updateTextSlide(txt:FlxText, maxWidth:Float, timer:Float) {
        if (txt == null) return;
        if (txt.offset == null) txt.offset = new FlxPoint(0, 0);
        
        if (txt.wordWrap || txt.width <= maxWidth) {
            if (txt.offset.x != 0 || txt.clipRect != null) {
                txt.offset.x = 0;
                txt.clipRect = null;
            }
            return;
        }

        var overflow = txt.width - maxWidth; 
        var speed = 40.0; 
        var slideDuration = overflow / speed;
        var cycle = 1.0 + slideDuration + 1.0 + slideDuration;
        
        var t = timer % cycle;
        var currentOffset = 0.0;
        
        if (t < 1.0) {
            currentOffset = 0.0;
        } else if (t < 1.0 + slideDuration) {
            var p = (t - 1.0) / slideDuration;
            var ease = -(Math.cos(Math.PI * p) - 1) / 2;
            currentOffset = overflow * ease;
        } else if (t < 2.0 + slideDuration) {
            currentOffset = overflow;
        } else {
            var p = (t - (2.0 + slideDuration)) / slideDuration;
            var ease = -(Math.cos(Math.PI * p) - 1) / 2;
            currentOffset = overflow * (1.0 - ease);
        }
        
        if (txt.clipRect == null || Math.abs(txt.offset.x - currentOffset) > 0.1) {
            txt.offset.x = currentOffset;

            if (txt.clipRect == null) {
                txt.clipRect = new FlxRect(currentOffset, 0, maxWidth, txt.height + 5);
            } else {
                var r = txt.clipRect;
                r.x = currentOffset;
                txt.clipRect = r;
            }
        }
    }

    function updateVerticalTextSlide(txt:FlxText, maxHeight:Float, timer:Float) {
        if (txt == null) return;
        if (txt.offset == null) txt.offset = new FlxPoint(0, 0);
        
        if (txt.height <= maxHeight) {
            if (txt.offset.y != 0 || txt.clipRect != null) {
                txt.offset.y = 0;
                txt.clipRect = null;
            }
            return;
        }

        var overflow = txt.height - maxHeight;
        var speed = 30.0; 
        var slideDuration = overflow / speed;
        var cycle = 2.0 + slideDuration + 2.0 + slideDuration; 
        
        var t = timer % cycle;
        var currentOffset = 0.0;
        
        if (t < 2.0) {
            currentOffset = 0.0;
        } else if (t < 2.0 + slideDuration) {
            var p = (t - 2.0) / slideDuration;
            var ease = -(Math.cos(Math.PI * p) - 1) / 2;
            currentOffset = overflow * ease;
        } else if (t < 4.0 + slideDuration) {
            currentOffset = overflow;
        } else {
            var p = (t - (4.0 + slideDuration)) / slideDuration;
            var ease = -(Math.cos(Math.PI * p) - 1) / 2;
            currentOffset = overflow * (1.0 - ease);
        }
        
        if (txt.clipRect == null || Math.abs(txt.offset.y - currentOffset) > 0.1) {
            txt.offset.y = currentOffset;
            if (txt.clipRect == null) {
                txt.clipRect = new FlxRect(0, currentOffset, txt.width + 5, maxHeight);
            } else {
                var r = txt.clipRect;
                r.y = currentOffset;
                txt.clipRect = r;
            }
        }
    }

    function resetTextSlide(txt:FlxText):Void {
        if (txt == null) return;
        if (txt.offset != null) {
            if (txt.offset.x != 0) txt.offset.x = 0;
            if (txt.offset.y != 0) txt.offset.y = 0;
        }
        if (txt.clipRect != null) txt.clipRect = null;
    }

    function resetItemSlide(idx:Int):Void {
        if (idx < 0 || idx >= optionItems.length) return;
        var item = optionItems[idx];
        if (item == null || item.isHeader) return;
        resetTextSlide(item.labelDisplay);
        resetTextSlide(item.textDisplay);
        item.slideTimer = 0.0;
    }

    function setOptionItemVisible(item:Dynamic, visible:Bool):Void {
        if (item == null || item.bg == null) return;
        if (item.bg.visible != visible) item.bg.visible = visible;
        if (item.labelDisplay != null && item.labelDisplay.visible != visible) item.labelDisplay.visible = visible;
        if (item.textDisplay != null && item.textDisplay.visible != visible) item.textDisplay.visible = visible;
    }

    function hideVisibleRangeOutside(startIdx:Int, endIdx:Int):Void {
        if (lastVisibleStart < 0) return;
        var stopIdx = lastVisibleEnd + 1;
        for (i in lastVisibleStart...stopIdx) {
            if ((i < startIdx || i > endIdx) && i >= 0 && i < optionItems.length) {
                setOptionItemVisible(optionItems[i], false);
            }
        }
    }

    override public function update(elapsed:Float):Void {
        super.update(elapsed);
        
        if (isFontMenuOpen || isTimeMenuOpen || isOpMenuOpen || isVolMenuOpen) return;

        var sw = screenW;
        var sh = screenH;
        var halfH = halfScreenH;
        var backPressed = false;
        var esc = FlxG.keys.justPressed.ESCAPE || backPressed;

        if (esc) {
            exitMenu();
        }

        if (kssBackButton != null) {
            kssBackButton.visible = !panelHidden;
            var targetBackX = panelOnLeft ? (sw - kssBackButton.width - 15) : 15;
            kssBackButton.x = FlxMath.lerp(kssBackButton.x, targetBackX, elapsed * 12);
        }

        if (FlxG.keys.justPressed.TAB) {
            panelHidden = !panelHidden;
        }

        if (FlxG.keys.justPressed.SHIFT && !transitioningSide && !panelHidden) {
            transitioningSide = true;
            transitionTimer = 0.0;
            nextPanelOnLeft = !panelOnLeft;
        }

        var targetMarqueeY:Float = panelHidden ? -50 : 0;
        if (marqueeBg != null) {
            if (Math.abs(marqueeBg.y - targetMarqueeY) > 0.1) marqueeBg.y = FlxMath.lerp(marqueeBg.y, targetMarqueeY, elapsed * 12);
            else marqueeBg.y = targetMarqueeY;
        }

        if (marqueeText1 != null && marqueeText2 != null) {
            marqueeOffset -= marqueeSpeed * elapsed;
            if (marqueeOffset <= -marqueeText1.width) {
                marqueeOffset += marqueeText1.width;
            }

            marqueeText1.x = marqueeOffset;
            marqueeText2.x = marqueeOffset + marqueeText1.width;

            if (marqueeBg != null) {
                marqueeText1.y = marqueeBg.y + 6;
                marqueeText2.y = marqueeBg.y + 6;
            }
        }

        if (scrollTracker != null) {
            curSelectedFloat = scrollTracker.y;
        }

        if (!isDragging) {
            if (Math.abs(dragOffsetY) > 0.001) dragOffsetY = FlxMath.lerp(dragOffsetY, 0, elapsed * 15);
            else dragOffsetY = 0;
        }
        
        var targetXBase:Float = 0;
        var targetDescX:Float = 0;
        var targetFadeX:Float = 0;

        if (transitioningSide) {
            transitionTimer += elapsed;
            targetXBase = panelOnLeft ? -smallCapsuleWidth - 200 : sw + 200;
            targetDescX = panelOnLeft ? sw + 200 : -largeCapsuleWidth - 200;
            targetFadeX = panelOnLeft ? -panelWidth - 200 : sw + 200;

            if (transitionTimer > 0.3) {
                panelOnLeft = nextPanelOnLeft;
                transitioningSide = false;
                
                var startXBase = panelOnLeft ? -smallCapsuleWidth - 200 : sw + 200;
                var startDescX = panelOnLeft ? sw + 200 : -largeCapsuleWidth - 200;
                var startFadeX = panelOnLeft ? -panelWidth - 200 : sw + 200;
                
                if (descBg != null) descBg.x = startDescX;
                if (capsuleFadeBg != null) {
                    capsuleFadeBg.x = startFadeX;
                    capsuleFadeBg.flipX = panelOnLeft;
                }
                for (i in 0...optionItems.length) {
                    if (optionItems[i].bg != null) optionItems[i].bg.x = startXBase;
                }
                
                if (previewHitbox != null) {
                    var previewAreaW = sw - panelWidth;
                    var tX = panelOnLeft ? panelWidth : 0;
                    if (previewHitbox.x != tX) {
                        previewHitbox.x = tX;
                        previewHitbox.setGraphicSize(Std.int(previewAreaW), Std.int(sh));
                        previewHitbox.updateHitbox();
                    }
                }
            }
        } else {
            targetXBase = panelOnLeft ? -50 : (sw - smallCapsuleWidth + 40);
            targetDescX = panelOnLeft ? (sw - largeCapsuleWidth - 20) : 20;
            targetFadeX = panelOnLeft ? 0 : (sw - panelWidth + 1);

            if (panelHidden) {
                targetXBase = panelOnLeft ? -smallCapsuleWidth - 200 : sw + 200;
                targetDescX = panelOnLeft ? sw + 200 : -largeCapsuleWidth - 200;
                targetFadeX = panelOnLeft ? -panelWidth - 200 : sw + 200;
            }
        }

        if (capsuleFadeBg != null) {
            if (Math.abs(capsuleFadeBg.x - targetFadeX) > 0.1) capsuleFadeBg.x = FlxMath.lerp(capsuleFadeBg.x, targetFadeX, elapsed * 12);
            else capsuleFadeBg.x = targetFadeX;
            if (capsuleFadeBg.flipX != panelOnLeft) capsuleFadeBg.flipX = panelOnLeft;
        }

        var screenTop = -150.0;
        var screenBottom = sh + 150.0;
        var itemCount = optionItems.length;

        if (lastSelectionIndex != selectedIndex) {
            resetItemSlide(lastSelectionIndex);
            lastSelectionIndex = selectedIndex;
        }

        if (itemCount > 0) {
            var approxSpan:Int = Std.int(Math.ceil((halfH + 240.0 + Math.abs(dragOffsetY)) / capsuleSpacing)) + 2;
            visibleStart = Std.int(Math.floor(curSelectedFloat)) - approxSpan;
            visibleEnd = Std.int(Math.ceil(curSelectedFloat)) + approxSpan;
            if (visibleStart < 0) visibleStart = 0;
            if (visibleEnd >= itemCount) visibleEnd = itemCount - 1;

            if (lastVisibleStart != visibleStart || lastVisibleEnd != visibleEnd) {
                if (lastVisibleStart < 0) {
                    for (i in 0...itemCount) {
                        if (i < visibleStart || i > visibleEnd) setOptionItemVisible(optionItems[i], false);
                    }
                } else {
                    hideVisibleRangeOutside(visibleStart, visibleEnd);
                }
                lastVisibleStart = visibleStart;
                lastVisibleEnd = visibleEnd;
            }

            var rangeEnd = visibleEnd + 1;
            for (i in visibleStart...rangeEnd) {
                var item = optionItems[i];
                if (item == null || item.bg == null) continue;

                var bg = item.bg;
                var label = item.labelDisplay;
                var value = item.textDisplay;
                var diff = i - curSelectedFloat;
                var targetY = halfH + (diff * capsuleSpacing) - 50 + dragOffsetY;
                var wasVisible = bg.visible;
                var isVisible = (targetY > screenTop && targetY < screenBottom);
                setOptionItemVisible(item, isVisible);

                if (!isVisible) {
                    item.slideTimer = 0.0;
                    continue;
                }

                var curveOffset = Math.abs(diff) * 45;
                var targetX = panelOnLeft ? (targetXBase - curveOffset) : (targetXBase + curveOffset);
                var isSel = i == selectedIndex;
                if (!item.isHeader && isSel) targetX += panelOnLeft ? 40 : -40;

                if (!wasVisible) {
                    bg.x = targetX;
                    bg.y = targetY;
                } else {
                    if (Math.abs(bg.x - targetX) > 0.1) bg.x = FlxMath.lerp(bg.x, targetX, elapsed * 12); else bg.x = targetX;
                    if (Math.abs(bg.y - targetY) > 0.1) bg.y = FlxMath.lerp(bg.y, targetY, elapsed * 12); else bg.y = targetY;
                }

                if (item.isHeader) {
                    if (label != null) {
                        if (item.labelWidth == null) item.labelWidth = label.width;
                        if (item.labelHeight == null) item.labelHeight = label.height;
                        label.x = bg.x + (bg.width - item.labelWidth) / 2;
                        label.y = bg.y + (bg.height - item.labelHeight) / 2;
                    }
                } else {
                    var targetAlpha = isSel ? 1.0 : 0.6;
                    var targetColor = isSel ? FlxColor.YELLOW : FlxColor.WHITE;
                    
                    if (item.lockedState == null && apiRef != null) item.lockedState = apiRef.isOptionLocked(item.key);
                    if (item.lockedState == true) {
                        targetAlpha *= 0.4;
                        targetColor = FlxColor.GRAY;
                        if (value != null && value.text != "LCK") {
                            value.text = "LCK";
                            value.color = FlxColor.RED;
                        }
                    } else {
                        if (value != null && value.text == "LCK") {
                            var rawVal = Save.instance.modOptions.get(item.key);
                            if (rawVal == null) rawVal = "Off";
                            value.text = formatShortValue(Std.string(rawVal));
                            value.color = getValueColor(value.text);
                        }
                    }

                    if (isSel) item.slideTimer += elapsed; else item.slideTimer = 0.0;

                    if (bg.alpha != 1.0) bg.alpha = 1.0;
                    if (value != null && value.alpha != targetAlpha) value.alpha = targetAlpha;
                    if (label != null) {
                        if (label.color != targetColor) label.color = targetColor;
                        if (label.alpha != targetAlpha) label.alpha = targetAlpha;
                    }
                    
                    if (item.errorTimer != null && item.errorTimer > 0) {
                        item.errorTimer -= elapsed * 8;
                        if (item.errorTimer < 0) item.errorTimer = 0;

                        var flashOn = (Math.floor(item.errorTimer * 10) % 2 == 0);
                        var targetBgColor = flashOn ? FlxColor.WHITE : FlxColor.RED;
                        var targetLblColor = flashOn ? FlxColor.RED : FlxColor.WHITE;

                        if (bg.color != targetBgColor) bg.color = targetBgColor;
                        if (label != null && label.color != targetLblColor) label.color = targetLblColor;
                        
                        bg.x += FlxG.random.float(-8, 8);
                    } else if (item.flashTimer != null && item.flashTimer > 0) {
                        item.flashTimer -= elapsed * 8;
                        if (item.flashTimer < 0) item.flashTimer = 0;
                        
                        var flashOn = (Math.floor(item.flashTimer * 10) % 2 == 0);
                        var targetBgColor = flashOn ? FlxColor.WHITE : FlxColor.YELLOW;
                        var targetLblColor = flashOn ? FlxColor.YELLOW : FlxColor.WHITE;

                        if (bg.color != targetBgColor) bg.color = targetBgColor;
                        if (label != null && label.color != targetLblColor) label.color = targetLblColor;
                    } else {
                        var targetBgColor = isSel ? FlxColor.WHITE : 0xFF555555;
                        if (bg.color != targetBgColor) bg.color = targetBgColor;
                    }

                    if (label != null) {
                        label.x = bg.x + labelOffsetX;
                        label.y = bg.y + labelOffsetY;
                    }

                    if (value != null) {
                        if (item.framesUntilUpdate != null && item.framesUntilUpdate > 0) {
                            item.framesUntilUpdate--;
                        } 
                        else if (item.cachedValStr != value.text) {
                            item.valueWidth = value.textField.textWidth + 4; 
                            item.cachedValStr = value.text;
                        }

                        var currentValW = item.valueWidth != null ? item.valueWidth : value.width;
                        var vX = bg.x + bg.width - valueOffsetX - currentValW;
                        
                        if (currentValW > valueMaxWidth) {
                            vX = bg.x + bg.width - valueOffsetX - valueMaxWidth;
                        }
                        
                        value.x = vX;
                        value.y = bg.y + valueOffsetY;
                    }

                    if (isSel) {
                        if (item.clipped == true) {
                            if (label != null) { label.fieldWidth = 0; label.wordWrap = false; }
                            if (value != null) { value.fieldWidth = 0; value.wordWrap = false; }
                            item.clipped = false;
                        }
                        updateTextSlide(label, labelMaxWidth, item.slideTimer);
                        if (value != null) updateTextSlide(value, valueMaxWidth, item.slideTimer);
                    } else {
                        if (item.clipped != true) {
                            if (label != null) {
                                if (label.offset != null && label.offset.x != 0) label.offset.x = 0;
                                if (label.clipRect != null) label.clipRect = null;
                                label.fieldWidth = Std.int(labelMaxWidth);
                                label.wordWrap = false;
                            }
                            if (value != null) {
                                if (value.offset != null && value.offset.x != 0) value.offset.x = 0;
                                if (value.clipRect != null) value.clipRect = null;
                                value.fieldWidth = Std.int(valueMaxWidth);
                                value.wordWrap = false;
                            }
                            item.clipped = true;
                        }
                    }
                }
            }
        }

        var targetDescY:Float = sh - (descBg != null ? descBg.height : 90) - 20;
        
        if (descBg != null) {
            if (Math.abs(descBg.x - targetDescX) > 0.1) descBg.x = FlxMath.lerp(descBg.x, targetDescX, elapsed * 12); else descBg.x = targetDescX;
            if (Math.abs(descBg.y - targetDescY) > 0.1) descBg.y = FlxMath.lerp(descBg.y, targetDescY, elapsed * 12); else descBg.y = targetDescY;
            if (descTextDisplay != null) {
                descTextDisplay.x = descBg.x + descOffsetX;
                descTextDisplay.y = descBg.y + descOffsetY;
            }
            if (descValueText != null) {
                var vX = descBg.x + descBg.width - descValueOffsetX - descValueText.width;
                if (descValueText.width > descValueMaxWidth) {
                    vX = descBg.x + descBg.width - descValueOffsetX - descValueMaxWidth;
                }
                descValueText.x = vX;
                descValueText.y = descBg.y + descValueOffsetY;
            }
        }

        handleInput(elapsed);

        if (!panelHidden && !transitioningSide) {
            descSlideVerticalTimer += elapsed;
            descValueSlideTimer += elapsed;
            
            if (descTextDisplay != null && descBg != null) {
                updateVerticalTextSlide(descTextDisplay, descMaxHeight, descSlideVerticalTimer);
            }
            if (descValueText != null && descBg != null) {
                updateTextSlide(descValueText, descValueMaxWidth, descValueSlideTimer);
            }
        }

        if (holdTimer > 0) holdTimer -= elapsed;
    }

    function changeSelection(change:Int = 0) {
        selectedIndex += change;
        
        if (selectedIndex < 0) selectedIndex = optionItems.length - 1;
        if (selectedIndex >= optionItems.length) selectedIndex = 0;

        if (optionItems[selectedIndex].isHeader) {
            var dir = change >= 0 ? 1 : -1;
            while(optionItems[selectedIndex].isHeader) {
                selectedIndex += dir;
                if (selectedIndex < 0) selectedIndex = optionItems.length - 1;
                if (selectedIndex >= optionItems.length) selectedIndex = 0;
            }
        }

        if (optionItems.length > 0 && selectedIndex >= 0 && selectedIndex < optionItems.length) {
            var selItem = optionItems[selectedIndex];
            if (descTextDisplay != null && !selItem.isHeader) {
                var curVal = "Off";
                var fetchedVal = Save.instance.modOptions.get(selItem.key);
                if (fetchedVal != null) curVal = Std.string(fetchedVal);
                
                descTextDisplay.text = selItem.desc;
                if (descValueText != null) {
                    if (selItem.lockedState == null && apiRef != null) selItem.lockedState = apiRef.isOptionLocked(selItem.key);
                    if (selItem.lockedState == true) {
                        descValueText.text = "LOCKED";
                        var targetColor = FlxColor.RED;
                        if (descValueText.color != targetColor) descValueText.color = targetColor;
                    } else {
                        descValueText.text = formatLongValue(curVal);
                        var targetColor = getValueColor(descValueText.text);
                        if (descValueText.color != targetColor) descValueText.color = targetColor;
                    }
                }
                descSlideVerticalTimer = 0.0;
                descValueSlideTimer = 0.0;
            }
        }

        if (change != 0) {
            if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
            HapticUtil.vibrate(0, 0.01, 0.15, 0.1);
        }

        if (scrollTween != null) scrollTween.cancel();
        scrollTween = FlxTween.tween(scrollTracker, {y: selectedIndex}, 0.5, {ease: FlxEase.expoOut});
    }

    function handleInput(elapsed:Float) {
        var isOverPreviewZone = false;
        var pressed = false;
        
        if (previewHitbox != null && previewHitbox.exists) {
            var mx:Float = -1;
            var my:Float = -1;
            
            if (FlxG.onMobile) {
                if (FlxG.touches != null && FlxG.touches.list != null && FlxG.touches.list.length > 0) {
                    var t = FlxG.touches.list[0];
                    if (t != null) {
                        mx = t.screenX;
                        my = t.screenY;
                        pressed = t.pressed;
                    }
                }
            } else {
                if (FlxG.mouse != null) {
                    mx = FlxG.mouse.screenX;
                    my = FlxG.mouse.screenY;
                    pressed = FlxG.mouse.pressed;
                }
            }
            
            if (mx >= previewHitbox.x && mx <= previewHitbox.x + previewHitbox.width && 
                my >= previewHitbox.y && my <= previewHitbox.y + previewHitbox.height) {
                isOverPreviewZone = true;
            }
        }

        if (isOverPreviewZone) {
            if (pressed) {
                previewHoldTimer += elapsed;
                if (previewHoldTimer >= 0.5 && !previewActionFired) {
                    previewActionFired = true;
                    panelHidden = !panelHidden;
                    if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
                }
            } else {
                previewHoldTimer = 0.0;
                previewActionFired = false;
            }
        } else {
            previewHoldTimer = 0.0;
            previewActionFired = false;
        }

        if (FlxG.onMobile) {
            if (SwipeUtil.swipeUp && !panelHidden) {
                changeSelection(-1);
            } else if (SwipeUtil.swipeDown && !panelHidden) {
                changeSelection(1);
            } else if ((SwipeUtil.swipeLeft || SwipeUtil.swipeRight) && !transitioningSide && !panelHidden && holdTimer <= 0) {
                transitioningSide = true;
                transitionTimer = 0.0;
                nextPanelOnLeft = !panelOnLeft;
                holdTimer = 0.25;
                HapticUtil.vibrate(0, 0.01, 0.25, 0.1);
            }
        }

        if (!FlxG.onMobile && FlxG.mouse != null && FlxG.mouse.wheel != 0 && !panelHidden) {
            changeSelection(Std.int(-FlxG.mouse.wheel));
        }

        if (!panelHidden && !transitioningSide) {
            if (PlayerSettings.player1.controls.UI_UP_P) {
                changeSelection(-1);
                holdTimer = 0.1;
            }
            if (PlayerSettings.player1.controls.UI_DOWN_P) {
                changeSelection(1);
                holdTimer = 0.1;
            }
            
            var acceptPressed = PlayerSettings.player1.controls.ACCEPT_P;
            if (FlxG.onMobile) {
                var selItem = optionItems[selectedIndex];
                if (selItem != null && selItem.bg != null) {
                    if (TouchUtil.pressAction(selItem.bg)) {
                        acceptPressed = true;
                    }
                }
            }

            if (acceptPressed) {
                var item = optionItems[selectedIndex];
                if (item != null && !item.isHeader && item.fire != null) {
                    if (apiRef != null && apiRef.isOptionLocked(item.key)) {
                        FlxG.sound.play(Paths.sound("ui/khud_lock"), 0.3);
                        item.errorTimer = 1.0;
                        holdTimer = 0.2;
                    } else {
                        item.fire(item);
                        holdTimer = 0.2;
                    }
                }
            }
            
            if (!FlxG.onMobile) fireClickAt();
        }
    }

    function fireClickAt() {
        var startIdx = visibleStart < 0 ? 0 : visibleStart;
        var endIdx = visibleEnd < 0 ? optionItems.length - 1 : visibleEnd;
        if (endIdx >= optionItems.length) endIdx = optionItems.length - 1;
        var stopIdx = endIdx + 1;
        for (i in startIdx...stopIdx) {
            var item = optionItems[i];
            if (item.bg != null && item.bg.visible) {
                if (FlxG.mouse.justReleased && FlxG.mouse.overlaps(item.bg, optionCam)) {
                    if (!item.isHeader) {
                        if (selectedIndex == i) {
                            if (apiRef != null && apiRef.isOptionLocked(item.key)) {
                                FlxG.sound.play(Paths.sound("ui/khud_lock"), 0.3);
                                item.errorTimer = 1.0;
                                holdTimer = 0.2;
                            } else {
                                if (item.fire != null) item.fire(item);
                                holdTimer = 0.2;
                            }
                        } else {
                            selectedIndex = i;
                            changeSelection(0);
                            holdTimer = 0.2;
                        }
                    }
                    break;
                }
            }
        }
    }
}