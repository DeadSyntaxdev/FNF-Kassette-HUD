class KssetteMenuState extends ScriptedMusicBeatState {
    
    var largeCapsulePath:String = "ui/capsules/DescCapsule";
    var previewModuleNames:Array<String> = ["KssetteNight", "KssetteAccuracy", "KssetteHUDPreview", "KssetteJudgements", "KssetteTimeBar", "KssetteCombo", "KssetteSongInfo", "KssetteShowTitle", "KssetteBreakBar", "KssetteSubtitles"];
    var previewModules:Array<Dynamic> = [];
