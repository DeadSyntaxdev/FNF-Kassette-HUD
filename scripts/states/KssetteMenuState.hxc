    function addHeader(text:String) {
        var bg = new FlxSprite(0, 0).makeGraphic(Std.int(smallCapsuleWidth), 50, 0xFF000000);
        bg.alpha = 0.8;
        bg.cameras = [optionCam];
        add(bg);

        var header = new FlxText(0, 0, smallCapsuleWidth, text.toUpperCase(), 32);
            header.setFormat(menuFont, 32, FlxColor.YELLOW, "center", FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
            header.antialiasing = false;
        header.y = (bg.height - header.height) / 2;
        header.cameras = [optionCam];
        add(header);
        
        optionItems.push({
            bg: bg,
            labelDisplay: header,
            textDisplay: null,
            isHeader: true
        });
    }

    function getSavedString(saveKey:String, fallback:String):String {
        var curVal:String = fallback;
            var fetchedVal = Save.instance.modOptions.get(saveKey);
            if (fetchedVal != null) curVal = Std.string(fetchedVal);  
        return curVal;
    }

    function optionIndex(options:Array<String>, curVal:String):Int {
        if (curVal == "true") curVal = "On Note Hit";
        else if (curVal == "false") curVal = "Off";
        else if (curVal == "On") curVal = "On Note Hit";
        var idx:Int = options.indexOf(curVal);
        return idx < 0 ? 0 : idx;
    }

    function createOptionBase(labelText:String, saveKey:String, value:String, descStr:String, hasValue:Bool):Dynamic {
        var bg = new FlxSprite(0, 0);

            if (smallCapsuleAsset != null) bg.loadGraphic(smallCapsuleAsset);
            else bg.makeGraphic(Std.int(smallCapsuleWidth), Std.int(120.0), 0xFFFFFFFF);

        if (bg.graphic != null) {
            var sRatio = smallCapsuleWidth / bg.graphic.width;
            bg.scale.set(sRatio, sRatio);
            bg.updateHitbox();
        }
        bg.cameras = [optionCam];
        add(bg);

        var label = new FlxText(labelOffsetX, labelOffsetY, 0, labelText, 32);
        label.wordWrap = false;
            label.setFormat(menuFont, 32, FlxColor.WHITE, "left", FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
            label.antialiasing = false;
        label.cameras = [optionCam];
        add(label);

        var valueText:FlxText = null;
        if (hasValue) {
            valueText = new FlxText(0, valueOffsetY, 0, value, 32);
            valueText.wordWrap = false;
                valueText.setFormat(menuFont, 32, 0xFF00FF00, "left", FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
                valueText.antialiasing = false;
            valueText.color = getValueColor(valueText.text);
            valueText.cameras = [optionCam];
            add(valueText);
        }

        return {
            bg: bg,
            labelDisplay: label,
            textDisplay: valueText,
            key: saveKey,
            options: [],
            desc: descStr,
            isHeader: false,
            slideTimer: 0.0,
            flashTimer: 0.0,
            valOffX: valueOffsetX,
            currentIndex: 0,
            fire: null
        };
    }

    function primeOptionFire(item:Dynamic):Void {
        item.flashTimer = 1.0;
        descSlideVerticalTimer = 0.0;
        descValueSlideTimer = 0.0;
        if (sndOn != null) FlxG.sound.play(sndOn, 0.6);
        HapticUtil.vibrate(0, 0.01, 0.3, 0.1);
    }

    function createToggle(labelText:String, saveKey:String, options:Array<String>, descStr:String) {
        var curVal:String = getSavedString(saveKey, "Off");
        if (curVal == "On" && saveKey == "kssette_hitsound") curVal = "On Note Hit";
        if (curVal == "true" && saveKey == "kssette_hitsound") curVal = "On Note Hit";
        var item = createOptionBase(labelText, saveKey, formatShortValue(curVal), descStr, true);
        var menuInst = this;
        item.options = options;
        item.currentIndex = optionIndex(options, curVal);
        item.fire = function(self:Dynamic) {
                self.currentIndex = Std.int(self.currentIndex + 1) % self.options.length;
                var newVal = self.options[self.currentIndex];
                Save.instance.modOptions.set(self.key, newVal);
                for (it in menuInst.optionItems) it.lockedState = null;
                
                if (self.textDisplay != null) {
                    self.textDisplay.text = menuInst.formatShortValue(newVal);
                    self.valueWidth = self.textDisplay.width;
                    
                    var tColor = menuInst.getValueColor(self.textDisplay.text);
                    if (self.textDisplay.color != tColor) self.textDisplay.color = tColor;
                    
                    if (self.valueWidth > menuInst.valueMaxWidth) {
                        self.textDisplay.x = self.bg.x + self.bg.width - self.valOffX - menuInst.valueMaxWidth;
                    } else {
                        self.textDisplay.x = self.bg.x + self.bg.width - self.valOffX - self.valueWidth;
                    }
                }
                
                self.slideTimer = 0.0;
                self.flashTimer = 1.0;
                menuInst.descSlideVerticalTimer = 0.0;
                menuInst.descValueSlideTimer = 0.0;

                if (menuInst.descTextDisplay != null) {
                    menuInst.descTextDisplay.text = self.desc;
                }
                if (menuInst.descValueText != null) {
                    menuInst.descValueText.text = menuInst.formatLongValue(newVal);
                    
                    var vColor = menuInst.getValueColor(menuInst.descValueText.text);
                    if (menuInst.descValueText.color != vColor) menuInst.descValueText.color = vColor;
                }

                var upperVal = Std.string(newVal).toUpperCase();
                if (upperVal == "OFF" || upperVal == "DISABLED" || upperVal == "FALSE") {
                    if (menuInst.sndOff != null) FlxG.sound.play(menuInst.sndOff, 0.6);
                } else {
                    if (menuInst.sndOn != null) FlxG.sound.play(menuInst.sndOn, 0.6);
                }
            HapticUtil.vibrate(0, 0.01, 0.3, 0.1);

                Save.instance.flush();
                menuInst.updatePreviews();

                if (self.key == "kssette_mobile_keyboard") {
                    FlxG.switchState(ScriptedMusicBeatState.init("KssetteMenuState"));
                }
            };
        optionItems.push(item);
    }

    function createOpacityOption(labelText:String, saveKey:String, descStr:String) {
        var curVal:String = getSavedString(saveKey, "65%");
        if (curVal.indexOf("%") == -1) curVal += "%";
        var item = createOptionBase(labelText, saveKey, curVal, descStr, true);
        var menuInst = this;
        item.fire = function(self:Dynamic) {
                menuInst.primeOptionFire(self);
                menuInst.openOpacitySelector(self.key);
            };
        optionItems.push(item);
    }

    function makeOverlayText(group:FlxSpriteGroup, x:Float, y:Float, w:Float, text:String, size:Int, color:Int, align:String, border:Bool = false):FlxText {
        var txt = new FlxText(x, y, w, text, size);
            if (border) txt.setFormat(menuFont, size, color, align, FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
            else txt.setFormat(menuFont, size, color, align);
        group.add(txt);
        return txt;
    }

    function createOverlayGroup(title:String, inst:String = null):FlxSpriteGroup {
        var group = new FlxSpriteGroup(0, 0);
        group.x = panelOnLeft ? -panelWidth : screenW;
        group.cameras = [optionCam];
        add(group);

        var bg = new FlxSprite(0, 0).makeGraphic(panelWidth, Std.int(screenH), 0xFF000000);
        bg.alpha = 0.95;
        bg.scrollFactor.set(0, 0);
        group.add(bg);

        makeOverlayText(group, 10, 80, panelWidth - 20, title, 40, FlxColor.YELLOW, "center", true);
        if (inst == null) inst = FlxG.onMobile ? "SWIPE TO CHANGE  |  TAP BACK BUTTON TO SAVE" : "SWIPE TO CHANGE  |  ENTER TO SAVE";
        makeOverlayText(group, 10, 140, panelWidth - 20, inst, 20, FlxColor.WHITE, "center");
        return group;
    }

    public function openOpacitySelector(saveKey:String) {
        isOpMenuOpen = true; 
        opSel_SaveKey = saveKey;
        
        var curVal = "65";
            var fetched = Save.instance.modOptions.get(saveKey);
            if (fetched != null) curVal = StringTools.replace(Std.string(fetched), "%", "");
        
        opSel_Value = Std.parseInt(curVal);
        if (opSel_Value == null) opSel_Value = 65;
        
        opSel_Group = createOverlayGroup("ADJUST OPACITY (ESC TO CANCEL)");
        var cY = halfScreenH;
        var cX = panelWidth / 2;
        
        opSel_Up = makeOverlayText(opSel_Group, cX - 50, cY - 100, 100, "/\\", 50, FlxColor.YELLOW, "center");
        opSel_Down = makeOverlayText(opSel_Group, cX - 50, cY + 50, 100, "\\/", 50, FlxColor.YELLOW, "center");
        opSel_TxtVal = makeOverlayText(opSel_Group, cX - 100, cY - 40, 200, "65%", 70, FlxColor.WHITE, "center", true);

        updateOpacityUI();
    }

    function updateOpacityUI() {
        if (opSel_Group == null || opSel_TxtVal == null) return;
        var nextText = Std.string(opSel_Value) + "%";
        if (opSel_TxtVal.text != nextText) opSel_TxtVal.text = nextText;
    }

    function saveOpacitySelection() {
        var finalStr = Std.string(opSel_Value) + "%";
        Save.instance.modOptions.set(opSel_SaveKey, finalStr);
        for (it in optionItems) it.lockedState = null;
        Save.instance.flush();
        
        if (descTextDisplay != null && optionItems.length > 0 && selectedIndex >= 0) {
            var selItem = optionItems[selectedIndex];
            if (selItem.textDisplay != null) {
                selItem.textDisplay.text = finalStr;
            }
        }

        if (sndOn != null) FlxG.sound.play(sndOn, 0.6);
        closeOpacitySelector();
        
        updatePreviews();
    }

    function closeOpacitySelector() {
        if (opSel_Group != null) {
            remove(opSel_Group);
            opSel_Group.destroy();
            opSel_Group = null;
        }
        isOpMenuOpen = false;
    }

    function handleOpacityInput(elapsed:Float) {
        var tX:Float = FlxG.mouse.screenX;
        var tY:Float = FlxG.mouse.screenY;
        var tJustPressed = false;
        
        if (FlxG.onMobile) {
            tJustPressed = TouchUtil.justPressed;
            if (TouchUtil.touch != null) { tX = TouchUtil.touch.screenX; tY = TouchUtil.touch.screenY; }
        } else {
            tJustPressed = FlxG.mouse.justPressed;
        }

        var oldValue = opSel_Value;
        
        if (tJustPressed) {
            if (tX >= opSel_Up.x - 40 && tX <= opSel_Up.x + opSel_Up.width + 40 &&
                tY >= opSel_Up.y - 40 && tY <= opSel_Up.y + opSel_Up.height + 40) {
                opSel_Value += 5; holdTimer = 0.1;
                if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
            }
            else if (tX >= opSel_Down.x - 40 && tX <= opSel_Down.x + opSel_Down.width + 40 &&
                     tY >= opSel_Down.y - 40 && tY <= opSel_Down.y + opSel_Down.height + 40) {
                opSel_Value -= 5; holdTimer = 0.1;
                if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
            }
        }

        if (FlxG.mouse != null && FlxG.mouse.wheel != 0) {
            opSel_Value += FlxG.mouse.wheel * 5;
            if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
        }

        var swipeU = SwipeUtil.swipeUp;
        var swipeD = SwipeUtil.swipeDown;

        if (controls.UI_UP_P || swipeU) {
            opSel_Value += 5;
            if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
        }
        if (controls.UI_DOWN_P || swipeD) {
            opSel_Value -= 5;
            if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
        }

        if (opSel_Value > 100) opSel_Value = 100;
        if (opSel_Value < 0) opSel_Value = 0;
        
        if (oldValue != opSel_Value) updateOpacityUI();

        if (controls.ACCEPT_P) {
            saveOpacitySelection();
        }
    }

    function createVolumeOption(labelText:String, saveKey:String, descStr:String) {
        var curVal:String = getSavedString(saveKey, "100%");
        if (curVal.indexOf("%") == -1) curVal += "%";
        var item = createOptionBase(labelText, saveKey, curVal, descStr, true);
        var menuInst = this;
        item.fire = function(self:Dynamic) {
                menuInst.primeOptionFire(self);
                menuInst.openVolumeSelector(self.key);
            };
        optionItems.push(item);
    }

    public function openVolumeSelector(saveKey:String) {
        isVolMenuOpen = true; 
        volSel_SaveKey = saveKey;
        
        var curVal = "100";
            var fetched = Save.instance.modOptions.get(saveKey);
            if (fetched != null) curVal = StringTools.replace(Std.string(fetched), "%", "");
        
        volSel_Value = Std.parseInt(curVal);
        if (volSel_Value == null) volSel_Value = 100;
        
        volSel_Group = createOverlayGroup("ADJUST VOLUME (ESC TO CANCEL)");
        var cY = halfScreenH;
        var cX = panelWidth / 2;
        
        volSel_Up = makeOverlayText(volSel_Group, cX - 50, cY - 100, 100, "/\\", 50, FlxColor.YELLOW, "center");
        volSel_Down = makeOverlayText(volSel_Group, cX - 50, cY + 50, 100, "\\/", 50, FlxColor.YELLOW, "center");
        volSel_TxtVal = makeOverlayText(volSel_Group, cX - 100, cY - 40, 200, "100%", 70, FlxColor.WHITE, "center", true);

        updateVolumeUI();
    }

    function updateVolumeUI() {
        if (volSel_Group == null || volSel_TxtVal == null) return;
        var nextText = Std.string(volSel_Value) + "%";
        if (volSel_TxtVal.text != nextText) volSel_TxtVal.text = nextText;
    }

    function saveVolumeSelection() {
        var finalStr = Std.string(volSel_Value) + "%";
        Save.instance.modOptions.set(volSel_SaveKey, finalStr);
        for (it in optionItems) it.lockedState = null;
        Save.instance.flush();
        
        if (descTextDisplay != null && optionItems.length > 0 && selectedIndex >= 0) {
            var selItem = optionItems[selectedIndex];
            if (selItem.textDisplay != null) {
                selItem.textDisplay.text = finalStr;
            }
        }

        if (sndOn != null) FlxG.sound.play(sndOn, 0.6);
        closeVolumeSelector();
        
        updatePreviews();
    }

    function closeVolumeSelector() {
        if (volSel_Group != null) {
            remove(volSel_Group);
            volSel_Group.destroy();
            volSel_Group = null;
        }
        isVolMenuOpen = false;
    }

    function handleVolumeInput(elapsed:Float) {
        var tX:Float = FlxG.mouse.screenX;
        var tY:Float = FlxG.mouse.screenY;
        var tJustPressed = false;
        
        if (FlxG.onMobile) {
            tJustPressed = TouchUtil.justPressed;
            if (TouchUtil.touch != null) { tX = TouchUtil.touch.screenX; tY = TouchUtil.touch.screenY; }
        } else {
            tJustPressed = FlxG.mouse.justPressed;
        }
        
        var oldVol = volSel_Value;

        if (tJustPressed) {
            if (tX >= volSel_Up.x - 40 && tX <= volSel_Up.x + volSel_Up.width + 40 &&
                tY >= volSel_Up.y - 40 && tY <= volSel_Up.y + volSel_Up.height + 40) {
                volSel_Value += 5; holdTimer = 0.1;
            }
            else if (tX >= volSel_Down.x - 40 && tX <= volSel_Down.x + volSel_Down.width + 40 &&
                     tY >= volSel_Down.y - 40 && tY <= volSel_Down.y + volSel_Down.height + 40) {
                volSel_Value -= 5; holdTimer = 0.1;
            }
        }

        if (FlxG.mouse != null && FlxG.mouse.wheel != 0) {
            volSel_Value += FlxG.mouse.wheel * 5;
        }

        var swipeU = SwipeUtil.swipeUp;
        var swipeD = SwipeUtil.swipeDown;

        if (controls.UI_UP_P || swipeU) {
            volSel_Value += 5;
        }
        if (controls.UI_DOWN_P || swipeD) {
            volSel_Value -= 5;
        }

        if (volSel_Value > 100) volSel_Value = 100;
        if (volSel_Value < 0) volSel_Value = 0;
        
        if (oldVol != volSel_Value) {
            if (FlxG.sound != null) {
                if (sndHit != null) FlxG.sound.play(sndHit, volSel_Value / 100.0);
            }
            updateVolumeUI();
            HapticUtil.vibrate(0, 0.01, 0.15, 0.1);
        }

        if (controls.ACCEPT_P) {
            saveVolumeSelection();
        }
    }

    function createTimeOption(labelText:String, saveKey:String, descStr:String) {
        var item = createOptionBase(labelText, saveKey, getSavedString(saveKey, "20:00"), descStr, true);
        var menuInst = this;
        item.fire = function(self:Dynamic) {
                menuInst.primeOptionFire(self);
                menuInst.openTimeSelector(self.key, self.textDisplay);
            };
        optionItems.push(item);
    }

    function createFontOption(labelText:String, saveKey:String, descStr:String) {
        var item = createOptionBase(labelText, saveKey, "", descStr, false);
        var menuInst = this;
        item.fire = function(self:Dynamic) {
                menuInst.primeOptionFire(self);
                menuInst.openFontSelector(self.key, null);
            };
        optionItems.push(item);
    }

    public function openTimeSelector(saveKey:String, textRef:FlxText) {
        isTimeMenuOpen = true; 
        tSel_SaveKey = saveKey;
        
        var curVal = "20:00";
            var fetched = Save.instance.modOptions.get(saveKey);
            if (fetched != null) curVal = Std.string(fetched);
        
        tSel_Hour = 20; 
        tSel_Min = 0;
        if (curVal != null && curVal.indexOf(":") != -1) {
            var colonIdx = curVal.indexOf(":");
            if (colonIdx != -1) {
                var pSH = Std.parseInt(curVal.substr(0, colonIdx));
                var pSM = Std.parseInt(curVal.substr(colonIdx + 1));
                if (pSH != null) tSel_Hour = pSH;
                if (pSM != null) tSel_Min = pSM;
            }
        }
        
        tSel_IsMin = false;
        
        tSel_Group = createOverlayGroup("ADJUST CLOCK", FlxG.onMobile ? "SWIPE TO MOVE & CHANGE  |  TAP BACK BUTTON TO SAVE" : "SWIPE TO MOVE & CHANGE  |  ENTER TO SAVE  |  ESC TO CANCEL");
        var cY = halfScreenH;
        var cX = panelWidth / 2;
        
        tSel_UpHour = makeOverlayText(tSel_Group, cX - 110, cY - 100, 80, "/\\", 50, FlxColor.WHITE, "center");
        tSel_DownHour = makeOverlayText(tSel_Group, cX - 110, cY + 50, 80, "\\/", 50, FlxColor.WHITE, "center");
        tSel_UpMin = makeOverlayText(tSel_Group, cX + 30, cY - 100, 80, "/\\", 50, FlxColor.WHITE, "center");
        tSel_DownMin = makeOverlayText(tSel_Group, cX + 30, cY + 50, 80, "\\/", 50, FlxColor.WHITE, "center");
        tSel_TxtHour = makeOverlayText(tSel_Group, cX - 120, cY - 40, 100, "00", 70, FlxColor.WHITE, "center", true);
        tSel_TxtColon = makeOverlayText(tSel_Group, cX - 20, cY - 45, 40, ":", 70, FlxColor.WHITE, "center", true);
        tSel_TxtMin = makeOverlayText(tSel_Group, cX + 20, cY - 40, 100, "00", 70, FlxColor.WHITE, "center", true);
        
        updateTimeUI();
    }

    function updateTimeUI() {
        if (tSel_Group == null) return;
        var hrStr = tSel_Hour < 10 ? "0" + tSel_Hour : Std.string(tSel_Hour);
        var minStr = tSel_Min < 10 ? "0" + tSel_Min : Std.string(tSel_Min);
        var hourColor = !tSel_IsMin ? FlxColor.YELLOW : FlxColor.WHITE;
        var minColor = tSel_IsMin ? FlxColor.YELLOW : FlxColor.WHITE;

        if (tSel_TxtHour != null) {
            if (tSel_TxtHour.text != hrStr) tSel_TxtHour.text = hrStr;
            if (tSel_TxtHour.color != hourColor) tSel_TxtHour.color = hourColor;
        }
        if (tSel_TxtMin != null) {
            if (tSel_TxtMin.text != minStr) tSel_TxtMin.text = minStr;
            if (tSel_TxtMin.color != minColor) tSel_TxtMin.color = minColor;
        }
        if (tSel_UpHour != null && tSel_UpHour.color != hourColor) tSel_UpHour.color = hourColor;
        if (tSel_DownHour != null && tSel_DownHour.color != hourColor) tSel_DownHour.color = hourColor;
        if (tSel_UpMin != null && tSel_UpMin.color != minColor) tSel_UpMin.color = minColor;
        if (tSel_DownMin != null && tSel_DownMin.color != minColor) tSel_DownMin.color = minColor;
    }

    function saveTimeSelection() {
        var hrStr = tSel_Hour < 10 ? "0" + tSel_Hour : Std.string(tSel_Hour);
        var minStr = tSel_Min < 10 ? "0" + tSel_Min : Std.string(tSel_Min);
        var finalStr = hrStr + ":" + minStr;
        
        Save.instance.modOptions.set(tSel_SaveKey, finalStr);
        for (it in optionItems) it.lockedState = null;
        Save.instance.flush();
        
        if (descTextDisplay != null && optionItems.length > 0 && selectedIndex >= 0) {
            var selItem = optionItems[selectedIndex];
            if (selItem.textDisplay != null) {
                selItem.textDisplay.text = finalStr;
                selItem.textDisplay.color = 0xFF00FF00;
            }
        }

        if (sndOn != null) FlxG.sound.play(sndOn, 0.6);
        closeTimeSelector();
        
        updatePreviews();
    }

    function closeTimeSelector() {
        if (tSel_Group != null) {
            remove(tSel_Group);
            tSel_Group.destroy();
            tSel_Group = null;
        }
        isTimeMenuOpen = false;
    }

    function handleTimeInput(elapsed:Float) {
        var tX:Float = FlxG.mouse.screenX;
        var tY:Float = FlxG.mouse.screenY;
        var tJustPressed = false;
        
        if (FlxG.onMobile) {
            tJustPressed = TouchUtil.justPressed;
            if (TouchUtil.touch != null) { tX = TouchUtil.touch.screenX; tY = TouchUtil.touch.screenY; }
        } else {
            tJustPressed = FlxG.mouse.justPressed;
        }

        var oldHour = tSel_Hour;
        var oldMin = tSel_Min;
        var oldIsMin = tSel_IsMin;

        if (tJustPressed) {
            if (tX >= tSel_UpHour.x - 40 && tX <= tSel_UpHour.x + tSel_UpHour.width + 40 &&
                tY >= tSel_UpHour.y - 40 && tY <= tSel_UpHour.y + tSel_UpHour.height + 40) {
                tSel_IsMin = false; tSel_Hour++; holdTimer = 0.1;
                if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
            } 
            else if (tX >= tSel_DownHour.x - 40 && tX <= tSel_DownHour.x + tSel_DownHour.width + 40 &&
                     tY >= tSel_DownHour.y - 40 && tY <= tSel_DownHour.y + tSel_DownHour.height + 40) {
                tSel_IsMin = false; tSel_Hour--; holdTimer = 0.1;
                if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
            }
            else if (tX >= tSel_UpMin.x - 40 && tX <= tSel_UpMin.x + tSel_UpMin.width + 40 &&
                     tY >= tSel_UpMin.y - 40 && tY <= tSel_UpMin.y + tSel_UpMin.height + 40) {
                tSel_IsMin = true; tSel_Min++; holdTimer = 0.1;
                if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
            }
            else if (tX >= tSel_DownMin.x - 40 && tX <= tSel_DownMin.x + tSel_DownMin.width + 40 &&
                     tY >= tSel_DownMin.y - 40 && tY <= tSel_DownMin.y + tSel_DownMin.height + 40) {
                tSel_IsMin = true; tSel_Min--; holdTimer = 0.1;
                if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
            }
        }

        if (FlxG.mouse != null && FlxG.mouse.wheel != 0) {
            if (!tSel_IsMin) tSel_Hour += FlxG.mouse.wheel;
            else tSel_Min += FlxG.mouse.wheel;
            if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
        }

        var swipeL = SwipeUtil.swipeLeft;
        var swipeR = SwipeUtil.swipeRight;
        var swipeU = SwipeUtil.swipeUp;
        var swipeD = SwipeUtil.swipeDown;

        if (controls.UI_LEFT_P || swipeL) {
            tSel_IsMin = !tSel_IsMin;
            if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
        }
        if (controls.UI_RIGHT_P || swipeR) {
            tSel_IsMin = !tSel_IsMin;
            if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
        }

        if (controls.UI_UP_P || swipeU) {
            if (!tSel_IsMin) tSel_Hour++; else tSel_Min++;
            if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
        }
        if (controls.UI_DOWN_P || swipeD) {
            if (!tSel_IsMin) tSel_Hour--; else tSel_Min--;
            if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
        }

        if (tSel_Hour > 23) tSel_Hour = 0;
        if (tSel_Hour < 0) tSel_Hour = 23;
        if (tSel_Min > 59) tSel_Min = 0;
        if (tSel_Min < 0) tSel_Min = 59;
        
        if (oldHour != tSel_Hour || oldMin != tSel_Min || oldIsMin != tSel_IsMin) updateTimeUI();

        if (controls.ACCEPT_P) {
            saveTimeSelection();
        }
    }

    public function openFontSelector(saveKey:String, textRef:FlxText) {
        isFontMenuOpen = true;
        currentFontSaveKey = saveKey;
        currentFontTextRef = textRef;
        fontSelectedIndex = 0;
        fontTargetScrollY = 0;
        fontItems = [];
        fontLastSelectedIndex = -1;
        fontVisibleStart = -1;
        fontVisibleEnd = -1;
        lastFontVisibleStart = -1;
        lastFontVisibleEnd = -1;

        fontBgGroup = new FlxSpriteGroup(0, 0);
        fontBgGroup.x = panelOnLeft ? -panelWidth : screenW;
        fontBgGroup.cameras = [optionCam];
        add(fontBgGroup);

        var bg = new FlxSprite(0, 0).makeGraphic(panelWidth, Std.int(screenH), 0xFF000000);
        bg.alpha = 0.95;
        bg.scrollFactor.set(0, 0);
        fontBgGroup.add(bg);

        var fTitle = new FlxText(10, 10, panelWidth - 20, "SELECT FONT (ESC TO CANCEL)", 32);
            fTitle.setFormat(menuFont, 32, FlxColor.YELLOW, "center", FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
            fTitle.antialiasing = false;
        fTitle.scrollFactor.set(0, 0);
        fontBgGroup.add(fTitle);

        fontItemsGroup = new FlxSpriteGroup(0, 60);
        fontItemsGroup.x = panelOnLeft ? -panelWidth : screenW;
        fontItemsGroup.cameras = [optionCam];
        add(fontItemsGroup);

        var curSavedFont:String = "vcr.ttf";
            var fetchedVal = Save.instance.modOptions.get(saveKey);
            if (fetchedVal != null) curSavedFont = Std.string(fetchedVal);
        fontActiveFile = curSavedFont;

        var fY:Float = 0;

        var famDataList:Array<Dynamic> = [];
        famDataList = apiRef.preloadedFamiliesData; 

        for (famData in famDataList) {
            var fam = famData.name;
            var variants:Array<Dynamic> = famData.variants;
            
            if (variants.length == 1) {
                var v = variants[0];
                var displayName = v.family;
                if (v.variant != "Regular" && v.variant != "Default") displayName += " " + v.variant;

                var fTxt = new FlxText(30, 0, panelWidth - 60, displayName, 22);
                fTxt.setFormat(v.path, 22, FlxColor.WHITE, "left");
                
                var txtH:Float = 22;
                txtH = fTxt.height;
                
                var boxHeight:Float = txtH + 40;
                if (boxHeight < 60) boxHeight = 60;

                fTxt.y = fY + (boxHeight - txtH) / 2;

                var itemBg = new FlxSprite(0, fY).makeGraphic(panelWidth, Std.int(boxHeight), FlxColor.WHITE);
                itemBg.alpha = 0.0;
                fontItemsGroup.add(itemBg);
                fontItemsGroup.add(fTxt);

                fontItems.push({
                    bg: itemBg,
                    text: fTxt,
                    fileName: v.file,
                    y: fY,
                    height: boxHeight
                });

                fY += boxHeight + 6;
            } else {
                var famTxt = new FlxText(30, fY + 10, panelWidth - 60, fam, 22);
                famTxt.setFormat("VCR OSD Mono", 22, 0xFFDDDDDD, "left");
                fontItemsGroup.add(famTxt);
                fY += famTxt.height + 10;

                for (v in variants) {
                    var fTxt = new FlxText(50, 0, panelWidth - 80, v.variant, 20);
                    fTxt.setFormat(v.path, 20, FlxColor.WHITE, "left");
                    
                    var txtH:Float = 20;
                    txtH = fTxt.height;
                    
                    var boxHeight:Float = txtH + 40;
                    if (boxHeight < 60) boxHeight = 60;

                    fTxt.y = fY + (boxHeight - txtH) / 2;

                    var itemBg = new FlxSprite(0, fY).makeGraphic(panelWidth, Std.int(boxHeight), FlxColor.WHITE);
                    itemBg.alpha = 0.0;
                    fontItemsGroup.add(itemBg);
                    fontItemsGroup.add(fTxt);

                    fontItems.push({
                        bg: itemBg,
                        text: fTxt,
                        fileName: v.file,
                        y: fY,
                        height: boxHeight
                    });

                    fY += boxHeight + 4;
                }
            }
        }

        fontMaxScroll = Math.max(0, fY - screenH + 150);

        for (i in 0...fontItems.length) {
            if (fontItems[i].fileName == curSavedFont) {
                fontSelectedIndex = i;
                break;
            }
        }
        
        changeFontSelection(0);
    }

    function closeFontSelector() {
        if (fontBgGroup != null) {
            remove(fontBgGroup);
            fontBgGroup.destroy();
            fontBgGroup = null;
        }
        if (fontItemsGroup != null) {
            remove(fontItemsGroup);
            fontItemsGroup.destroy();
            fontItemsGroup = null;
        }
        fontItems = [];
        isFontMenuOpen = false;
        fontVisibleStart = -1;
        fontVisibleEnd = -1;
        lastFontVisibleStart = -1;
        lastFontVisibleEnd = -1;
        
        if (descBg != null) descBg.visible = !panelHidden;
        if (descTextDisplay != null) descTextDisplay.visible = !panelHidden;
        if (descValueText != null) descValueText.visible = !panelHidden;
    }

    function selectCurrentFont() {
        if (fontItems.length > 0 && fontSelectedIndex >= 0 && fontSelectedIndex < fontItems.length) {
            var selFile = fontItems[fontSelectedIndex].fileName;
            Save.instance.modOptions.set(currentFontSaveKey, selFile);
            for (it in optionItems) it.lockedState = null;
            Save.instance.flush();
            fontActiveFile = selFile;
            
            if (descTextDisplay != null && optionItems.length > 0 && selectedIndex >= 0) {
                var selItem = optionItems[selectedIndex];
                descTextDisplay.text = selItem.desc;
                if (descValueText != null) {
                    descValueText.text = formatLongValue(selFile);
                    var targetColor = getValueColor(descValueText.text);
                    if (descValueText.color != targetColor) descValueText.color = targetColor;
                    descValueSlideTimer = 0.0;
                }
                
                if (selItem.textDisplay != null) {
                    selItem.textDisplay.text = formatShortValue(selFile);
                    var tColor = getValueColor(selItem.textDisplay.text);
                    if (selItem.textDisplay.color != tColor) selItem.textDisplay.color = tColor;
                }
                descSlideVerticalTimer = 0.0;
            }

            if (sndOn != null) FlxG.sound.play(sndOn, 0.6);
            HapticUtil.vibrate(0, 0.01, 0.3, 0.1);
            
            updatePreviews();
        }
        closeFontSelector();
    }

    function applyFontItemState(idx:Int):Void {
        if (idx < 0 || idx >= fontItems.length) return;
        var item = fontItems[idx];
        var targetAlpha = (idx == fontSelectedIndex) ? 0.3 : 0.0;
        if (item.bg != null && item.bg.alpha != targetAlpha) item.bg.alpha = targetAlpha;
        if (item.text != null) {
            var targetColor = (item.fileName == fontActiveFile) ? FlxColor.YELLOW : FlxColor.WHITE;
            if (item.text.color != targetColor) item.text.color = targetColor;
        }
    }

    function changeFontSelection(change:Int = 0) {
        var prevIndex = fontSelectedIndex;
        fontSelectedIndex += change;
        if (fontSelectedIndex < 0) fontSelectedIndex = fontItems.length - 1;
        if (fontSelectedIndex >= fontItems.length) fontSelectedIndex = 0;

        if (change == 0 || fontLastSelectedIndex < 0) {
            for (i in 0...fontItems.length) {
                applyFontItemState(i);
            }
        } else {
            applyFontItemState(prevIndex);
            applyFontItemState(fontSelectedIndex);
        }
        fontLastSelectedIndex = fontSelectedIndex;

        if (change != 0) {
            if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
            HapticUtil.vibrate(0, 0.01, 0.15, 0.1);
        }

        if (fontItems.length > 0) {
            var targetY = fontItems[fontSelectedIndex].y - halfScreenH + 60;
            fontTargetScrollY = Math.max(0, Math.min(fontMaxScroll, targetY));
        }
    }

    function setFontItemVisible(item:Dynamic, visible:Bool):Void {
        if (item == null || item.bg == null) return;
        if (item.bg.visible != visible) item.bg.visible = visible;
        if (item.text != null && item.text.visible != visible) item.text.visible = visible;
    }

    function updateFontItemVisibility(grpY:Float, viewH:Float):Void {
        var count = fontItems.length;
        if (count <= 0) return;

        var topY = -100.0 - grpY;
        var bottomY = viewH + 100.0 - grpY;
        var startIdx = lastFontVisibleStart < 0 ? 0 : lastFontVisibleStart;
        if (startIdx >= count) startIdx = count - 1;

        while (startIdx > 0) {
            var prevItem = fontItems[startIdx - 1];
            if (prevItem.y + prevItem.height < topY) break;
            startIdx--;
        }

        while (startIdx < count) {
            var curItem = fontItems[startIdx];
            if (curItem.y + curItem.height >= topY) break;
            setFontItemVisible(curItem, false);
            startIdx++;
        }

        var endIdx = startIdx;
        while (endIdx < count) {
            var endItem = fontItems[endIdx];
            if (endItem.y > bottomY) break;
            endIdx++;
        }
        endIdx--;

        fontVisibleStart = startIdx;
        fontVisibleEnd = endIdx;

        if (lastFontVisibleStart < 0) {
            for (i in 0...count) {
                if (i < fontVisibleStart || i > fontVisibleEnd) setFontItemVisible(fontItems[i], false);
            }
        } else {
            var stopIdx = lastFontVisibleEnd + 1;
            for (i in lastFontVisibleStart...stopIdx) {
                if ((i < fontVisibleStart || i > fontVisibleEnd) && i >= 0 && i < count) {
                    setFontItemVisible(fontItems[i], false);
                }
            }
        }

        if (fontVisibleEnd >= fontVisibleStart) {
            var stopVisible = fontVisibleEnd + 1;
            for (i in fontVisibleStart...stopVisible) {
                setFontItemVisible(fontItems[i], true);
            }
        }

        lastFontVisibleStart = fontVisibleStart;
        lastFontVisibleEnd = fontVisibleEnd;
    }

    

    
    function updateTextSlide(txt:FlxText, maxWidth:Float, timer:Float) {
        if (txt == null) return;
        if (txt.offset == null) txt.offset = new FlxPoint(0, 0);
        
        if (txt.wordWrap || txt.width <= maxWidth) {
            if (txt.offset.x != 0 || txt.clipRect != null) {
                txt.offset.x = 0;
                txt.clipRect = null;
            }
            return;
        }

        var overflow = txt.width - maxWidth; 
        var speed = 40.0; 
        var slideDuration = overflow / speed;
        var cycle = 1.0 + slideDuration + 1.0 + slideDuration;
        
        var t = timer % cycle;
        var currentOffset = 0.0;
        
        if (t < 1.0) {
            currentOffset = 0.0;
        } else if (t < 1.0 + slideDuration) {
            var p = (t - 1.0) / slideDuration;
            var ease = -(Math.cos(Math.PI * p) - 1) / 2;
            currentOffset = overflow * ease;
        } else if (t < 2.0 + slideDuration) {
            currentOffset = overflow;
        } else {
            var p = (t - (2.0 + slideDuration)) / slideDuration;
            var ease = -(Math.cos(Math.PI * p) - 1) / 2;
            currentOffset = overflow * (1.0 - ease);
        }
        
        if (txt.clipRect == null || Math.abs(txt.offset.x - currentOffset) > 0.1) {
            txt.offset.x = currentOffset;

            if (txt.clipRect == null) {
                txt.clipRect = new FlxRect(currentOffset, 0, maxWidth, txt.height + 5);
            } else {
                var r = txt.clipRect;
                r.x = currentOffset;
                txt.clipRect = r;
            }
        }
    }

    function updateVerticalTextSlide(txt:FlxText, maxHeight:Float, timer:Float) {
        if (txt == null) return;
        if (txt.offset == null) txt.offset = new FlxPoint(0, 0);
        
        if (txt.height <= maxHeight) {
            if (txt.offset.y != 0 || txt.clipRect != null) {
                txt.offset.y = 0;
                txt.clipRect = null;
            }
            return;
        }

        var overflow = txt.height - maxHeight;
        var speed = 30.0; 
        var slideDuration = overflow / speed;
        var cycle = 2.0 + slideDuration + 2.0 + slideDuration; 
        
        var t = timer % cycle;
        var currentOffset = 0.0;
        
        if (t < 2.0) {
            currentOffset = 0.0;
        } else if (t < 2.0 + slideDuration) {
            var p = (t - 2.0) / slideDuration;
            var ease = -(Math.cos(Math.PI * p) - 1) / 2;
            currentOffset = overflow * ease;
        } else if (t < 4.0 + slideDuration) {
            currentOffset = overflow;
        } else {
            var p = (t - (4.0 + slideDuration)) / slideDuration;
            var ease = -(Math.cos(Math.PI * p) - 1) / 2;
            currentOffset = overflow * (1.0 - ease);
        }
        
        if (txt.clipRect == null || Math.abs(txt.offset.y - currentOffset) > 0.1) {
            txt.offset.y = currentOffset;
            if (txt.clipRect == null) {
                txt.clipRect = new FlxRect(0, currentOffset, txt.width + 5, maxHeight);
            } else {
                var r = txt.clipRect;
                r.y = currentOffset;
                txt.clipRect = r;
            }
        }
    }

    function resetTextSlide(txt:FlxText):Void {
        if (txt == null) return;
        if (txt.offset != null) {
            if (txt.offset.x != 0) txt.offset.x = 0;
            if (txt.offset.y != 0) txt.offset.y = 0;
        }
        if (txt.clipRect != null) txt.clipRect = null;
    }

    function resetItemSlide(idx:Int):Void {
        if (idx < 0 || idx >= optionItems.length) return;
        var item = optionItems[idx];
        if (item == null || item.isHeader) return;
        resetTextSlide(item.labelDisplay);
        resetTextSlide(item.textDisplay);
        item.slideTimer = 0.0;
    }

    function setOptionItemVisible(item:Dynamic, visible:Bool):Void {
        if (item == null || item.bg == null) return;
        if (item.bg.visible != visible) item.bg.visible = visible;
        if (item.labelDisplay != null && item.labelDisplay.visible != visible) item.labelDisplay.visible = visible;
        if (item.textDisplay != null && item.textDisplay.visible != visible) item.textDisplay.visible = visible;
    }

    function hideVisibleRangeOutside(startIdx:Int, endIdx:Int):Void {
        if (lastVisibleStart < 0) return;
        var stopIdx = lastVisibleEnd + 1;
        for (i in lastVisibleStart...stopIdx) {
            if ((i < startIdx || i > endIdx) && i >= 0 && i < optionItems.length) {
                setOptionItemVisible(optionItems[i], false);
            }
        }
    }

    override public function beatHit():Void {
        super.beatHit();
        if (bf != null) bf.dance();
        if (dad != null) dad.dance();
        if (gf != null) gf.dance();
    }

    override public function update(elapsed:Float):Void {
        if (FlxG.sound.music != null && FlxG.sound.music.playing) {
            if (Conductor.instance != null) Conductor.instance.update(FlxG.sound.music.time);
        }

        super.update(elapsed);

        var sw = screenW;
        var sh = screenH;
        var halfH = halfScreenH;

        var backPressed = false;
        #if android
        if (Reflect.hasField(FlxG, "android") && FlxG.android != null) {
            backPressed = FlxG.android.justReleased.BACK;
        }
        #end

        var esc = controls.BACK_P || backPressed;

        if (esc) {
            if (isFontMenuOpen || isTimeMenuOpen || isOpMenuOpen || isVolMenuOpen) {
                if (isFontMenuOpen) selectCurrentFont();
                if (isTimeMenuOpen) saveTimeSelection();
                if (isOpMenuOpen) saveOpacitySelection();
                if (isVolMenuOpen) saveVolumeSelection();
            } else {
                exitMenu();
            }
        }

        if (kssBackButton != null) {
            kssBackButton.visible = !panelHidden;
            var targetBackX = panelOnLeft ? (sw - kssBackButton.width - 15) : 15;
            kssBackButton.x = FlxMath.lerp(kssBackButton.x, targetBackX, elapsed * 12);
        }

        if (!isFontMenuOpen && !isTimeMenuOpen && !isOpMenuOpen && !isVolMenuOpen) {
            if (FlxG.keys.justPressed.TAB) {
                panelHidden = !panelHidden;
            }

            if (FlxG.keys.justPressed.SHIFT && !transitioningSide && !panelHidden) {
                transitioningSide = true;
                transitionTimer = 0.0;
                nextPanelOnLeft = !panelOnLeft;
            }
        }

        var targetMarqueeY:Float = panelHidden ? -50 : 0;
        if (marqueeBg != null) {
            if (Math.abs(marqueeBg.y - targetMarqueeY) > 0.1) marqueeBg.y = FlxMath.lerp(marqueeBg.y, targetMarqueeY, elapsed * 12);
            else marqueeBg.y = targetMarqueeY;
        }

        if (marqueeText1 != null && marqueeText2 != null) {
            marqueeOffset -= marqueeSpeed * elapsed;
            if (marqueeOffset <= -marqueeText1.width) {
                marqueeOffset += marqueeText1.width;
            }

            marqueeText1.x = marqueeOffset;
            marqueeText2.x = marqueeOffset + marqueeText1.width;

            if (marqueeBg != null) {
                marqueeText1.y = marqueeBg.y + 6;
                marqueeText2.y = marqueeBg.y + 6;
            }
        }

        if (!isDragging) {
            if (Math.abs(curSelectedFloat - selectedIndex) > 0.001) curSelectedFloat = FlxMath.lerp(curSelectedFloat, selectedIndex, elapsed * 10);
            else curSelectedFloat = selectedIndex;
            if (Math.abs(dragOffsetY) > 0.001) dragOffsetY = FlxMath.lerp(dragOffsetY, 0, elapsed * 15);
            else dragOffsetY = 0;
        }
        
        var targetXBase:Float = 0;
        var targetDescX:Float = 0;
        var targetFadeX:Float = 0;

        if (transitioningSide) {
            transitionTimer += elapsed;
            targetXBase = panelOnLeft ? -smallCapsuleWidth - 200 : sw + 200;
            targetDescX = panelOnLeft ? sw + 200 : -largeCapsuleWidth - 200;
            targetFadeX = panelOnLeft ? -panelWidth - 200 : sw + 200;

            if (transitionTimer > 0.3) {
                panelOnLeft = nextPanelOnLeft;
                transitioningSide = false;
                
                var startXBase = panelOnLeft ? -smallCapsuleWidth - 200 : sw + 200;
                var startDescX = panelOnLeft ? sw + 200 : -largeCapsuleWidth - 200;
                var startFadeX = panelOnLeft ? -panelWidth - 200 : sw + 200;
                
                if (descBg != null) descBg.x = startDescX;
                if (capsuleFadeBg != null) {
                    capsuleFadeBg.x = startFadeX;
                    capsuleFadeBg.flipX = panelOnLeft;
                }
                for (i in 0...optionItems.length) {
                    if (optionItems[i].bg != null) optionItems[i].bg.x = startXBase;
                }
                
                if (previewHitbox != null) {
                    var previewAreaW = sw - panelWidth;
                    var tX = panelOnLeft ? panelWidth : 0;
                    if (previewHitbox.x != tX) {
                        previewHitbox.x = tX;
                        previewHitbox.setGraphicSize(Std.int(previewAreaW), Std.int(sh));
                        previewHitbox.updateHitbox();
                    }
                }
            }
        } else {
            targetXBase = panelOnLeft ? -50 : (sw - smallCapsuleWidth + 40);
            targetDescX = panelOnLeft ? (sw - largeCapsuleWidth - 20) : 20;
            targetFadeX = panelOnLeft ? 0 : (sw - panelWidth + 1);

            if (panelHidden) {
                targetXBase = panelOnLeft ? -smallCapsuleWidth - 200 : sw + 200;
                targetDescX = panelOnLeft ? sw + 200 : -largeCapsuleWidth - 200;
                targetFadeX = panelOnLeft ? -panelWidth - 200 : sw + 200;
            }
        }

        if (capsuleFadeBg != null) {
            if (Math.abs(capsuleFadeBg.x - targetFadeX) > 0.1) capsuleFadeBg.x = FlxMath.lerp(capsuleFadeBg.x, targetFadeX, elapsed * 12);
            else capsuleFadeBg.x = targetFadeX;
            if (capsuleFadeBg.flipX != panelOnLeft) capsuleFadeBg.flipX = panelOnLeft;
        }

        var screenTop = -150.0;
        var screenBottom = sh + 150.0;
        var itemCount = optionItems.length;

        if (lastSelectionIndex != selectedIndex) {
            resetItemSlide(lastSelectionIndex);
            lastSelectionIndex = selectedIndex;
        }

        if (itemCount > 0) {
            var approxSpan:Int = Std.int(Math.ceil((halfH + 240.0 + Math.abs(dragOffsetY)) / capsuleSpacing)) + 2;
            visibleStart = Std.int(Math.floor(curSelectedFloat)) - approxSpan;
            visibleEnd = Std.int(Math.ceil(curSelectedFloat)) + approxSpan;
            if (visibleStart < 0) visibleStart = 0;
            if (visibleEnd >= itemCount) visibleEnd = itemCount - 1;

            if (lastVisibleStart != visibleStart || lastVisibleEnd != visibleEnd) {
                if (lastVisibleStart < 0) {
                    for (i in 0...itemCount) {
                        if (i < visibleStart || i > visibleEnd) setOptionItemVisible(optionItems[i], false);
                    }
                } else {
                    hideVisibleRangeOutside(visibleStart, visibleEnd);
                }
                lastVisibleStart = visibleStart;
                lastVisibleEnd = visibleEnd;
            }

            var rangeEnd = visibleEnd + 1;
            for (i in visibleStart...rangeEnd) {
                var item = optionItems[i];
                if (item == null || item.bg == null) continue;

                var bg = item.bg;
                var label = item.labelDisplay;
                var value = item.textDisplay;
                var diff = i - curSelectedFloat;
                var targetY = halfH + (diff * capsuleSpacing) - 50 + dragOffsetY;
                var wasVisible = bg.visible;
                var isVisible = (targetY > screenTop && targetY < screenBottom);
                setOptionItemVisible(item, isVisible);

                if (!isVisible) {
                    item.slideTimer = 0.0;
                    continue;
                }

                var curveOffset = Math.abs(diff) * 45;
                var targetX = panelOnLeft ? (targetXBase - curveOffset) : (targetXBase + curveOffset);
                var isSel = i == selectedIndex;
                if (!item.isHeader && isSel) targetX += panelOnLeft ? 40 : -40;

                if (isDragging || !wasVisible) {
                    bg.x = targetX;
                    bg.y = targetY;
                } else {
                    if (Math.abs(bg.x - targetX) > 0.1) bg.x = FlxMath.lerp(bg.x, targetX, elapsed * 12); else bg.x = targetX;
                    if (Math.abs(bg.y - targetY) > 0.1) bg.y = FlxMath.lerp(bg.y, targetY, elapsed * 12); else bg.y = targetY;
                }

                if (item.isHeader) {
                    if (label != null) {
                        if (item.labelWidth == null) item.labelWidth = label.width;
                        if (item.labelHeight == null) item.labelHeight = label.height;
                        label.x = bg.x + (bg.width - item.labelWidth) / 2;
                        label.y = bg.y + (bg.height - item.labelHeight) / 2;
                    }
                } else {
                    var targetAlpha = isSel ? 1.0 : 0.6;
                    var targetColor = isSel ? FlxColor.YELLOW : FlxColor.WHITE;
                    
                    if (item.lockedState == null && apiRef != null) item.lockedState = apiRef.isOptionLocked(item.key);
                    if (item.lockedState == true) {
                        targetAlpha *= 0.4;
                        targetColor = FlxColor.GRAY;
                        if (value != null && value.text != "LCK") {
                            value.text = "LCK";
                            value.color = FlxColor.RED;
                        }
                    } else {
                        if (value != null && value.text == "LCK") {
                            var rawVal = Save.instance.modOptions.get(item.key);
                            if (rawVal == null) rawVal = "Off";
                            value.text = formatShortValue(Std.string(rawVal));
                            value.color = getValueColor(value.text);
                            item.valueWidth = value.width;
                        }
                    }

                    if (isSel) item.slideTimer += elapsed; else item.slideTimer = 0.0;

                    if (bg.alpha != 1.0) bg.alpha = 1.0;
                    if (value != null && value.alpha != targetAlpha) value.alpha = targetAlpha;
                    if (label != null) {
                        if (label.color != targetColor) label.color = targetColor;
                        if (label.alpha != targetAlpha) label.alpha = targetAlpha;
                    }
                    
                    if (item.errorTimer != null && item.errorTimer > 0) {
                        item.errorTimer -= elapsed * 8;
                        if (item.errorTimer < 0) item.errorTimer = 0;

                        var flashOn = (Math.floor(item.errorTimer * 10) % 2 == 0);
                        var targetBgColor = flashOn ? FlxColor.WHITE : FlxColor.RED;
                        var targetLblColor = flashOn ? FlxColor.RED : FlxColor.WHITE;

                        if (bg.color != targetBgColor) bg.color = targetBgColor;
                        if (label != null && label.color != targetLblColor) label.color = targetLblColor;
                        
                        bg.x += FlxG.random.float(-8, 8);
                    } else if (item.flashTimer != null && item.flashTimer > 0) {
                        item.flashTimer -= elapsed * 8;
                        if (item.flashTimer < 0) item.flashTimer = 0;
                        
                        var flashOn = (Math.floor(item.flashTimer * 10) % 2 == 0);
                        var targetBgColor = flashOn ? FlxColor.WHITE : FlxColor.YELLOW;
                        var targetLblColor = flashOn ? FlxColor.YELLOW : FlxColor.WHITE;

                        if (bg.color != targetBgColor) bg.color = targetBgColor;
                        if (label != null && label.color != targetLblColor) label.color = targetLblColor;
                    } else {
                        var targetBgColor = isSel ? FlxColor.WHITE : 0xFF555555;
                        if (bg.color != targetBgColor) bg.color = targetBgColor;
                    }

                    if (label != null) {
                        label.x = bg.x + labelOffsetX;
                        label.y = bg.y + labelOffsetY;
                    }

                    if (value != null) {
                        if (item.valueWidth == null) item.valueWidth = value.width;
                        var cachedValW = item.valueWidth;
                        var vX = bg.x + bg.width - valueOffsetX - cachedValW;
                        if (cachedValW > valueMaxWidth) {
                            vX = bg.x + bg.width - valueOffsetX - valueMaxWidth;
                        }
                        value.x = vX;
                        value.y = bg.y + valueOffsetY;
                    }

                    if (isSel) {
                        updateTextSlide(label, labelMaxWidth, item.slideTimer);
                        if (value != null) updateTextSlide(value, valueMaxWidth, item.slideTimer);
                    }
                }
            }
        }

        if (isFontMenuOpen) {
            var targetFontX = panelOnLeft ? 0 : (sw - panelWidth);
            if (fontBgGroup != null) fontBgGroup.x = FlxMath.lerp(fontBgGroup.x, targetFontX, elapsed * 12);
            if (fontItemsGroup != null) {
                fontItemsGroup.x = FlxMath.lerp(fontItemsGroup.x, targetFontX, elapsed * 12);
                fontItemsGroup.y = FlxMath.lerp(fontItemsGroup.y, 55 - fontTargetScrollY, elapsed * 15);
                updateFontItemVisibility(fontItemsGroup.y, sh);
            }

            if (holdTimer > 0) holdTimer -= elapsed;
            if (holdTimer <= 0) handleFontInput(elapsed);
            return; 
        }

        if (isTimeMenuOpen) {
            var targetFontX = panelOnLeft ? 0 : (sw - panelWidth);
            if (tSel_Group != null) tSel_Group.x = FlxMath.lerp(tSel_Group.x, targetFontX, elapsed * 12);
            
            if (holdTimer > 0) holdTimer -= elapsed;
            if (holdTimer <= 0) handleTimeInput(elapsed);
            return;
        }

        if (isOpMenuOpen) {
            var targetFontX = panelOnLeft ? 0 : (sw - panelWidth);
            if (opSel_Group != null) opSel_Group.x = FlxMath.lerp(opSel_Group.x, targetFontX, elapsed * 12);
            
            if (holdTimer > 0) holdTimer -= elapsed;
            if (holdTimer <= 0) handleOpacityInput(elapsed);
            return;
        }

        if (isVolMenuOpen) {
            var targetFontX = panelOnLeft ? 0 : (sw - panelWidth);
            if (volSel_Group != null) volSel_Group.x = FlxMath.lerp(volSel_Group.x, targetFontX, elapsed * 12);
            
            if (holdTimer > 0) holdTimer -= elapsed;
            if (holdTimer <= 0) handleVolumeInput(elapsed);
            return;
        }

        var targetDescY:Float = sh - (descBg != null ? descBg.height : 90) - 20;
        
        if (descBg != null) {
            if (Math.abs(descBg.x - targetDescX) > 0.1) descBg.x = FlxMath.lerp(descBg.x, targetDescX, elapsed * 12); else descBg.x = targetDescX;
            if (Math.abs(descBg.y - targetDescY) > 0.1) descBg.y = FlxMath.lerp(descBg.y, targetDescY, elapsed * 12); else descBg.y = targetDescY;
            if (descTextDisplay != null) {
                descTextDisplay.x = descBg.x + descOffsetX;
                descTextDisplay.y = descBg.y + descOffsetY;
            }
            if (descValueText != null) {
                var vX = descBg.x + descBg.width - descValueOffsetX - descValueText.width;
                if (descValueText.width > descValueMaxWidth) {
                    vX = descBg.x + descBg.width - descValueOffsetX - descValueMaxWidth;
                }
                descValueText.x = vX;
                descValueText.y = descBg.y + descValueOffsetY;
            }
        }

        handleInput(elapsed);

        if (!panelHidden && !transitioningSide) {
            descSlideVerticalTimer += elapsed;
            descValueSlideTimer += elapsed;
            
            if (descTextDisplay != null && descBg != null) {
                updateVerticalTextSlide(descTextDisplay, descMaxHeight, descSlideVerticalTimer);
            }
            if (descValueText != null && descBg != null) {
                updateTextSlide(descValueText, descValueMaxWidth, descValueSlideTimer);
            }
        }

        if (holdTimer > 0) holdTimer -= elapsed;
    }

    function changeSelection(change:Int = 0) {
        selectedIndex += change;
        
        if (selectedIndex < 0) selectedIndex = optionItems.length - 1;
        if (selectedIndex >= optionItems.length) selectedIndex = 0;

        if (optionItems[selectedIndex].isHeader) {
            var dir = change >= 0 ? 1 : -1;
            while(optionItems[selectedIndex].isHeader) {
                selectedIndex += dir;
                if (selectedIndex < 0) selectedIndex = optionItems.length - 1;
                if (selectedIndex >= optionItems.length) selectedIndex = 0;
            }
        }

        if (optionItems.length > 0 && selectedIndex >= 0 && selectedIndex < optionItems.length) {
            var selItem = optionItems[selectedIndex];
            if (descTextDisplay != null && !selItem.isHeader) {
                var curVal = "Off";
                var fetchedVal = Save.instance.modOptions.get(selItem.key);
                if (fetchedVal != null) curVal = Std.string(fetchedVal);
                
                descTextDisplay.text = selItem.desc;
                if (descValueText != null) {
                    if (selItem.lockedState == null && apiRef != null) selItem.lockedState = apiRef.isOptionLocked(selItem.key);
                    if (selItem.lockedState == true) {
                        descValueText.text = "LOCKED";
                        var targetColor = FlxColor.RED;
                        if (descValueText.color != targetColor) descValueText.color = targetColor;
                    } else {
                        descValueText.text = formatLongValue(curVal);
                        var targetColor = getValueColor(descValueText.text);
                        if (descValueText.color != targetColor) descValueText.color = targetColor;
                    }
                }
                descSlideVerticalTimer = 0.0;
                descValueSlideTimer = 0.0;
            }
        }

        if (change != 0) {
            if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
            HapticUtil.vibrate(0, 0.01, 0.15, 0.1);
        }
    }

    function handleFontInput(elapsed:Float) {
        var tX:Float = FlxG.mouse.screenX;
        var tY:Float = FlxG.mouse.screenY;
        var tJustPressed = false;
        var tPressed = false;
        var tJustReleased = false;

        if (FlxG.onMobile) {
            tJustPressed = TouchUtil.justPressed;
            tPressed = TouchUtil.pressed;
            tJustReleased = TouchUtil.justReleased;
            if (TouchUtil.touch != null) {
                tX = TouchUtil.touch.screenX;
                tY = TouchUtil.touch.screenY;
            }
        } else {
            tJustPressed = FlxG.mouse.justPressed;
            tPressed = FlxG.mouse.pressed;
            tJustReleased = FlxG.mouse.justReleased;
        }

        var isOverPreviewZone = false;
        if (previewHitbox != null && previewHitbox.exists) {
            if (FlxG.onMobile) {
                isOverPreviewZone = TouchUtil.overlaps(previewHitbox, optionCam);
            } else {
                isOverPreviewZone = FlxG.mouse.overlaps(previewHitbox, optionCam);
            }
        }

        if (tJustPressed) {
            touchStart = tY;
            touchStartX = tX;
            isDragging = false;
            previewHoldTimer = 0.0;
            previewActionFired = false;
        } else if (tPressed) {
            if (Math.abs(tY - touchStart) > 15 || Math.abs(tX - touchStartX) > 15) {
                isDragging = true;
                previewHoldTimer = 0.0;
            }
            if (isDragging) {
                fontTargetScrollY += (touchStart - tY) * 0.5; 
                touchStart = tY; 
            }
            if (isOverPreviewZone && !isDragging && !previewActionFired) {
                previewHoldTimer += elapsed;
                if (previewHoldTimer >= 0.5) {
                    previewActionFired = true;
                    closeFontSelector();
                    if (sndCancel != null) FlxG.sound.play(sndCancel, 0.7);
                }
            }
        } else if (tJustReleased) {
            if (!isDragging && holdTimer <= 0 && !previewActionFired) {
                if (!isOverPreviewZone) {
                    fireFontClickAt();
                }
            }
            isDragging = false;
            previewActionFired = false;
            previewHoldTimer = 0.0;
        }

        if (FlxG.mouse != null && FlxG.mouse.wheel != 0) {
            fontTargetScrollY -= FlxG.mouse.wheel * 80;
        }

        if (fontTargetScrollY < 0) fontTargetScrollY = 0;
        if (fontTargetScrollY > fontMaxScroll) fontTargetScrollY = fontMaxScroll;

        if (controls.UI_UP_P) {
            changeFontSelection(-1);
            holdTimer = 0.1;
        }
        if (controls.UI_DOWN_P) {
            changeFontSelection(1);
            holdTimer = 0.1;
        }
        if (controls.ACCEPT_P) {
            selectCurrentFont();
            holdTimer = 0.2;
        }
    }

    function fireFontClickAt() {
        var clickedItem = false;
        var startIdx = fontVisibleStart < 0 ? 0 : fontVisibleStart;
        var endIdx = fontVisibleEnd < 0 ? fontItems.length - 1 : fontVisibleEnd;
        if (endIdx >= fontItems.length) endIdx = fontItems.length - 1;
        var stopIdx = endIdx + 1;
        for (i in startIdx...stopIdx) {
            var item = fontItems[i];
            if (item.bg != null && item.bg.visible) {
                var isOver = false;
                if (FlxG.onMobile) {
                    isOver = TouchUtil.overlaps(item.bg, optionCam);
                } else {
                    isOver = FlxG.mouse.overlaps(item.bg, optionCam);
                }

                if (isOver) {
                    if (fontSelectedIndex == i) {
                        selectCurrentFont();
                    } else {
                        fontSelectedIndex = i;
                        changeFontSelection(0);
                    }
                    holdTimer = 0.2;
                    clickedItem = true;
                    break;
                }
            }
        }
        
        if (!clickedItem) {
            closeFontSelector();
            if (sndCancel != null) FlxG.sound.play(sndCancel, 0.7);
        }
    }

    function handleInput(elapsed:Float) {
        var tX:Float = FlxG.mouse.screenX;
        var tY:Float = FlxG.mouse.screenY;
        var tJustPressed = false;
        var tPressed = false;
        var tJustReleased = false;

        if (FlxG.onMobile) {
            tJustPressed = TouchUtil.justPressed;
            tPressed = TouchUtil.pressed;
            tJustReleased = TouchUtil.justReleased;
            if (TouchUtil.touch != null) {
                tX = TouchUtil.touch.screenX;
                tY = TouchUtil.touch.screenY;
            }
        } else {
            tJustPressed = FlxG.mouse.justPressed;
            tPressed = FlxG.mouse.pressed;
            tJustReleased = FlxG.mouse.justReleased;
        }

        var isOverBackButton = false;
        if (kssBackButton != null && kssBackButton.visible && kssBackButton.exists) {
            if (FlxG.onMobile) {
                isOverBackButton = TouchUtil.overlaps(kssBackButton, optionCam);
            } else {
                isOverBackButton = FlxG.mouse.overlaps(kssBackButton, optionCam);
            }
        }

        var isOverPreviewZone = false;
        if (previewHitbox != null && previewHitbox.exists) {
            if (FlxG.onMobile) {
                isOverPreviewZone = TouchUtil.overlaps(previewHitbox, optionCam);
            } else {
                isOverPreviewZone = FlxG.mouse.overlaps(previewHitbox, optionCam);
            }
        }

        if (tJustPressed) {
            touchStart = tY;
            touchStartX = tX;
            isDragging = false;
            previewHoldTimer = 0.0;
            previewActionFired = false;
            dragOffsetY = 0.0;
        } else if (tPressed) {
            if (!isDragging && (Math.abs(tY - touchStart) > 15 || Math.abs(tX - touchStartX) > 15)) {
                isDragging = true;
                previewHoldTimer = 0.0;
            }
            if (isDragging && !panelHidden && !transitioningSide) {
                dragOffsetY = (tY - touchStart) * 0.7;
            }
            if (isOverPreviewZone && !isDragging && !previewActionFired) {
                previewHoldTimer += elapsed;
                if (previewHoldTimer >= 0.5) {
                    previewActionFired = true;
                    panelHidden = !panelHidden;
                    if (sndScroll != null) FlxG.sound.play(sndScroll, 0.5);
                }
            }
        } else if (tJustReleased) {
            var hasSwiped = false;
            if (FlxG.onMobile) {
                hasSwiped = SwipeUtil.swipeUp || SwipeUtil.swipeDown || SwipeUtil.swipeLeft || SwipeUtil.swipeRight;
            }
            if (!isDragging && !hasSwiped && holdTimer <= 0 && !previewActionFired) {
                if (isOverBackButton) {
                    
                } else if (!isOverPreviewZone && !panelHidden) {
                    fireClickAt();
                }
            }
            isDragging = false;
            previewActionFired = false;
            previewHoldTimer = 0.0;
        }

        if (FlxG.onMobile && holdTimer <= 0) {
            if (SwipeUtil.swipeUp) {
                if (!panelHidden) { changeSelection(-1); holdTimer = 0.25; }
            } else if (SwipeUtil.swipeDown) {
                if (!panelHidden) { changeSelection(1); holdTimer = 0.25; }
            } else if (SwipeUtil.swipeLeft || SwipeUtil.swipeRight) {
                if (!transitioningSide && !panelHidden) {
                    transitioningSide = true;
                    transitionTimer = 0.0;
                    nextPanelOnLeft = !panelOnLeft;
                    holdTimer = 0.25;
                HapticUtil.vibrate(0, 0.01, 0.25, 0.1);
                }
            }
        }

        if (!FlxG.onMobile && FlxG.mouse.wheel != 0 && !panelHidden) {
            changeSelection(-FlxG.mouse.wheel);
        }

        if (!panelHidden && !transitioningSide) {
            if (controls.UI_UP_P) {
                changeSelection(-1);
                holdTimer = 0.1;
            }
            if (controls.UI_DOWN_P) {
                changeSelection(1);
                holdTimer = 0.1;
            }
            if (controls.ACCEPT_P) {
                var item = optionItems[selectedIndex];
                if (!item.isHeader && item.fire != null) {
                    if (apiRef != null && apiRef.isOptionLocked(item.key)) {
                        FlxG.sound.play(Paths.sound("ui/khud_lock"), 0.3);
                        item.errorTimer = 1.0;
                        holdTimer = 0.2;
                    } else {
                        item.fire(item);
                        holdTimer = 0.2;
                    }
                }
            }
        }
    }

    function fireClickAt() {
        var startIdx = visibleStart < 0 ? 0 : visibleStart;
        var endIdx = visibleEnd < 0 ? optionItems.length - 1 : visibleEnd;
        if (endIdx >= optionItems.length) endIdx = optionItems.length - 1;
        var stopIdx = endIdx + 1;
        for (i in startIdx...stopIdx) {
            var item = optionItems[i];
            if (item.bg != null && item.bg.visible) {
                var isOver = false;
                if (FlxG.onMobile) {
                    isOver = TouchUtil.overlaps(item.bg, optionCam);
                } else {
                    isOver = FlxG.mouse.overlaps(item.bg, optionCam);
                }

                if (isOver) {
                    if (!item.isHeader) {
                        if (selectedIndex == i) {
                            if (apiRef != null && apiRef.isOptionLocked(item.key)) {
                                FlxG.sound.play(Paths.sound("ui/khud_lock"), 0.3);
                                item.errorTimer = 1.0;
                                holdTimer = 0.2;
                            } else {
                                if (item.fire != null) item.fire(item);
                                holdTimer = 0.2;
                            }
                        } else {
                            selectedIndex = i;
                            changeSelection(0);
                            holdTimer = 0.2;
                        }
                    }
                    break;
                }
            }
        }
    }
}